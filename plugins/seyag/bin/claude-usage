#!/bin/bash
# claude-usage: the Claude plan's usage windows, shared by every session on this machine.
#
#   claude-usage              one line: 5h window % and reset, weekly % and reset, per-model weekly caps,
#                             plus ' · extra $X.XX left of $B.BB' / '$X.XX used' / '$X.XX over $B.BB'
#                             while the plan's paid extra usage is on, under its spend limit, and anything
#                             was spent or the week is maxed; ' · extra off (limit reached)' or
#                             ' · extra off (<reason>)' at a maxed week when it is limit-reached, or carries
#                             a disabled_reason while not enabled (enabled + reason + under the limit
#                             passes the gate, so it shows the balance)
#   claude-usage --ok [PCT]   exit 0 if the 5h window is below PCT% (default 90), the week is under 75% and
#                             the calling session's model (Fable) has its own weekly cap left, else 1;
#                             CLAUDE_USAGE_EXTRA_OK=1 passes past the weekly reserve while extra usage is on
#                             and under its spend limit (cache at most 2 TTLs or 10 min old);
#                             on the z.ai lane the same thresholds apply to z.ai's own quota, with the 5h one capped at 80% (Tzurot's
#                             guests get the band above it) and the week reserve overridable via CLAUDE_USAGE_ZAI_WEEK_RESERVE_CMD (integer 1-99, must return promptly) or CLAUDE_USAGE_ZAI_WEEK_RESERVE;
#                             other routed lanes (OpenRouter, a Console API key) pass at once (see below);
#                             prints one verdict line to stderr (lane, meter, value, threshold,
#                             source=api|estimate|none; says FAIL-OPEN when it passed on an estimate)
#   claude-usage --wait [PCT] block until --ok PCT (default 50, i.e. the 5h window reset) passes, checking
#                             every 2 minutes, then print the line; run it in the background to pause a session
#   claude-usage --json       {five_hour_pct, five_hour_resets_at, seconds_to_reset, weekly_pct, weekly_resets_at, scoped, routed,
#                             lane (anthropic|zai|or|console|unknown)} plus the calling lane's numbers, null when unreadable:
#                             zai_five_hour_pct, zai_week_pct (z.ai) | or_remaining_usd (OpenRouter, 2 dp as displayed) | api_credit_remaining_usd (Console); extra_usage {enabled, spend_limit_reached, disabled_reason, used_usd} when in cache
#   claude-usage --all        one line per lane on this machine (Anthropic plan, z.ai quota, API credit), whatever the
#                             calling session's lane; always exits 0
#
# Reads the statusline's cache of /api/oauth/usage (~/.cache/claude-statusline/usage.json)
# and refreshes it when it is older than 2 minutes, under a lock, so any number of polling
# sessions make at most one request per 2 minutes. The token is sent on stdin, not argv.
# Every run also appends the reading, if new, to ~/.local/state/claude-usage/readings.jsonl
# (see log_reading; usage-sweep --points reads it).
# Each logged line also carries prev_epoch, the last earlier fetch seen, so a meter tick lies
# in [prev_epoch, epoch] (usage-sweep --fit). CLAUDE_USAGE_TTL (integer >= 30) overrides the
# 120 s TTL; a poller running `CLAUDE_USAGE_TTL=55 claude-usage --json >/dev/null` every 60 s
# keeps those brackets near 60 s.

set -uo pipefail

cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-statusline/usage.json"
ttl=120
if [[ ${CLAUDE_USAGE_TTL:-} =~ ^[0-9]+$ ]] && [ "$((10#$CLAUDE_USAGE_TTL))" -ge 30 ]; then
    ttl=$((10#$CLAUDE_USAGE_TTL))
fi
# Fleet wind-down (2026-10-04): no new units from 75% of the week, so the rest stays for the owner
# and GitHub claude-review. The 80% hard stop is the CLAUDE.md "Usage Windows" protocol's job.
# CLAUDE_USAGE_WEEK_RESERVE overrides it; a non-integer value keeps the default.
week_reserve=75
[[ ${CLAUDE_USAGE_WEEK_RESERVE:-} =~ ^[0-9]+$ ]] && week_reserve=$((10#$CLAUDE_USAGE_WEEK_RESERVE))
# z.ai's 5h window, capped below Tzurot's free-tier cutoff: Tzurot moves guests off GLM once the
# HIGHER of z.ai's 5h and weekly meters reaches its zaiHeadroomPercent (90), so dev work stops
# starting at 80% in either window and leaves guests a 10-15 point band.
# CLAUDE_USAGE_ZAI_FIVE_CAP overrides it; a non-integer value keeps the default.
zai_five_cap=80
[[ ${CLAUDE_USAGE_ZAI_FIVE_CAP:-} =~ ^[0-9]+$ ]] && zai_five_cap=$((10#$CLAUDE_USAGE_ZAI_FIVE_CAP))
# A deployment's z.ai weekly posture can differ from the shared week_reserve and change while the
# machine runs (e.g. banked one-time quota resets lifting the weekly cap until spent), so the z.ai
# --ok branch checks CLAUDE_USAGE_ZAI_WEEK_RESERVE_CMD (bash -c per gate check, trimmed stdout
# integer 1-99; wins the slot in success and failure, falling back to week_reserve with a stderr
# note when unusable) and static CLAUDE_USAGE_ZAI_WEEK_RESERVE (when CMD is unset/empty). The plan
# lane never sees either var, and non-gate runs never fork the command.

refresh() {
    local age tok tmp
    age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
    [ "$age" -lt "$ttl" ] && return 0
    mkdir -p "${cache%/*}"
    exec 9>"$cache.lock"
    flock -n 9 || return 0 # someone else is refreshing; use what's there
    tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$HOME/.claude/.credentials.json" 2>/dev/null)
    [ -z "$tok" ] && return 0
    tmp="$cache.tmp.$$"
    if printf 'Authorization: Bearer %s\n' "$tok" |
        curl -sf -m 10 -H @- -H "anthropic-beta: oauth-2025-04-20" \
            https://api.anthropic.com/api/oauth/usage -o "$tmp" &&
        jq -e '.five_hour' "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$cache"
    else
        rm -f "$tmp"
    fi
}

# The calling session's model: $CLAUDE_USAGE_MODEL, else the latest reply in its transcript
# (Claude Code sets CLAUDE_CODE_SESSION_ID; a subagent reports its parent session's model).
caller_model() {
    local f
    if [ -n "${CLAUDE_USAGE_MODEL:-}" ]; then
        echo "$CLAUDE_USAGE_MODEL"
        return
    fi
    [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || return 0
    f=$(ls -t "$HOME"/.claude/projects/*/"$CLAUDE_CODE_SESSION_ID".jsonl 2>/dev/null | head -1)
    [ -n "$f" ] || return 0
    tac "$f" | jq -r 'select(.type == "assistant") | .message.model // empty' 2>/dev/null | head -1
}

if [ "${1:-}" = --wait ]; then
    until wait_verdict=$("$0" --ok "${2:-50}" 2>&1 >/dev/null); do sleep 120; done
    [ -n "$wait_verdict" ] && printf '%s\n' "$wait_verdict" >&2
    exec "$0"
fi

# Routing: the usage API below meters the Anthropic plan only, so while a session is routed
# elsewhere its numbers are an idle plan's. The base-URL host is classified exactly as the
# statusline classifies it; the Console-key lane is not (see below). The process env is the truth when it sets ANTHROPIC_BASE_URL, even to empty (a
# session exports its own route to the commands it runs); otherwise settings.json decides, read
# fresh each run. The match is on the base URL's HOST, end-anchored, so a lookalike such as
# api.anthropic.com.evil.com can't borrow another lane; userinfo is stripped, so no credential
# reaches a label. An empty or absent base URL is the plan lane.
if [ -n "${ANTHROPIC_BASE_URL+x}" ]; then
    base_url=$ANTHROPIC_BASE_URL
else
    base_url=$(jq -r '.env.ANTHROPIC_BASE_URL // empty' "$HOME/.claude/settings.json" 2>/dev/null)
fi
vendor_host=$(printf '%s' "$base_url" \
    | sed -E 's#^[a-zA-Z]+://##; s#/.*$##; s#^.*@##; s#:[0-9]*$##' \
    | tr '[:upper:]' '[:lower:]')
vendor_lane=unknown
case "$vendor_host" in
    z.ai|*.z.ai)                       vendor_lane=zai ;;
    api.anthropic.com|*.anthropic.com) vendor_lane=anthropic ;;
    openrouter.ai|*.openrouter.ai)     vendor_lane=or ;;
    '') [ -z "$base_url" ] &&          vendor_lane=anthropic ;;
esac
# A Console API key (the anthropic-api route preset) outranks the /login subscription: same
# endpoint, but the bill is Console credits, so the plan meter is idle for that session, as on
# OpenRouter. Keyed on the overlay's CC_ROUTE_PRESET marker, not the key: an ANTHROPIC_API_KEY
# exported for some SDK script in a plan session must not switch the plan gate off. (The
# statusline differs on purpose: it keys its API-key lane on a non-empty ANTHROPIC_API_KEY, or on
# SYG_CREDIT_WHEN when set, because it only labels a render and never gates.)
[ "$vendor_lane" = anthropic ] && [ "${CC_ROUTE_PRESET:-}" = anthropic-api ] && vendor_lane=console
routed=1
[ "$vendor_lane" = anthropic ] && routed=0
zai_usage=${CLAUDE_USAGE_ZAI_USAGE:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/zai-usage}
api_credit=${CLAUDE_USAGE_API_CREDIT:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/api-credit}

# zai-usage's --json when it holds z.ai's live quota (source "api"), else nothing.
zai_api_json() {
    local j
    j=$("$zai_usage" --json 2>/dev/null)
    [ "$(jq -r '.source // empty' <<< "$j" 2>/dev/null)" = api ] && printf '%s\n' "$j"
}

# api-credit's balance object (remaining_usd, spent_usd, next_expiry, days_left), else nothing.
# Read-only: recording into the ledger is the api-credit-ledger hook's job.
api_credit_json() {
    local j
    j=$("$api_credit" balance --json </dev/null 2>/dev/null) || return 0
    jq -e 'type == "object"' <<< "$j" >/dev/null 2>&1 && printf '%s\n' "$j"
}

# OpenRouter's remaining dollars as X.XX, else nothing. The statusline's arithmetic and degrades,
# copied (its OpenRouter block). Read-only: the statusline is the cache's only writer and fetcher,
# so a cold or stale cache here just means no dollars, never a request.
or_remaining() {
    local or_tok or_cache rem or_fmt
    or_tok=${ANTHROPIC_AUTH_TOKEN:-$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // empty' "$HOME/.claude/settings.json" 2>/dev/null)}
    or_cache="${XDG_CACHE_HOME:-$HOME/.cache}/claude-statusline/or-credits.json"
    rem=$(jq -r '.data | if type == "object" and (.total_credits|type) == "number" and (.total_usage|type) == "number" and (.total_credits - .total_usage) > 0 then (.total_credits - .total_usage) else empty end' "$or_cache" 2>/dev/null)
    or_fmt=""
    if [ -n "$or_tok" ] && [ -n "$rem" ]; then
        # LC_ALL=C: builtin printf honors LC_NUMERIC; a comma-decimal locale would garble it.
        or_fmt=$(LC_ALL=C printf '%.2f' "$rem")
        # A sub-cent balance formats to 0.00, not a balance to show honestly; degrade.
        [ "$or_fmt" = "0.00" ] && or_fmt=""
    fi
    [ -n "$or_fmt" ] && printf '%s\n' "$or_fmt"
}

# reset_in <epoch>: " (resets HH:MM, in Hh Mm)" in local time, or nothing for an unknown (0) reset.
reset_in() {
    local left
    [ "${1:-0}" -gt 0 ] 2>/dev/null || return 0
    left=$(( $1 - $(date +%s) )); [ "$left" -lt 0 ] && left=0
    printf ' (resets %s, in %dh %dm)' "$(date -d "@$1" +%H:%M)" $((left / 3600)) $(( (left % 3600) / 60 ))
}

# The gate answers before refresh or the cache check: a routed session needs no plan request.
# z.ai has its own 5h and weekly windows, read live from z.ai's quota API by zai-usage, so the same
# thresholds apply there (2026-10-04: a pass-through let the fleet burn a whole z.ai week).
# zai-usage's local fallback estimate is not account truth, so it never blocks. Other lanes
# (OpenRouter) pass: their limit is a dollar cap the provider enforces itself.
if [ "${1:-}" = --ok ] && [ "$routed" = 1 ]; then
    if [ "$vendor_lane" != zai ]; then
        echo "claude-usage: --ok pass lane=$vendor_lane gate=pass-through source=none (provider enforces its own cap)" >&2
        exit 0
    fi
    # No --bg: the gate refreshes in the foreground on purpose, bounded by ZAI_USAGE_KEYS_KILL_S.
    zai=$("$zai_usage" --json 2>/dev/null)
    if [ "$(jq -r '.source // empty' <<< "$zai" 2>/dev/null)" != api ]; then
        echo "claude-usage: --ok pass lane=zai meter=zai-5h source=estimate FAIL-OPEN: z.ai quota API unavailable, local estimate never blocks; gate passes" >&2
        exit 0
    fi
    zfive=$(jq -r '.five_hour_pct // 0' <<< "$zai"); zweek=$(jq -r '.week_pct // 0' <<< "$zai")
    zai_week_reserve=$week_reserve
    if [ -n "${CLAUDE_USAGE_ZAI_WEEK_RESERVE_CMD:-}" ]; then
        zwr_out=$(bash -c "$CLAUDE_USAGE_ZAI_WEEK_RESERVE_CMD" 2>/dev/null); zwr_rc=$?
        zwr_out=${zwr_out#"${zwr_out%%[![:space:]]*}"}; zwr_out=${zwr_out%"${zwr_out##*[![:space:]]}"}
        if [ "$zwr_rc" -eq 0 ] && [[ "$zwr_out" =~ ^[0-9]+$ ]] && [ "$zwr_out" -ge 1 ] && [ "$zwr_out" -le 99 ]; then
            zai_week_reserve=$((10#$zwr_out))
        else
            echo "claude-usage: CLAUDE_USAGE_ZAI_WEEK_RESERVE_CMD gave no usable reserve (exit $zwr_rc); z.ai week reserve falls back to week_reserve ($week_reserve)" >&2
        fi
    elif [[ ${CLAUDE_USAGE_ZAI_WEEK_RESERVE:-} =~ ^[0-9]+$ ]]; then
        zai_week_reserve=$((10#$CLAUDE_USAGE_ZAI_WEEK_RESERVE))
    fi
    zlimit=${2:-90}; [ "$zlimit" -gt "$zai_five_cap" ] 2>/dev/null && zlimit=$zai_five_cap
    if ! { [ "$zfive" -lt "$zlimit" ] && [ "$zweek" -lt "$zai_week_reserve" ]; } 2>/dev/null; then
        zfive_op=">="; [ "$zfive" -lt "$zlimit" ] 2>/dev/null && zfive_op="<"
        zweek_op=">="; [ "$zweek" -lt "$zai_week_reserve" ] 2>/dev/null && zweek_op="<"
        zmeter="zai-5h"; [ "$zfive" -lt "$zlimit" ] 2>/dev/null && zmeter="week"
        echo "claude-usage: --ok FAIL lane=zai meter=$zmeter 5h=${zfive}%${zfive_op}${zlimit}% week=${zweek}%${zweek_op}${zai_week_reserve}% source=api" >&2
        exit 1
    fi
    echo "claude-usage: --ok pass lane=zai meter=zai-5h 5h=${zfive}%<${zlimit}% week=${zweek}%<${zai_week_reserve}% source=api" >&2
    exit 0
fi

refresh
# --all reports a missing plan cache as one of its lines instead: the reads below then come up
# empty (0 in arithmetic) and log_reading finds no cache to log.
if [ ! -s "$cache" ] && [ "${1:-}" != --all ]; then
    echo "claude-usage: no usage data (no cache and the refresh failed)" >&2
    exit 2
fi

# resets_at looks like 2026-09-25T06:09:59.682848+00:00; fromdateiso8601 wants ...:59Z
read -r five five_reset week week_reset < <(jq -r '
    def epoch: (. // "") | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z")
        | if . == "" then 0 else (fromdateiso8601? // 0) end;
    [ (.five_hour.utilization // 0 | round), (.five_hour.resets_at | epoch),
      (.seven_day.utilization // 0 | round), (.seven_day.resets_at | epoch) ] | @tsv' "$cache" 2>/dev/null)
# Per-model weekly caps ("Fable 8%"), read on their own: @tsv would double a backslash in a name.
scoped=$(jq -r '[ .limits[]? | select(.kind == "weekly_scoped" and .scope.model.display_name != null) | "\(.scope.model.display_name) \(.percent)%" ] | join(", ")' "$cache" 2>/dev/null)

now=$(date +%s)
to_reset=$(( five_reset > now ? five_reset - now : 0 ))

# Reading log for usage-sweep --points (2026-09-27): one JSON line per distinct reading, ts = when
# the cache was fetched, raw (unrounded) percentages, per-model weekly caps as an object. A reading
# identical to the previous line (same numbers) is skipped. Machine-local by design: usage figures
# stay off every repo (usage-audit's privacy boundary). Never fails, blocks or prints to the
# caller: all its stderr is dropped, and a busy lock skips this reading (the next call logs).
log_reading() {
    local log="${XDG_STATE_HOME:-$HOME/.local/state}/claude-usage/readings.jsonl" line last fetched
    local prev_raw prev tmp r_five="null" r_week="null"
    mkdir -p "${log%/*}" || return 0
    fetched=$(stat -c %Y "$cache") || return 0
    [ "${five_reset:-0}" -gt 0 ] 2>/dev/null && r_five=$(( (five_reset + 30) / 60 * 60 ))
    [ "${week_reset:-0}" -gt 0 ] 2>/dev/null && r_week=$(( (week_reset + 30) / 60 * 60 ))
    # -S sorts keys, so the dedup string comparison can't be fooled by the API's scope order.
    line=$(jq -cS --argjson fetched "$fetched" --argjson five_resets_at "$r_five" --argjson weekly_resets_at "$r_week" '{
        ts: ($fetched | todate), epoch: $fetched,
        five_hour_pct: (.five_hour.utilization // null),
        five_hour_resets_at: $five_resets_at,
        weekly_pct: (.seven_day.utilization // null),
        weekly_resets_at: $weekly_resets_at,
        scoped: ([ .limits[]? | select(.kind == "weekly_scoped" and .scope.model.display_name != null)
                   | {key: .scope.model.display_name, value: .percent} ] | from_entries)
    }' "$cache") || return 0
    [ -n "$line" ] || return 0
    (
        flock -n 8 || exit 0
        prev_raw=$(cat "$log.last" 2>/dev/null || true)
        prev=""
        [ -s "$log" ] && [[ "$prev_raw" =~ ^[0-9]+$ ]] && prev=$((10#$prev_raw))
        if [ "$prev_raw" != "$fetched" ]; then
            tmp="${log}.last.tmp.$$"
            printf '%s\n' "$fetched" > "$tmp" && mv -f "$tmp" "$log.last"
        fi
        last=$(tail -n 1 "$log")
        [ "$(jq -cS 'del(.ts, .epoch, .prev_epoch)' <<< "$last")" = "$(jq -cS 'del(.ts, .epoch, .prev_epoch)' <<< "$line")" ] && exit 0
        if [ -n "$prev" ] && [ "$prev" -lt "$fetched" ]; then
            line=$(jq -cS --argjson prev "$prev" '. + {prev_epoch: $prev}' <<< "$line" 2>/dev/null || printf '%s' "$line")
        fi
        printf '%s\n' "$line" >> "$log"
    ) 8>"$log.lock"
}
log_reading 2>/dev/null

# The plan's two windows: "5h N% (resets …) · week N% (resets …)[ · <caps> of its own weekly cap]".
plan_line() {
    local five_line week_line to_week
    five_line="5h ${five}%"
    if [ "$five_reset" -gt 0 ]; then
        five_line="$five_line (resets $(date -d "@$five_reset" +%H:%M), in $((to_reset / 3600))h $(( (to_reset % 3600) / 60 ))m)"
    fi
    week_line="week ${week}%"
    # Date and countdown, not just a weekday: "Sun 02:00" read on a Sunday evening looks like tonight.
    if [ "$week_reset" -gt 0 ]; then
        to_week=$(( week_reset - $(date +%s) )); [ "$to_week" -lt 0 ] && to_week=0
        week_line="$week_line (resets $(date -d "@$week_reset" '+%a %b %-d %H:%M'), in $((to_week / 86400))d $(( (to_week % 86400) / 3600 ))h)"
    fi
    [ -n "$scoped" ] && week_line="$week_line · $scoped of its own weekly cap"
    echo "$five_line · $week_line"
}

# --all: one line per lane on this machine, whatever lane the caller is on (a plan session's fleet
# check must see z.ai's windows too). Each line reuses its lane's own reader; none fetches twice.
all_lanes() {
    local j z5 zw z5r zwr line c_rem c_spent c_exp c_days
    if [ -s "$cache" ]; then
        echo "Anthropic plan: $(plan_line)"
    else
        echo "Anthropic plan: no data"
    fi
    j=$(zai_api_json)
    if [ -n "$j" ]; then
        IFS=$'\t' read -r z5 zw z5r zwr < <(jq -r '[.five_hour_pct, .week_pct, (.five_hour_reset_at // 0), (.week_reset_at // 0)] | @tsv' <<< "$j")
        echo "z.ai: 5h ${z5}%$(reset_in "$z5r") · week ${zw}%$(reset_in "$zwr")"
    else
        # No live quota: zai-usage's own line (it tags a local estimate "local est"); "…" is its no-data mark.
        line=$("$zai_usage" --line 2>/dev/null)
        case "$line" in ""|"…") echo "z.ai: no data" ;; *) echo "z.ai: $line" ;; esac
    fi
    j=$(api_credit_json)
    if [ -z "$j" ]; then
        echo "api credit: not configured"
        return 0
    fi
    # The estimate field leads: tab is IFS whitespace, so empty fields collapse and only
    # the trailing ones (expiry, days) may be empty.
    IFS=$'\t' read -r c_est c_rem c_spent c_exp c_days < <(jq -r '[(.estimate != false), (.remaining_usd // "null"), (.spent_usd // 0), ((.next_expiry // "")[5:10]), (.days_left // "")] | @tsv' <<< "$j")
    # The balance's own rule: the bare figure when exact, followed by " est" otherwise.
    c_tag=" est"
    [ "$c_est" = false ] && c_tag=""
    if [ "$c_rem" = null ]; then
        echo "api credit: \$$(LC_ALL=C printf '%.2f' "$c_spent") spent${c_tag} (no live grants)"
    elif LC_ALL=C awk -v r="$c_rem" 'BEGIN{exit !(r > 0)}'; then
        line="api credit: \$$(LC_ALL=C printf '%.2f' "$c_rem")${c_tag}"
        [ -n "$c_exp" ] && line="$line (exp $c_exp, ${c_days}d)"
        echo "$line"
    else
        echo "api credit: \$0.00${c_tag}"
    fi
}

# --json's lane fields as one compact object: the lane plus the calling lane's numbers, null when
# its reader has none (no live z.ai quota, no OpenRouter dollars, no numeric credit balance).
lane_fields() {
    local j
    case "$vendor_lane" in
        zai)
            j=$(zai_api_json)
            jq -cn --argjson z "${j:-null}" '{lane: "zai",
                zai_five_hour_pct: ((($z // {}).five_hour_pct | numbers) // null),
                zai_week_pct: ((($z // {}).week_pct | numbers) // null)}' ;;
        or)
            j=$(or_remaining)
            jq -cn --argjson v "${j:-null}" '{lane: "or", or_remaining_usd: $v}' ;;
        console)
            j=$(api_credit_json)
            jq -cn --argjson c "${j:-null}" '{lane: "console",
                api_credit_remaining_usd: ((($c // {}).remaining_usd | numbers) // null)}' ;;
        *)
            jq -cn --arg l "$vendor_lane" '{lane: $l}' ;;
    esac
}

# --json's extra_usage field when the cache carries an extra_usage object, else nothing.
extra_usage_field() {
    jq -c '
        if type == "object" and (.extra_usage | type) == "object" then
            .extra_usage as $x |
            (if (.spend | type) == "object" and (.spend.used | type) == "object" then .spend.used else {} end) as $u |
            {extra_usage: {
                enabled: ($x.is_enabled == true),
                spend_limit_reached: (if ($x.spend_limit_reached | type) == "boolean" then $x.spend_limit_reached else null end),
                disabled_reason: (if ($x.disabled_reason | type) == "string" and ($x.disabled_reason | length) > 0
                    then ($x.disabled_reason | gsub("[^A-Za-z0-9_.-]"; "_"))
                    else null end),
                used_usd: (if $u.currency == "USD"
                    and ($u.amount_minor | type) == "number" and ($u.amount_minor | floor) == $u.amount_minor and $u.amount_minor >= 0
                    and ($u.exponent | type) == "number" and ($u.exponent | floor) == $u.exponent and $u.exponent >= 0 and $u.exponent <= 6
                    then (($u.amount_minor * 100 / pow(10; $u.exponent)) | round) / 100
                    else null end)
            }}
        else empty end' "$cache" 2>/dev/null
}

# The extra-usage figure the plain line's ` · extra …` and an extra-usage --ok pass's
# ` extra=…` both end in: under a valid SYG_EXTRA_USAGE_BUDGET_USD (anything else counts
# as unset) "$X.XX over $B.BB" past it or "$X.XX left of $B.BB" under it, "$X.XX used"
# without one. $1 is used_usd; a missing spend counts as 0.
extra_figure() {
    local used=${1:-0} budget=""
    [ -n "${SYG_EXTRA_USAGE_BUDGET_USD:-}" ] \
        && LC_ALL=C awk -v b="$SYG_EXTRA_USAGE_BUDGET_USD" 'BEGIN{exit !(b ~ /^[0-9]+([.][0-9]+)?$/)}' \
        && budget=$SYG_EXTRA_USAGE_BUDGET_USD
    if [ -n "$budget" ]; then
        if LC_ALL=C awk -v u="$used" -v b="$budget" 'BEGIN{exit !(u > b)}'; then
            LC_ALL=C awk -v u="$used" -v b="$budget" 'BEGIN{printf "$%.2f over $%.2f", u, b}'
        else
            LC_ALL=C awk -v u="$used" -v b="$budget" 'BEGIN{printf "$%.2f left of $%.2f", (b - u > 0) ? b - u : 0, b}'
        fi
    else
        LC_ALL=C printf '$%.2f used\n' "$used"
    fi
}

case "${1:-}" in
    --ok)
        # A week at the reserve blocks everything, whatever the 5h window says, unless the extra-usage
        # opt-in below applies: the last 25% is reserved for the owner and GitHub claude-review.
        # --wait then keeps polling until the weekly reset instead of waking on each fresh 5h window.
        # CLAUDE_USAGE_EXTRA_OK=1 lifts the weekly reserve while the plan's extra usage is on and under its spend limit.
        # That pass spends money, so it fails closed: strict booleans only, and never on a cache older
        # than two TTLs or 10 minutes, whichever is less.
        cache_age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
        stale_note=""
        [ "$cache_age" -gt "$ttl" ] && stale_note=" (cache $((cache_age / 60))m old)"
        thr=${2:-90}
        pass_meter="5h"
        week_op="<"
        if ! { [ "$five" -lt "$thr" ] && [ "$week" -lt "$week_reserve" ]; } 2>/dev/null; then
            five_op=">="; [ "$five" -lt "$thr" ] 2>/dev/null && five_op="<"
            week_op=">="; [ "$week" -lt "$week_reserve" ] 2>/dev/null && week_op="<"
            meter="5h"; [ "$five" -lt "$thr" ] 2>/dev/null && meter="week"
            extra_note=""
            if [ "$meter" = week ] && [ "${CLAUDE_USAGE_EXTRA_OK:-}" = 1 ]; then
                # The reason is the API's own token, reduced to [A-Za-z0-9_.-] so it can't break the verdict line.
                extra_state=$(jq -r '
                    (.extra_usage? // {}) as $x | if ($x | type) != "object" then "off:disabled"
                    elif $x.is_enabled == true and $x.spend_limit_reached == false then "ok"
                    elif $x.spend_limit_reached == true then "off:spend_limit_reached"
                    elif ($x.disabled_reason | type) == "string" and ($x.disabled_reason | length) > 0
                        then "off:\($x.disabled_reason | gsub("[^A-Za-z0-9_.-]"; "_"))"
                    else "off:disabled" end' "$cache" 2>/dev/null)
                extra_max_age=$((2 * ttl)); [ "$extra_max_age" -gt 600 ] && extra_max_age=600
                if [ "$extra_state" = ok ] && [ "$cache_age" -gt "$extra_max_age" ]; then
                    extra_state="off:stale"
                fi
                if [ "$extra_state" = ok ]; then
                    pass_meter="extra-usage"
                else
                    extra_reason=${extra_state#off:}
                    [ -n "$extra_reason" ] || extra_reason=disabled
                    extra_note=" extra=off ($extra_reason)"
                fi
            fi
            if [ "$pass_meter" != extra-usage ]; then
                echo "claude-usage: --ok FAIL lane=anthropic meter=$meter 5h=${five}%${five_op}${thr}% week=${week}%${week_op}${week_reserve}%${extra_note} source=api${stale_note}" >&2
                exit 1
            fi
        fi
        # A model's own weekly cap ("Fable 100%") blocks only sessions on that model.
        model=$(caller_model)
        if [ -n "$model" ]; then
            while IFS= read -r cap; do
                name=${cap% *}
                pct=${cap##* }
                pct=${pct%%.*} # truncate: 99.6 still has room
                if [[ ${model,,} == *"${name,,}"* ]] && [ "$pct" -ge 100 ]; then
                    echo "claude-usage: --ok FAIL lane=anthropic meter=model-cap model=$name cap=${pct}%>=100% source=api${stale_note}" >&2
                    exit 1
                fi
            done < <(sed 's/, /\n/g; s/%//g' <<< "$scoped" | grep .)
        fi
        # An extra-usage pass names its balance: extra_figure() under the same budget
        # var the plain line uses. Every other pass line stays as it was.
        extra_bal=""
        if [ "$pass_meter" = extra-usage ]; then
            ex_json=$(extra_usage_field)
            if [ -n "$ex_json" ] && [[ $ex_json != *$'\n'* ]]; then
                ex_used=0
                eval "$(jq -r '.extra_usage as $x | @sh "ex_used=\($x.used_usd // 0)"' <<< "$ex_json" 2>/dev/null)"
                extra_bal=" extra=$(extra_figure "$ex_used")"
            fi
        fi
        echo "claude-usage: --ok pass lane=anthropic meter=$pass_meter 5h=${five}%<${thr}% week=${week}%${week_op}${week_reserve}%${extra_bal} source=api${stale_note}" >&2
        exit 0
        ;;
    --json)
        # The lane fields ride after the original ones, which stay byte-for-byte as they were.
        ext=$(lane_fields); ext=${ext#\{}; ext=${ext%\}}
        [ -n "$ext" ] || ext="\"lane\":\"$vendor_lane\""
        if extra=$(extra_usage_field) && [ -n "$extra" ] && [[ $extra != *$'\n'* ]]; then
            extra=${extra#\{}; extra=${extra%\}}
            ext="$ext,$extra"
        fi
        printf '{"five_hour_pct":%d,"five_hour_resets_at":%d,"seconds_to_reset":%d,"weekly_pct":%d,"weekly_resets_at":%d,"scoped":%s,"routed":%d,%s}\n' \
            "$five" "$five_reset" "$to_reset" "$week" "$week_reset" "$(jq -rn --arg s "$scoped" '$s | @json')" "$routed" "$ext"
        ;;
    --all)
        all_lanes
        exit 0
        ;;
    "")
        # No Fable-vs-week target (usage parity dropped 2026-10-04): use the best and most
        # cost-effective model for the job, and keep Fable, which burns the week fastest, low.
        note="" tail=""
        if [ "$vendor_lane" = zai ]; then
            note="z.ai-routed (gate reads z.ai's quota; Anthropic plan idle) · "
            # zai-usage's line: z.ai's live quota, or a local estimate tagged "local est".
            glm=$("$zai_usage" --line 2>/dev/null)
            [ -n "$glm" ] && tail=" · z.ai $glm"
        elif [ "$routed" = 1 ]; then
            case "$vendor_lane" in or) lane=OpenRouter ;; console) lane="Console API key" ;; *) lane=$vendor_host ;; esac
            # A base URL with no host (e.g. "https://") has no label, as in the statusline: no note.
            [ -n "$lane" ] && note="$lane-routed (gate passes; Anthropic plan idle) · "
            # OpenRouter: the remaining balance from the statusline's credits cache, when it has one.
            if [ "$vendor_lane" = or ]; then
                usd=$(or_remaining)
                [ -n "$usd" ] && tail=" · \$$usd"
            fi
        fi
        # The extra-usage suffix: the statusline extra segment's visibility rule —
        # "off" at a maxed week when the add-on is limit-reached, or carries a
        # disabled_reason while not enabled (the gate reports extra=off there too;
        # enabled + reason + under the limit passes the gate, so it renders the
        # balance). The gate also reports extra=off below a maxed week (the 75%
        # reserve) and for disabled-without-reason; the suffix intentionally
        # renders those as absent or money-only. Else the balance, only while
        # enabled and under the limit, and the week maxed or anything spent —
        # normalized by the same extra_usage_field() --json reads;
        # extra_figure() formats the balance.
        extra_tail=""
        if ex_json=$(extra_usage_field) && [ -n "$ex_json" ] && [[ $ex_json != *$'\n'* ]]; then
            ex_enabled=false ex_lim=false ex_lim_ok=false ex_reason="" ex_used=0
            eval "$(jq -r '.extra_usage as $x |
                (if $x.disabled_reason == null then "" else $x.disabled_reason end) as $r |
                @sh "ex_enabled=\($x.enabled) ex_lim=\($x.spend_limit_reached) ex_lim_ok=\($x.spend_limit_reached == false) ex_reason=\($r) ex_used=\($x.used_usd // 0)"' <<< "$ex_json" 2>/dev/null)"
            if [ "$week" -ge 100 ] 2>/dev/null && { [ "$ex_lim" = true ] || { [ "$ex_enabled" != true ] && [ -n "$ex_reason" ]; }; }; then
                if [ "$ex_lim" = true ]; then
                    extra_tail=" · extra off (limit reached)"
                else
                    extra_tail=" · extra off ($ex_reason)"
                fi
            elif [ "$ex_enabled" = true ] && [ "$ex_lim_ok" = true ]; then
                ex_show=0
                [ "$week" -ge 100 ] 2>/dev/null && ex_show=1
                LC_ALL=C awk -v u="$ex_used" 'BEGIN{exit !(u > 0)}' && ex_show=1
                [ "$ex_show" = 1 ] && extra_tail=" · extra $(extra_figure "$ex_used")"
            fi
        fi
        echo "$note$(plan_line)$extra_tail$tail"
        ;;
    *)
        sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
