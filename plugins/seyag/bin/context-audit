#!/usr/bin/env python3
"""context-audit: measurements for the doc-audit skill.

  context-audit weigh [DIR]     what a session started in DIR loads up front, largest first:
                                ~/.claude/CLAUDE.md, ~/.claude/rules/**, the managed policy
                                CLAUDE.md, the auto-memory index (to its load cap), CLAUDE.md /
                                CLAUDE.local.md / .claude/CLAUDE.md from DIR up to /, DIR's
                                .claude/rules/**, every @import they pull in (4 hops), skill
                                descriptions, and the role file the claude-role hook injects.
                                Rules with `paths:` frontmatter load on demand and are listed apart.
  context-audit refs [MEMDIR]   memory hygiene, MEMORY.md included: paths a memory names that no
                                longer exist, [[links]] to no memory, non-slug `name:` fields,
                                index lines whose file is missing, memory files the index skips

Token counts are bytes / 4, a rough estimate, labelled "~". Output from other SessionStart hooks
isn't counted. No path under a fuse.rclone mount (the ~/gdrive Drive mount) is ever stat-ed:
paths are resolved by a lexical walk that stops at a mount point, symlinks included.
HOME and CLAUDE_CONFIG_DIR are honoured (for tests); CONTEXT_AUDIT_MOUNTS overrides the mount
table path (default /proc/self/mounts).
"""
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path

HOME = Path(os.environ.get("HOME", str(Path.home())))
CONF = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude"))
MANAGED = Path("/etc/claude-code/CLAUDE.md")
MEMORY_CAP_LINES, MEMORY_CAP_BYTES = 200, 25_000  # Claude Code docs: MEMORY.md loads to this cap


def expand(p):
    return str(HOME) + p[1:] if p.startswith("~") else p


# --- mount-safe existence ----------------------------------------------------------------------

def rclone_mounts():
    table = os.environ.get("CONTEXT_AUDIT_MOUNTS", "/proc/self/mounts")
    points = [os.path.normpath(str(HOME / "gdrive"))]
    try:
        for line in open(table):
            f = line.split()
            if len(f) >= 3 and f[2].startswith("fuse.rclone"):
                points.append(os.path.normpath(f[1].replace("\\040", " ")))
    except OSError:
        pass
    return points


MOUNTS = rclone_mounts()


def under_mount(p):
    return any(p == m or p.startswith(m.rstrip("/") + "/") for m in MOUNTS)


def safe_exists(raw):
    """True/False, or None when the path leads into a mount (never stat-ed)."""
    path = os.path.normpath(expand(raw))
    if not path.startswith("/"):
        return None
    cur, parts, hops = "/", [p for p in path.split("/") if p], 0
    while parts:
        nxt = os.path.normpath(os.path.join(cur, parts.pop(0)))
        if under_mount(nxt):
            return None
        try:
            st = os.lstat(nxt)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode):
            hops += 1
            if hops > 40:
                return False
            target = os.readlink(nxt)
            base = "/" if target.startswith("/") else cur
            parts = [p for p in target.split("/") if p] + parts
            cur = base
            continue
        cur = nxt
    return True


# --- weigh ---------------------------------------------------------------------------------------

def settings_value(start, key):
    for f in (start / ".claude" / "settings.local.json", start / ".claude" / "settings.json", CONF / "settings.json"):
        try:
            v = json.loads(f.read_text()).get(key)
        except (OSError, ValueError):
            continue
        if v:
            return v
    return None


def repo_root(start):
    try:
        r = subprocess.run(["git", "-C", str(start), "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return Path(r.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    return start


def memory_dir(start):
    auto = settings_value(start, "autoMemoryDirectory")
    if auto:
        return Path(expand(auto))
    slug = str(repo_root(start).resolve()).replace("/", "-")
    return CONF / "projects" / slug / "memory"


def frontmatter(text):
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    return m.group(1) if m else ""


IMPORT_RE = re.compile(r"(?<![\w`])@((?:~|\.{1,2}|/)[^\s`)]+|[\w.-]+/[^\s`)]+|[\w-]+\.md)")


def weigh(start):
    start = start.resolve()
    rows, on_demand, seen = [], [], set()
    notes = []

    def add(label, p, size=None, depth=0):
        try:
            rp = p.resolve()
        except OSError:
            return
        if rp in seen or not p.is_file():
            return
        seen.add(rp)
        text = p.read_text(errors="replace")
        if label.endswith("rule") and re.search(r"^paths\s*:", frontmatter(text), re.M):
            on_demand.append((p.stat().st_size, label, p))
            return
        rows.append((size if size is not None else p.stat().st_size, label, p))
        if depth < 4:
            for ref in IMPORT_RE.findall(re.sub(r"```.*?```", "", text, flags=re.S)):
                q = Path(expand(ref)) if ref.startswith(("~", "/")) else (p.parent / ref)
                add("@import", q, depth=depth + 1)

    add("managed CLAUDE.md", MANAGED)
    add("user CLAUDE.md", CONF / "CLAUDE.md")
    if (CONF / "rules").is_dir():
        for p in sorted((CONF / "rules").rglob("*.md")):
            add("user rule", p)
    for parent in [start, *start.parents]:
        add("project CLAUDE.md", parent / "CLAUDE.md")
        add("project CLAUDE.md", parent / ".claude" / "CLAUDE.md")
        add("project CLAUDE.local.md", parent / "CLAUDE.local.md")
    if (start / ".claude" / "rules").is_dir():
        for p in sorted((start / ".claude" / "rules").rglob("*.md")):
            add("project rule", p)

    idx = memory_dir(start) / "MEMORY.md"
    if idx.is_file():
        data = idx.read_bytes()
        lines = data.split(b"\n")
        loaded = b"\n".join(lines[:MEMORY_CAP_LINES])[:MEMORY_CAP_BYTES]
        add("memory index", idx, size=len(loaded))
        if len(loaded) < len(data):
            notes.append(f"MEMORY.md is {len(lines)} lines / {len(data)} B; only the first "
                         f"{len(loaded)} B load (cap {MEMORY_CAP_LINES} lines / {MEMORY_CAP_BYTES} B)")

    # Skill descriptions: each skill's name + description loads up front.
    skill_dirs = [CONF / "skills", start / ".claude" / "skills"]
    try:
        inst = json.loads((CONF / "plugins" / "installed_plugins.json").read_text()).get("plugins", {})
        for entries in inst.values():
            for e in entries or []:
                if e.get("installPath"):
                    skill_dirs.append(Path(e["installPath"]) / "skills")
    except (OSError, ValueError):
        pass
    n, sz = 0, 0
    for d in skill_dirs:
        if d.is_dir():
            for s in sorted(d.glob("*/SKILL.md")):
                fm = frontmatter(s.read_text(errors="replace"))
                sz += len(fm.encode())
                n += 1
    if n:
        rows.append((sz, f"skill descriptions ({n})", Path("(frontmatter of each SKILL.md)")))
    notes.append("built-in and MCP tool/skill listings are not counted")

    if shutil.which("claude-role"):
        try:
            r = subprocess.run(["claude-role", "--path"], cwd=start, capture_output=True, text=True, timeout=5)
            rp = Path(r.stdout.strip()) if r.returncode == 0 else None
            if rp and rp.is_file():
                add("role file (claude-role hook)", rp)
        except (OSError, subprocess.SubprocessError):
            pass

    total = sum(r[0] for r in rows)
    print(f"loaded up front for a session in {start}:")
    for size, label, p in sorted(rows, key=lambda r: -r[0]):
        print(f"  {size:>7} B  ~{size // 4:>5} tok  {label:<28} {str(p).replace(str(HOME), '~', 1)}")
    print(f"  {total:>7} B  ~{total // 4:>5} tok  TOTAL ({len(rows)} entries)")
    for size, label, p in on_demand:
        print(f"  on demand (paths: rule) {size:>7} B  {str(p).replace(str(HOME), '~', 1)}")
    for n_ in notes:
        print(f"  note: {n_}")


# --- refs ----------------------------------------------------------------------------------------

PATH_RE = re.compile(r"(?<![\w/.-])((?:~|/home/[\w.-]+)/[\w./@+-]*[\w/])")
LINK_RE = re.compile(r"\[\[([^\]]+)\]\]")
INDEX_RE = re.compile(r"\]\(([^)]+\.md)\)")
SLUG_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")


def norm(s):
    s = s.lower().replace("_", "-").replace(" ", "-")
    s = re.sub(r"^(feedback|reference|project|user)-", "", s)
    return s.replace("-", "")


def refs(mem):
    if not mem.is_dir():
        sys.exit(f"context-audit: no memory directory at {mem}")
    files = sorted(p for p in mem.glob("*.md") if p.name != "MEMORY.md")
    index = mem / "MEMORY.md"
    names, by_norm, problems = {}, {}, 0
    for p in files:
        m = re.search(r"^name:\s*(.+)$", frontmatter(p.read_text(errors="replace")), re.M)
        name = m.group(1).strip().strip("\"'") if m else ""
        if not SLUG_RE.fullmatch(name):
            print(f"name not a slug  {p.name}: name: {name!r}")
            problems += 1
        names[name or p.stem] = p
        names.setdefault(p.stem, p)
        if SLUG_RE.fullmatch(name):
            by_norm.setdefault(norm(name), name)
            by_norm.setdefault(norm(p.stem), name)
    for p in files + ([index] if index.is_file() else []):
        text = p.read_text(errors="replace")
        for raw in sorted(set(PATH_RE.findall(text))):
            ok = safe_exists(raw)
            if ok is False:
                print(f"missing path     {p.name}: {raw}")
                problems += 1
        for link in sorted(set(LINK_RE.findall(text))):
            if not re.fullmatch(r"[\w .-]+", link):
                continue  # regex or code inside a sample, not a link
            if link not in names:
                hint = by_norm.get(norm(link))
                print(f"dangling link    {p.name}: [[{link}]]" + (f"  (did you mean [[{hint}]]?)" if hint else ""))
                problems += 1
    listed = set()
    if index.is_file():
        for target in INDEX_RE.findall(index.read_text(errors="replace")):
            listed.add(Path(target).name)
            if not (mem / target).is_file():
                print(f"index → missing file: {target}")
                problems += 1
    for p in files:
        if p.name not in listed:
            print(f"not in index     {p.name}")
            problems += 1
    print(f"{len(files)} memory files, {problems} finding(s). Triage each one: a missing path can be a "
          "fact that something is gone, and a dangling [[link]] can mark a memory worth writing. "
          "Paths with spaces are cut at the space, and ~/gdrive is never checked.")


# --- measure -------------------------------------------------------------------------------------

MEASURE_SURFACES = ["rules", "claude-md", "descriptions"]
MEASURE_GLOBS = {
    "rules": ["plugins/seyag/rules/*.md"],
    "claude-md": ["CLAUDE.md"],
    "descriptions": [
        "plugins/seyag/skills/*/SKILL.md",
        "plugins/seyag/agents/*.md",
    ],
}
MEASURE_EXTRACTOR_VERSION = 1

_DOUBLE_ESCAPES = {
    '"': '"',
    "\\": "\\",
    "/": "/",
    "b": "\b",
    "f": "\f",
    "n": "\n",
    "r": "\r",
    "t": "\t",
    "0": "\0",
    "a": "\a",
    "v": "\v",
    "e": "\x1b",
    " ": " ",
}


def count_lines(data):
    """Newline-terminated lines plus a final unterminated line (not strict wc -l)."""
    if not data:
        return 0
    return data.count(b"\n") + (0 if data.endswith(b"\n") else 1)


def measure_imports(text):
    """Fence- and inline-backtick-aware @-import scan using IMPORT_RE."""
    stripped = re.sub(r"```.*?```", "", text, flags=re.S)
    stripped = re.sub(r"`[^`\n]*`", "", stripped)
    return IMPORT_RE.findall(stripped)


def _decode_double_quoted(raw):
    if len(raw) < 2 or not raw.startswith('"') or not raw.endswith('"'):
        return None, "unclosed double-quoted scalar"
    out = []
    i = 1
    n = len(raw)
    while i < n - 1:
        ch = raw[i]
        if ch == '"':
            return None, "unescaped quote inside double-quoted scalar"
        if ch == "\\":
            if i + 1 >= n - 1:
                return None, "dangling backslash in double-quoted scalar"
            esc = raw[i + 1]
            if esc in _DOUBLE_ESCAPES:
                out.append(_DOUBLE_ESCAPES[esc])
                i += 2
            elif esc == "x":
                hx = raw[i + 2 : i + 4]
                if len(hx) != 2 or not re.fullmatch(r"[0-9a-fA-F]{2}", hx):
                    return None, "invalid \\x escape in double-quoted scalar"
                out.append(chr(int(hx, 16)))
                i += 4
            elif esc == "u":
                hx = raw[i + 2 : i + 6]
                if len(hx) != 4 or not re.fullmatch(r"[0-9a-fA-F]{4}", hx):
                    return None, "invalid \\u escape in double-quoted scalar"
                cp = int(hx, 16)
                if 0xD800 <= cp <= 0xDFFF:
                    return None, "surrogate code point in double-quoted scalar"
                out.append(chr(cp))
                i += 6
            elif esc == "U":
                hx = raw[i + 2 : i + 10]
                if len(hx) != 8 or not re.fullmatch(r"[0-9a-fA-F]{8}", hx):
                    return None, "invalid \\U escape in double-quoted scalar"
                cp = int(hx, 16)
                if cp > 0x10FFFF or (0xD800 <= cp <= 0xDFFF):
                    return None, "invalid code point in double-quoted scalar"
                out.append(chr(cp))
                i += 10
            else:
                return None, f"unsupported escape \\{esc} in double-quoted scalar"
        else:
            out.append(ch)
            i += 1
    return "".join(out), None


def extract_description(text):
    """Extract single-line description scalar from YAML frontmatter.
    Returns (decoded_str, None) on success, or (None, reason) when refused.
    """
    m = re.match(r"^---\n(.*?)\n---(?:\n|$)", text, re.S)
    if not m:
        return None, "missing or malformed frontmatter delimiter"
    fm = m.group(1)
    lines = fm.split("\n")
    desc_indices = []
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if not line[0].isspace():
            if not re.match(r"^[A-Za-z0-9_-]+\s*:(?:\s.*|$)", line):
                return None, f"malformed frontmatter line: {line!r}"
            if re.match(r"^description\s*:(?:\s.*|$)", line):
                desc_indices.append(idx)
        else:
            if not re.match(r"^\s+(?:-\s+|[A-Za-z0-9_-]+\s*:|\S)", line):
                return None, f"malformed indented frontmatter line: {line!r}"
    if len(desc_indices) == 0:
        return None, "missing description key"
    if len(desc_indices) > 1:
        return None, "duplicate description key"
    d_idx = desc_indices[0]
    for follow in lines[d_idx + 1 :]:
        s_follow = follow.strip()
        if not s_follow or s_follow.startswith("#"):
            continue
        if follow[0].isspace():
            return None, "multi-line or block description is not allowed"
        break
    raw_val = re.sub(r"^description\s*:", "", lines[d_idx], count=1).strip()
    if not raw_val:
        return None, "empty description value"
    if raw_val.startswith("'"):
        if len(raw_val) < 2 or not raw_val.endswith("'"):
            return None, "unclosed single-quoted description"
        inner = raw_val[1:-1]
        if "'" in inner.replace("''", ""):
            return None, "unescaped single quote in single-quoted description"
        decoded = inner.replace("''", "'")
    elif raw_val.startswith('"'):
        decoded, err = _decode_double_quoted(raw_val)
        if err:
            return None, err
    else:
        if raw_val[0] in "|>[]{}&*!%@`":
            return None, f"non-plain YAML scalar indicator {raw_val[0]!r}"
        if raw_val in ("|", ">", "|-", ">-", "|+", ">+"):
            return None, "block or folded scalar indicator"
        decoded = raw_val
    if not decoded or "\n" in decoded or "\r" in decoded:
        return None, "decoded description must be a non-empty single line"
    return decoded, None


def _is_under_root(path, root_resolved):
    try:
        rp = path.resolve()
    except OSError:
        return False
    return rp == root_resolved or str(rp).startswith(str(root_resolved).rstrip("/") + "/")


def _check_ancestors(root, root_resolved, rel_parts, irregular):
    cur = root
    for idx, part in enumerate(rel_parts):
        cur = cur / part
        rel = "/".join(rel_parts[: idx + 1])
        try:
            st = os.lstat(cur)
        except OSError:
            irregular.append(rel)
            return False
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or not _is_under_root(cur, root_resolved):
            irregular.append(rel)
            return False
    return True


def _empty_surface():
    return {
        "lines": 0,
        "bytes": 0,
        "code_points": 0,
        "file_count": 0,
        "hollow": True,
        "files": [],
        "refused_files": [],
        "imports": [],
        "subdirs": [],
        "malformed_skills": [],
        "irregular_files": [],
        "fixture_files": [],
    }


def _finalize_surface(surf):
    surf["hollow"] = (
        surf["file_count"] == 0
        or surf["lines"] == 0
        or surf["bytes"] == 0
        or len(surf["refused_files"]) > 0
    )
    surf["fixture_files"] = [
        f["path"]
        for f in surf["files"]
        if f["path"].startswith("tests/") or "/tests/" in f["path"]
    ]
    return surf


def measure(root):
    try:
        st_root = os.lstat(root)
        if stat.S_ISLNK(st_root.st_mode) or not stat.S_ISDIR(st_root.st_mode):
            sys.exit(f"context-audit: --root must be a real directory: {root}")
        root_resolved = root.resolve()
    except OSError as exc:
        sys.exit(f"context-audit: invalid --root {root}: {exc}")

    surfaces = {}

    # 1. rules: plugins/seyag/rules/*.md
    s_rules = _empty_surface()
    if _check_ancestors(root, root_resolved, ["plugins", "seyag", "rules"], s_rules["irregular_files"]):
        rules_dir = root / "plugins" / "seyag" / "rules"
        for name in sorted(os.listdir(rules_dir)):
            p = rules_dir / name
            rel = f"plugins/seyag/rules/{name}"
            try:
                st = os.lstat(p)
            except OSError:
                s_rules["irregular_files"].append(rel)
                continue
            if stat.S_ISDIR(st.st_mode):
                s_rules["subdirs"].append(rel)
            elif stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or not _is_under_root(p, root_resolved):
                s_rules["irregular_files"].append(rel)
            elif name.endswith(".md"):
                data = p.read_bytes()
                text = data.decode("utf-8", errors="replace")
                flines = count_lines(data)
                fbytes = len(data)
                fcp = len(text)
                for imp in measure_imports(text):
                    s_rules["imports"].append(f"{rel}: @{imp}")
                s_rules["files"].append({"path": rel, "lines": flines, "bytes": fbytes})
                s_rules["lines"] += flines
                s_rules["bytes"] += fbytes
                s_rules["code_points"] += fcp
                s_rules["file_count"] += 1
    surfaces["rules"] = _finalize_surface(s_rules)

    # 2. claude-md: CLAUDE.md
    s_claude = _empty_surface()
    p_claude = root / "CLAUDE.md"
    rel_claude = "CLAUDE.md"
    try:
        st_c = os.lstat(p_claude)
    except OSError:
        st_c = None
    if st_c is not None:
        if stat.S_ISDIR(st_c.st_mode):
            s_claude["subdirs"].append(rel_claude)
        elif stat.S_ISLNK(st_c.st_mode) or not stat.S_ISREG(st_c.st_mode) or not _is_under_root(p_claude, root_resolved):
            s_claude["irregular_files"].append(rel_claude)
        else:
            data = p_claude.read_bytes()
            text = data.decode("utf-8", errors="replace")
            flines = count_lines(data)
            fbytes = len(data)
            fcp = len(text)
            for imp in measure_imports(text):
                s_claude["imports"].append(f"{rel_claude}: @{imp}")
            s_claude["files"].append({"path": rel_claude, "lines": flines, "bytes": fbytes})
            s_claude["lines"] += flines
            s_claude["bytes"] += fbytes
            s_claude["code_points"] += fcp
            s_claude["file_count"] += 1
    surfaces["claude-md"] = _finalize_surface(s_claude)

    # 3. descriptions: plugins/seyag/skills/*/SKILL.md and plugins/seyag/agents/*.md
    s_desc = _empty_surface()

    def _measure_desc_file(p, rel):
        data = p.read_bytes()
        text = data.decode("utf-8", errors="replace")
        for imp in measure_imports(text):
            s_desc["imports"].append(f"{rel}: @{imp}")
        decoded, err = extract_description(text)
        s_desc["file_count"] += 1
        if err is not None:
            s_desc["refused_files"].append(f"{rel} ({err})")
            s_desc["files"].append({"path": rel, "lines": 0, "bytes": 0, "refused": True, "reason": err})
        else:
            d_bytes = decoded.encode("utf-8")
            flines = count_lines(d_bytes)
            fbytes = len(d_bytes)
            fcp = len(decoded)
            s_desc["files"].append({"path": rel, "lines": flines, "bytes": fbytes})
            s_desc["lines"] += flines
            s_desc["bytes"] += fbytes
            s_desc["code_points"] += fcp

    if _check_ancestors(root, root_resolved, ["plugins", "seyag", "skills"], s_desc["irregular_files"]):
        skills_dir = root / "plugins" / "seyag" / "skills"
        for skill_name in sorted(os.listdir(skills_dir)):
            sp = skills_dir / skill_name
            srel = f"plugins/seyag/skills/{skill_name}"
            try:
                st_s = os.lstat(sp)
            except OSError:
                s_desc["irregular_files"].append(srel)
                continue
            if stat.S_ISLNK(st_s.st_mode) or not stat.S_ISDIR(st_s.st_mode) or not _is_under_root(sp, root_resolved):
                s_desc["irregular_files"].append(srel)
                continue
            children = sorted(os.listdir(sp))
            if "SKILL.md" not in children:
                s_desc["malformed_skills"].append(srel + " (directory without SKILL.md)")
            for child_name in children:
                cp_path = sp / child_name
                crel = f"{srel}/{child_name}"
                try:
                    cst = os.lstat(cp_path)
                except OSError:
                    s_desc["irregular_files"].append(crel)
                    continue
                if stat.S_ISDIR(cst.st_mode):
                    continue  # skill-internal content: lazy, unmeasured, outside the perimeter
                if stat.S_ISLNK(cst.st_mode) or not stat.S_ISREG(cst.st_mode) or not _is_under_root(cp_path, root_resolved):
                    s_desc["irregular_files"].append(crel)
                elif child_name == "SKILL.md":
                    _measure_desc_file(cp_path, crel)

    agents_dir = root / "plugins" / "seyag" / "agents"
    if _check_ancestors(root, root_resolved, ["plugins", "seyag", "agents"], s_desc["irregular_files"]):
        for name in sorted(os.listdir(agents_dir)):
            p = agents_dir / name
            rel = f"plugins/seyag/agents/{name}"
            try:
                st_a = os.lstat(p)
            except OSError:
                s_desc["irregular_files"].append(rel)
                continue
            if stat.S_ISLNK(st_a.st_mode) or not stat.S_ISREG(st_a.st_mode) or not _is_under_root(p, root_resolved):
                s_desc["irregular_files"].append(rel)
            elif name.endswith(".md"):
                _measure_desc_file(p, rel)

    surfaces["descriptions"] = _finalize_surface(s_desc)

    instructions_total = sum(surfaces[s]["code_points"] for s in MEASURE_SURFACES)
    result = {
        "surfaces": surfaces,
        "instructions_total": instructions_total,
        "instructions_total_note": "decoded code points across rules + claude-md + descriptions; approximates UTF-16 code units",
        "config": {
            "surfaces": MEASURE_SURFACES,
            "globs": MEASURE_GLOBS,
            "extractor": MEASURE_EXTRACTOR_VERSION,
        },
    }
    print(json.dumps(result, indent=2))


def _parse_measure_root(rest):
    root = None
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg == "--root":
            if i + 1 >= len(rest):
                sys.exit("context-audit: --root requires a directory argument")
            root = Path(rest[i + 1])
            i += 2
        elif arg.startswith("--root="):
            val = arg.split("=", 1)[1]
            if not val:
                sys.exit("context-audit: --root requires a directory argument")
            root = Path(val)
            i += 1
        elif arg.startswith("-"):
            sys.exit(f"context-audit: unknown measure option {arg!r}")
        elif root is None:
            root = Path(arg)
            i += 1
        else:
            sys.exit(f"context-audit: unexpected measure argument {arg!r}")
    if root is None:
        default_root = Path(__file__).resolve().parents[3]
        root = default_root if (default_root / "plugins" / "seyag").exists() else Path.cwd()
    return root


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]
    if cmd == "weigh":
        weigh(Path(rest[0]) if rest else Path.cwd())
    elif cmd == "refs":
        refs(Path(rest[0]) if rest else memory_dir(Path.cwd()))
    elif cmd == "measure":
        measure(_parse_measure_root(rest))
    else:
        sys.exit(f"context-audit: unknown command {cmd!r} (weigh, refs, measure)")


if __name__ == "__main__":
    main()
