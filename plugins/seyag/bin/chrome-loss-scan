#!/usr/bin/env -S python3 -I -B
"""chrome-loss-scan - list live Claude Code sessions that have no Claude in Chrome tools.

Usage:
  chrome-loss-scan            # one line per session without Chrome; exit 1 if any
  chrome-loss-scan --json     # machine-readable, every live session with its state
  chrome-loss-scan --agents FILE --projects DIR   # test seams (FILE = `claude agents --json` output)
                              # --projects defaults to CLAUDE_PROJECTS_DIR, else ${CLAUDE_CONFIG_DIR:-~/.claude}/projects

Reads each live session's current transcript (`claude agents --json` lists
headless -p children too, as kind interactive) and replays its deferred_tools_delta
records for mcp__claude-in-chrome__* tools. States: "on"; "lost" (added, then
all removed); "off" (this process never listed them, e.g. it resumed while
logged out); "unreadable" (the transcript is there but can't be opened or read);
"n/a" (a would-be lost/off session that can never carry Chrome: a headless -p
child, entrypoint sdk-cli, or a non-Claude backend, last assistant model not
claude-*; not counted toward exit 1; --json rows carry the "reason").
A logged-out restart comes up with Chrome off and /login doesn't restore it;
a fresh start does.
Exit 1 when any session is lost or off, has no transcript or an unreadable one,
or the session list can't be read; exit 2 on a usage error.
"""
import glob
import json
import os
import subprocess
import sys

# config.toml knobs (config_env, the Python twin of hooks/lib/config-env.sh); a wiring error proceeds env-only.
try:
    _SYG_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    sys.path.insert(0, os.path.join(_SYG_ROOT, "lib"))
    import config_env

    config_env.syg_config_env(_SYG_ROOT)
except Exception:
    pass

PREFIX = "mcp__claude-in-chrome__"


def live_sessions(agents_file):
    try:
        if agents_file:
            with open(agents_file) as fh:
                arr = json.load(fh)
        else:
            res = subprocess.run(["claude", "agents", "--json"], capture_output=True, text=True, timeout=20, check=False)
            if res.returncode != 0:
                sys.exit(f"chrome-loss-scan: `claude agents --json` failed (exit {res.returncode}): {res.stderr.strip()[:200]}")
            arr = json.loads(res.stdout)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        sys.exit(f"chrome-loss-scan: can't read the session list: {e}")
    if not isinstance(arr, list):
        # A changed output shape must not read as "no sessions, all fine".
        sys.exit(f"chrome-loss-scan: session list is a {type(arr).__name__}, expected a list")
    return [a for a in arr if isinstance(a, dict) and a.get("pid") is not None and a.get("sessionId")]


def prefixed(names):
    """The Chrome tool names in a delta's name list; a value that isn't a list, or an item that isn't a string, is ignored."""
    if not isinstance(names, list):
        return set()
    return {n for n in names if isinstance(n, str) and n.startswith(PREFIX)}


def chrome_state(path):
    """Return (state, last_change_ts): state is 'on', 'lost', 'off', or 'unreadable' (the file can't be opened or read)."""
    had = False
    current = set()
    last_ts = None
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                if '"deferred_tools_delta"' not in line or PREFIX not in line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(rec, dict):
                    continue
                att = rec.get("attachment") or {}
                if not isinstance(att, dict) or att.get("type") != "deferred_tools_delta":
                    continue
                before = bool(current)
                for key in ("addedNames", "readdedNames"):
                    current |= prefixed(att.get(key))
                current -= prefixed(att.get("removedNames"))
                if current:
                    had = True
                if before != bool(current):
                    last_ts = rec.get("timestamp")
    except OSError:
        return "unreadable", None
    if current:
        return "on", last_ts
    return ("lost" if had else "off"), last_ts


def na_reason(path):
    """Why this session can never carry Chrome, or None: 'headless' (last entrypoint sdk-cli, a -p child) or
    'model M' (last non-synthetic assistant model M is not claude-*). An unreadable file returns None."""
    entry = None
    model = None
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(rec, dict):
                    continue
                ep = rec.get("entrypoint")
                if isinstance(ep, str):
                    entry = ep
                if rec.get("type") == "assistant":
                    msg = rec.get("message")
                    m = msg.get("model") if isinstance(msg, dict) else None
                    if isinstance(m, str) and m and m != "<synthetic>":
                        model = m
    except OSError:
        return None
    if entry == "sdk-cli":
        return "headless"
    if model is not None and not model.startswith("claude-"):
        return f"model {model}"
    return None


def mtime_or_old(path):
    """The file's mtime; a file that vanished since the glob sorts oldest instead of raising."""
    try:
        return os.path.getmtime(path)
    except OSError:
        return -1


def transcript_for(projects_dir, session_id):
    hits = glob.glob(os.path.join(glob.escape(projects_dir), "*", glob.escape(session_id) + ".jsonl"))
    return max(hits, key=mtime_or_old) if hits else None


def usage_error(msg):
    print(f"chrome-loss-scan: {msg}", file=sys.stderr)
    print("usage: chrome-loss-scan [--json] [--agents FILE --projects DIR]", file=sys.stderr)
    return 2


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    as_json = False
    agents_file = None
    projects_arg = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            as_json = True
            i += 1
        elif a in ("--agents", "--projects"):
            if i + 1 >= len(argv):
                return usage_error(f"{a} needs a value")
            if a == "--agents":
                agents_file = argv[i + 1]
            else:
                projects_arg = argv[i + 1]
            i += 2
        else:
            return usage_error(f"unknown argument: {a}")
    projects_dir = projects_arg or os.environ.get("CLAUDE_PROJECTS_DIR") or os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "projects")
    rows = []
    for a in live_sessions(agents_file):
        sid = a["sessionId"]
        # a session id that isn't a string can't name a transcript: it stays a row, reported as no-transcript
        path = transcript_for(projects_dir, sid) if isinstance(sid, str) else None
        state, ts = chrome_state(path) if path else ("no-transcript", None)
        reason = na_reason(path) if state in ("lost", "off") else None
        if reason:
            state = "n/a"
        rows.append({"name": a.get("name") or "", "id": a.get("id") or str(sid)[:8], "pid": a.get("pid"),
                     "cwd": a.get("cwd") or "", "state": state, "since": ts, "reason": reason})
    na = [r for r in rows if r["state"] == "n/a"]
    missing = [r for r in rows if r["state"] in ("lost", "off")]
    unread = [r for r in rows if r["state"] in ("no-transcript", "unreadable")]
    if as_json:
        print(json.dumps(rows, indent=1))
    else:
        for r in missing:
            when = f"since {r['since']}" if r["since"] else "since its start"
            print(f"no Chrome ({r['state']}): {r['name'] or '(unnamed)'} [{r['id']}] pid {r['pid']} {when} "
                  f"({r['cwd']}); restart it fresh to get Chrome back")
        for r in unread:
            if r["state"] == "unreadable":
                print(f"unknown: {r['name'] or '(unnamed)'} [{r['id']}] transcript can't be read")
            else:
                print(f"unknown: {r['name'] or '(unnamed)'} [{r['id']}] has no transcript under the projects dir")
        if not missing and not unread:
            if na:
                print(f"chrome-loss-scan: {len(rows)} live session(s), all that can carry Chrome have it; "
                      f"{len(na)} n/a (headless or non-Claude backend)")
            else:
                print(f"chrome-loss-scan: {len(rows)} live session(s), all have Chrome")
    # An unreadable transcript is not evidence of Chrome: a layout change must go red, not green.
    return 1 if missing or unread else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
