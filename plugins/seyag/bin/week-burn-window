#!/bin/bash
# week-burn-window: should the plan week's tail be burned now? The reference helper for
# CLAUDE_USAGE_WEEK_RESERVE_CMD (claude-usage's plan --ok branch reads it per gate check): it
# prints 99 — a reserve the week stays under, so the gate passes until 99% — once the time left
# to the weekly reset fits inside the burn window, so a deployment can spend the expiring tail
# instead of losing it at the reset. Before the window, and on any input it cannot trust, it
# prints the hold reserve, so a gate run stays quiet outside the burn: no reading, no burn.
#
# Input: the readings log ${XDG_STATE_HOME:-$HOME/.local/state}/claude-usage/readings.jsonl
# (claude-usage's log_reading writes it; usage-sweep's --points/--fit read it). JSONL rows
# {"epoch": int, "weekly_pct": number, "weekly_resets_at": int, ...}; malformed lines and rows
# without an integer epoch or a finite numeric weekly_pct are skipped, the way usage-sweep's
# reader skips them (a null or wrong-typed weekly_resets_at keeps the row, with the reset
# unknown; an out-of-range float like 1e999 parses as inf and degrades the same way — int()
# fields overflow it away, a non-finite weekly_pct drops the row).
#
# Arithmetic (constants at the top):
#   now   = SYG_WEEK_BURN_NOW (epoch override; the test clock) else date +%s
#   week  = the latest row's weekly_pct; reset_ts = its weekly_resets_at (integer epoch)
#   rate  = SYG_WEEK_BURN_RATE (%/h, a number > 0) when set — the full override, wins
#           entirely and is taken as given (never floored) — else the slope of weekly_pct over
#           the rows with epoch >= now - RATE_WINDOW_S (6 h back), split by shape: >= 2 rows
#           spanning >= MIN_SPAN_S (30 min) give rate_h = (last - first) / span_hours, where a
#           fresh fetch record (see Freshness) substitutes now for the latest row's epoch —
#           the endpoint becomes (now, latest["week"]), so a meter that climbed and then
#           parked (dedupe writes no rows) gets an honest decaying rate instead of a stale
#           steep one; >= 2
#           rows over a shorter span is an unreliable slope and holds. < 2 rows in the window
#           is the parked-meter shape when the fetch record is fresh (see Freshness): dedupe
#           leaves an unmoved meter no new rows, so a meter just fetched with < 2 in-window
#           rows has not moved since its latest row — a flat reading, rate 0, floored below.
#           < 2 rows with the fetch record stale or missing is no usable rate: hold. A rate
#           above 100 clamps to 100.
#   Burn window (seconds) = (100 - week) / rate_h hours, in seconds, + the margin
#           (SYG_WEEK_BURN_MARGIN_MIN, integer >= 0, default MARGIN_MIN_DEFAULT = 30) in
#           minutes. Every computed rate (slope, fresh-endpoint decay, parked/flat) is floored
#           at RATE_FLOOR — a capacity default applied to every rate, so a held, parked or
#           trickle week (whose own slope reads ~0 or a crawl under the hold) sizes its window
#           by capacity instead: the tail burns once the reset is close enough, and never days
#           early on a tiny positive rate. The SYG_WEEK_BURN_RATE override wins entirely and
#           skips the floor.
#   Freshness: the latest row counts as fresh when EITHER its epoch OR the fetch record's
#           (readings.jsonl.last's content: the fetch epoch claude-usage writes there on every
#           refresh, dedupe or not) age is within STALE_MAX_S (2 h) — a parked meter writes no
#           new rows (dedupe) and the fetch
#           record is what still moves: fetched fresh with < 2 in-window rows, the reading is
#           flat since the latest row (the rate paragraph's floor path). Both stale, or .last
#           missing or unparsable, hold: burn needs a recent
#           fetch. A latest row dated more than 300 s ahead of now holds too: untrusted clock
#           skew.
#   Burn iff reset_ts > now AND week < 100 AND (reset_ts - now) <= burn window.
#
#   Pacing, not a bug: while burning, the fleet consumes faster, the window shrinks below
#   time-to-reset, and the helper flips back to hold until the rate falls again.
#
# Output contract: exactly one integer 1-99 and a newline on stdout, exit 0, on every decided
# path — 99 while burning, else the hold reserve (CLAUDE_USAGE_WEEK_RESERVE when that is an
# integer 1-99, else 75). Degraded input — missing or empty log, no parsable rows, a stale
# latest row with no fresh fetch record, a future-dated latest row, no usable rate,
# weekly_resets_at missing or past, week >= 100 — holds quietly, because the gate's fallback
# stderr note only fires on unusable output and a helper that always answers keeps every --ok
# quiet outside the burn window. Exit 1 with nothing on stdout is crash-class only: a
# set-but-invalid SYG_WEEK_BURN_NOW, SYG_WEEK_BURN_RATE (not a number > 0) or
# SYG_WEEK_BURN_MARGIN_MIN (not an integer >= 0, or longer than bash arithmetic can do), a
# missing python3, or an unexpected failure — the gate then names it on stderr instead of
# holding silently.

set -uo pipefail

RATE_WINDOW_S=21600   # slope looks back 6 h at most
MIN_SPAN_S=1800       # the slope needs >= 30 min between the window's first and last row
STALE_MAX_S=7200      # a reading older than 2 h is stale unless the fetch record is recent
MARGIN_MIN_DEFAULT=30 # minutes added to the burn window
BURN_RESERVE=99       # a reserve the week stays under, so the gate passes until 99%
RATE_FLOOR=1          # %/h capacity default: every computed rate floors at this. Raising it
                      # past ~1.98 also flips tests/claude-usage.probe.sh's fresh end-to-end
                      # row (its log fixture is week 90, reset 20000 s out: 36000/f + 1800 >=
                      # 20000 -> f <= 1.978; runtime-verified 11-04: rate 1.9 burns, 2 holds) —
                      # re-anchor that file on any floor change.

die() { echo "week-burn-window: $1" >&2; exit 1; }

now=$(date +%s)
if [ -n "${SYG_WEEK_BURN_NOW:-}" ]; then
    # The length guards run before the arithmetic, like the reserve override's below: bash's
    # $((10#...)) silently wraps on huge digit strings.
    [[ $SYG_WEEK_BURN_NOW =~ ^[0-9]+$ ]] || die "SYG_WEEK_BURN_NOW='$SYG_WEEK_BURN_NOW' is not an epoch"
    [ "${#SYG_WEEK_BURN_NOW}" -le 12 ] || die "SYG_WEEK_BURN_NOW='$SYG_WEEK_BURN_NOW' is not an epoch"
    now=$((10#$SYG_WEEK_BURN_NOW))
fi
margin_min=$MARGIN_MIN_DEFAULT
if [ -n "${SYG_WEEK_BURN_MARGIN_MIN:-}" ]; then
    [[ $SYG_WEEK_BURN_MARGIN_MIN =~ ^[0-9]+$ ]] || die "SYG_WEEK_BURN_MARGIN_MIN='$SYG_WEEK_BURN_MARGIN_MIN' is not an integer >= 0"
    [ "${#SYG_WEEK_BURN_MARGIN_MIN}" -le 12 ] || die "SYG_WEEK_BURN_MARGIN_MIN='$SYG_WEEK_BURN_MARGIN_MIN' is not an integer >= 0"
    margin_min=$((10#$SYG_WEEK_BURN_MARGIN_MIN))
fi
rate_override=""
if [ -n "${SYG_WEEK_BURN_RATE:-}" ]; then
    [[ $SYG_WEEK_BURN_RATE =~ ^[0-9]+([.][0-9]+)?$ ]] || die "SYG_WEEK_BURN_RATE='$SYG_WEEK_BURN_RATE' is not a number"
    LC_ALL=C awk -v r="$SYG_WEEK_BURN_RATE" 'BEGIN{exit !(r + 0 > 0)}' \
        || die "SYG_WEEK_BURN_RATE='$SYG_WEEK_BURN_RATE' is not > 0"
    rate_override=$SYG_WEEK_BURN_RATE
fi
hold=75
# Same 1-99 rule as the gate's static override; the length guard runs before the arithmetic,
# because bash's $((10#...)) silently wraps on huge digit strings.
if [[ ${CLAUDE_USAGE_WEEK_RESERVE:-} =~ ^[0-9]+$ ]] && [ "${#CLAUDE_USAGE_WEEK_RESERVE}" -le 8 ] \
    && [ "$((10#$CLAUDE_USAGE_WEEK_RESERVE))" -ge 1 ] && [ "$((10#$CLAUDE_USAGE_WEEK_RESERVE))" -le 99 ]; then
    hold=$((10#$CLAUDE_USAGE_WEEK_RESERVE))
fi

log="${XDG_STATE_HOME:-$HOME/.local/state}/claude-usage/readings.jsonl"
# The fetch record claude-usage keeps next to the log (readings.jsonl.last) is rewritten on
# every refresh, dedupe or not, and its CONTENT is the fetch epoch claude-usage writes there,
# so reading its first line says when the meters were last actually read — mtime is not
# trusted: sync and backup tools touch it without a fetch. A missing or non-integer record
# falls back to 0 = infinitely stale; 0 needs no guard, since now - 0 > STALE_MAX_S always.
last_fetch=$(head -n 1 "$log.last" 2>/dev/null)
case $last_fetch in ''|*[!0-9]*) last_fetch=0 ;; esac
python3 - "$log" "$hold" "$now" "$((margin_min * 60))" "$rate_override" \
    "$RATE_WINDOW_S" "$MIN_SPAN_S" "$STALE_MAX_S" "$BURN_RESERVE" "$last_fetch" "$RATE_FLOOR" <<'PY' || exit 1
import json
import math
import sys

log, hold, now, margin_s = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
rate_ov = sys.argv[5] or None
rate_window_s, min_span_s, stale_max_s, burn_reserve = (
    int(sys.argv[6]), int(sys.argv[7]), int(sys.argv[8]), int(sys.argv[9]))
last_fetch, rate_floor = int(sys.argv[10]), float(sys.argv[11])


def hold_out():
    print(hold)
    sys.exit(0)


def parse_reset(val):  # usage-sweep's reader: null/bool/bad -> None (row kept, reset unknown)
    if val is None or isinstance(val, bool):
        return None
    try:
        return int(val)
    except (AttributeError, TypeError, ValueError, OverflowError):
        return None


rows = []
try:
    fh = open(log, errors="replace")
except OSError:
    hold_out()  # no log: nothing has been read, so nothing may burn
with fh:
    for raw in fh:
        try:
            e = json.loads(raw)
            week = float(e["weekly_pct"])
            if not math.isfinite(week):
                raise ValueError  # NaN or an out-of-range float (1e999): drop the row, untrusted
            rows.append({"epoch": int(e["epoch"]), "week": week,
                         "reset": parse_reset(e.get("weekly_resets_at"))})
        except (AttributeError, KeyError, TypeError, ValueError, OverflowError):
            continue  # a malformed line, or a JSON-valid one with wrong-typed/out-of-range values

if not rows:
    hold_out()
rows.sort(key=lambda r: r["epoch"])
latest = rows[-1]
if now - latest["epoch"] > stale_max_s and now - last_fetch > stale_max_s:
    hold_out()  # stale: the latest row AND the fetch record are old (or .last is missing) —
                # the meters could have moved since; burn needs a recent fetch, never a guess
if latest["epoch"] > now + 300:
    hold_out()  # future-dated latest row: untrusted clock skew
week, reset = latest["week"], latest["reset"]
if reset is None or reset <= now or week >= 100:
    hold_out()
if rate_ov is not None:
    rate_h = float(rate_ov)
else:
    win = [r for r in rows if r["epoch"] >= now - rate_window_s]
    if len(win) >= 2:
        # A fresh fetch record (see Freshness) substitutes now for the latest row's epoch: the
        # meters were read within STALE_MAX_S, so the latest reading still holds at now and the
        # slope's endpoint becomes (now, latest["week"]) — a meter that climbed and then parked
        # (dedupe writes no rows) gets an honest decaying rate instead of a stale steep one.
        # (win[-1] indexing stays inside this branch: an empty window must reach the parked
        # path below, never here.)
        span_ep = now if now - last_fetch <= stale_max_s else win[-1]["epoch"]
        if span_ep - win[0]["epoch"] >= min_span_s:
            rate_h = (latest["week"] - win[0]["week"]) / ((span_ep - win[0]["epoch"]) / 3600)
        else:
            hold_out()  # >= 2 rows but a span under MIN_SPAN_S: a slope over a tiny span is
                        # unreliable — no reading, no burn
    elif not win:
        # Empty window, explicit: the same split as the < 2-rows case below — a fresh fetch
        # reads flat (the parked path), a stale one has no usable rate.
        if now - last_fetch <= stale_max_s:
            rate_h = 0
        else:
            hold_out()
    elif now - last_fetch <= stale_max_s:
        # The parked-meter path: log_reading dedupes identical readings, so an unmoved meter
        # writes no new rows and the fetch record is what still moves. The meters were read
        # within STALE_MAX_S but the log holds < 2 in-window rows, so the reading has not
        # moved since the latest row: flat, and the flat rate's floor below bounds the window.
        rate_h = 0
    else:
        hold_out()  # < 2 in-window rows and no recent fetch record: no usable rate —
                    # no reading, no burn
if rate_ov is None and rate_h < rate_floor:
    # The capacity default, one mechanism over every computed rate (slope, fresh-endpoint
    # decay, parked/flat): a hold suppresses the very rate it is holding, so a tiny positive
    # slope must not size the window — floored at the capacity default, a held or trickle
    # week burns only once the reset is close enough. The SYG_WEEK_BURN_RATE override wins
    # entirely and is taken as given — never floored.
    rate_h = rate_floor
if rate_h > 100:
    rate_h = 100
window_s = (100 - week) / rate_h * 3600 + margin_s
print(burn_reserve if reset - now <= window_s else hold)
PY
