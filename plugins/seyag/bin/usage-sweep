#!/usr/bin/env python3
"""usage-sweep: weighted Claude Code token spend from the local session logs.

Sweeps every project folder under ~/.claude/projects (or CLAUDE_PROJECTS_DIR),
main-loop session files and subagents/ files alike, and prints weighted totals
per model, per project folder and main-vs-subagent, plus the live plan meter
from `claude-usage --json` when it is on PATH.

Usage:
  usage-sweep                      since the current weekly window opened
  usage-sweep --since 2026-09-24T01:15Z
  usage-sweep --since 2026-09-24T01:15Z --until 2026-09-24T12:00Z
  usage-sweep --slug -home-deck-Projects-tzurot   (repeatable; default: all)
  usage-sweep --points             also convert each folder's share into meter points,
                                   priced by claude-usage's readings log
  usage-sweep --by-session         attribute per session (slug/session) instead of per folder
  usage-sweep --fit                fit per-model meter rates (pts/M) via NNLS over tick intervals
  usage-sweep --probe START END    compare observed meter ticks vs fitted spend estimate in [START, END]
  usage-sweep --meter 5h|week      meter to fit (default: 5h)
  usage-sweep --max-gap SEC        max tick bracket width in seconds (default: 180)
  usage-sweep --max-span SEC       max interval span in seconds (default: 18000)
  usage-sweep --boot N             bootstrap resamples for CI (default: 1000)
  usage-sweep --json               machine-readable output
  usage-sweep --no-dedupe          count every usage line (the old, inflated method)

Claude Code writes each content block of one reply (thinking, text, tool_use)
as its own JSONL line, and every one of those lines repeats the reply's full
usage, with output_tokens growing as the reply streams. Summing lines overcounts;
this script counts each reply (message id + request id) once, at its largest
output_tokens, across all files.

Weights: input 1x, output 5x, cache read 0.1x, cache write 1.25x. They track
the trend and the delegation ratio; the plan meter is the instrument for pace.

Meter-point shares are of the swept set: with --slug the per-slug points sum
to less than the window's total weekly delta; shares and points cover billed
(Anthropic-family) weight only — unbilled-family and unknown-model tokens are
excluded.

The tick method fits per-model meter rates (points per M weighted tokens) from
precise meter ticks. claude-usage records prev_epoch to bracket each tick in
[prev_epoch, epoch]. Ticks with bracket width <= --max-gap seconds (default 180s)
are precise ticks; intervals join consecutive precise ticks within a chain
(resets detected via resets_at shifts > 600 s or drops > 0.5%, or gaps > --max-span, split chains). For each interval,
Δpoints = Σ_family rate_family × spend_family. Non-negative least squares (NNLS)
over active families solves for rates, with a bootstrap CI (--boot N, default 1000);
the fit refuses when intervals ≤ active families. The fit reports `thin` (text: a
"rates and ranges are rough" note) when there are fewer than 3 intervals per active family.
--boot costs time linearly (about a few seconds at 1000 resamples for ~150 intervals);
lower it for very long windows.
A dense reading log keeps tick brackets tight: poller recipe
CLAUDE_USAGE_TTL=55 claude-usage --json >/dev/null run every 60 s (a timer) keeps
brackets <= ~60 s.
"""
import argparse
import json
import os
import random
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from itertools import combinations
from pathlib import Path

USAGE_FIELDS = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
WEIGHTS = {"input": 1.0, "output": 5.0, "cache_read": 0.1, "cache_write": 1.25}
FITTED_FAMILIES = ("opus", "sonnet", "haiku", "fable", "claude-other")


def family(model):
    if not model.startswith("claude-"):
        return "unbilled"
    for fam in ("opus", "sonnet", "haiku", "fable"):
        if fam in model:
            return fam
    return "claude-other"


def parse_ts(s):
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    dt = datetime.fromisoformat(s)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def meter():
    try:
        out = subprocess.run(["claude-usage", "--json"], capture_output=True, text=True, timeout=30)
        return json.loads(out.stdout) if out.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def weigh(u):
    return (
        (u.get("input_tokens") or 0) * WEIGHTS["input"]
        + (u.get("output_tokens") or 0) * WEIGHTS["output"]
        + (u.get("cache_read_input_tokens") or 0) * WEIGHTS["cache_read"]
        + (u.get("cache_creation_input_tokens") or 0) * WEIGHTS["cache_write"]
    )


def folder_label(name):
    # Scratchpad-launched sessions get a slug that embeds a session id; never print it.
    return "-tmp* (scratchpad and /tmp sessions)" if name.startswith("-tmp") else name


def readings_log_path():
    # claude-usage appends a reading on each cache refresh; key order is not stable between lines.
    state = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    return Path(state) / "claude-usage" / "readings.jsonl"


def read_readings(path):
    # Returns ([{epoch, weekly_pct, five_hour_pct, prev_epoch, five_hour_resets_at, weekly_resets_at}, ...], skipped_malformed_count).
    readings, skipped = [], 0
    try:
        fh = open(path, errors="replace")
    except OSError:
        return readings, skipped
    with fh:
        for raw in fh:
            try:
                e = json.loads(raw)
                fh5 = e.get("five_hour_pct")
                pe = e.get("prev_epoch")
                prev_epoch = None
                if pe is not None and not isinstance(pe, bool):
                    try:
                        prev_epoch = int(pe)
                    except (AttributeError, TypeError, ValueError):
                        prev_epoch = None

                def parse_reset(val):
                    if val is None or isinstance(val, bool):
                        return None
                    try:
                        return int(val)
                    except (AttributeError, TypeError, ValueError):
                        return None

                fh_reset = parse_reset(e.get("five_hour_resets_at"))
                wk_reset = parse_reset(e.get("weekly_resets_at"))

                readings.append({"epoch": int(e["epoch"]),
                                 "weekly_pct": float(e["weekly_pct"]),
                                 "five_hour_pct": None if fh5 is None else float(fh5),
                                 "prev_epoch": prev_epoch,
                                 "five_hour_resets_at": fh_reset,
                                 "weekly_resets_at": wk_reset})
            except (AttributeError, KeyError, TypeError, ValueError):
                skipped += 1  # a malformed line, or a JSON-valid one with wrong-typed values
                continue
    readings.sort(key=lambda r: r["epoch"])
    return readings, skipped


def solve_linear(A, b):
    # Solves Ax = b using Gaussian elimination with partial pivoting.
    # Returns list of floats x, or None if singular.
    n = len(A)
    M = [list(A[i]) + [float(b[i])] for i in range(n)]
    for i in range(n):
        max_row = i
        max_val = abs(M[i][i])
        for r in range(i + 1, n):
            if abs(M[r][i]) > max_val:
                max_val = abs(M[r][i])
                max_row = r
        if max_val < 1e-12:
            return None
        if max_row != i:
            M[i], M[max_row] = M[max_row], M[i]
        pivot = M[i][i]
        for r in range(i + 1, n):
            factor = M[r][i] / pivot
            for c in range(i, n + 1):
                M[r][c] -= factor * M[i][c]
    x = [0.0] * n
    for i in range(n - 1, -1, -1):
        s = M[i][n]
        for c in range(i + 1, n):
            s -= M[i][c] * x[c]
        if abs(M[i][i]) < 1e-12:
            return None
        x[i] = s / M[i][i]
    return x


def nnls(X, y):
    # Solves non-negative least squares by subset enumeration.
    # X is m x k, y is length m.
    # Returns (best_beta, best_rss).
    m = len(y)
    k = len(X[0]) if m > 0 and len(X) > 0 else 0
    if k == 0:
        return [0.0] * k, sum(yi ** 2 for yi in y)
    best_beta = [0.0] * k
    best_rss = sum(yi ** 2 for yi in y)

    for size in range(1, k + 1):
        for subset in combinations(range(k), size):
            p = len(subset)
            A = [[0.0] * p for _ in range(p)]
            b = [0.0] * p
            for r in range(p):
                col_r = subset[r]
                for c in range(p):
                    col_c = subset[c]
                    A[r][c] = sum(X[i][col_r] * X[i][col_c] for i in range(m))
                b[r] = sum(X[i][col_r] * y[i] for i in range(m))
            sol = solve_linear(A, b)
            if sol is None:
                continue
            if all(coef >= -1e-9 for coef in sol):
                sol_clamped = [max(0.0, c) for c in sol]
                full_beta = [0.0] * k
                for idx, col in enumerate(subset):
                    full_beta[col] = sol_clamped[idx]
                rss = 0.0
                for i in range(m):
                    pred = sum(X[i][j] * full_beta[j] for j in range(k))
                    rss += (y[i] - pred) ** 2
                if rss < best_rss:
                    best_rss = rss
                    best_beta = full_beta
    return best_beta, best_rss


def percentile(vals, p):
    if not vals:
        return 0.0
    sv = sorted(vals)
    k = (len(sv) - 1) * (p / 100.0)
    f = int(k)
    c = min(f + 1, len(sv) - 1)
    d = k - f
    return sv[f] * (1.0 - d) + sv[c] * d


def extract_ticks_and_intervals(readings, replies, meter_field, max_gap, max_span, since_ts, until_ts):
    valid_readings = [r for r in readings if r.get(meter_field) is not None]
    chains = [[]]
    ticks_total = 0
    ticks_precise = 0
    reset_field = "five_hour_resets_at" if meter_field == "five_hour_pct" else "weekly_resets_at"
    for a, b in zip(valid_readings, valid_readings[1:]):
        a_v = a[meter_field]
        b_v = b[meter_field]
        a_reset = a.get(reset_field)
        b_reset = b.get(reset_field)

        is_reset = False
        if a_reset is not None and b_reset is not None:
            if abs(b_reset - a_reset) > 600:
                is_reset = True
        else:
            if b_v < a_v - 0.5:
                is_reset = True

        if (b["epoch"] - a["epoch"]) > max_span:
            chains.append([])
            continue
        elif is_reset:
            chains.append([])
            continue

        if b_v > a_v:
            lo = max(a["epoch"], b["prev_epoch"]) if b.get("prev_epoch") is not None else a["epoch"]
            hi = b["epoch"]
            t = (lo + hi) / 2.0
            width = hi - lo
            precise = (width <= max_gap)

            in_window = True
            if since_ts is not None and hi < since_ts:
                in_window = False
            if until_ts is not None and hi > until_ts:
                in_window = False

            if in_window:
                ticks_total += 1
                if precise:
                    ticks_precise += 1

            chains[-1].append({
                "epoch": b["epoch"],
                "v": b_v,
                "lo": lo,
                "hi": hi,
                "t": t,
                "width": width,
                "precise": precise,
            })

    intervals = []
    all_reply_list = list(replies.values())
    for chain in chains:
        precise_ticks = [tk for tk in chain if tk["precise"]]
        for p1, p2 in zip(precise_ticks, precise_ticks[1:]):
            delta = p2["v"] - p1["v"]
            t_start = p1["t"]
            t_end = p2["t"]
            span = t_end - t_start
            if span > max_span:
                continue
            if since_ts is not None and t_start < since_ts:
                continue
            if until_ts is not None and t_end > until_ts:
                continue
            if delta <= 0:
                continue

            iv_spend = {f: 0.0 for f in FITTED_FAMILIES}
            for r in all_reply_list:
                rep_epoch = r[5]
                if t_start <= rep_epoch < t_end:
                    fam = family(r[3])
                    w = weigh(r[4])
                    if fam in iv_spend:
                        iv_spend[fam] += w

            fitted_spend_M = sum(iv_spend.values()) / 1e6
            if fitted_spend_M <= 0:
                continue

            intervals.append({
                "t_start": t_start,
                "t_end": t_end,
                "delta": delta,
                "spend_M": {f: iv_spend[f] / 1e6 for f in FITTED_FAMILIES},
            })

    return intervals, ticks_total, ticks_precise


def fit_meter_rates(intervals, boot_n=1000):
    m = len(intervals)
    if m < 3:
        sys.stderr.write(f"usage-sweep: --fit needs at least 3 tick intervals, found {m}\n")
        sys.exit(1)

    active_families = [f for f in FITTED_FAMILIES if sum(iv["spend_M"][f] for iv in intervals) > 0]
    k = len(active_families)
    if m <= k:
        names = ", ".join(active_families)
        sys.stderr.write(
            f"usage-sweep: --fit needs more tick intervals than active model families"
            f" (found {m} intervals, {k} families: {names}); widen --since or poll the meter more densely\n"
        )
        sys.exit(1)

    thin = m < 3 * k
    y = [iv["delta"] for iv in intervals]
    X = [[iv["spend_M"][f] for f in active_families] for iv in intervals]

    best_beta, best_rss = nnls(X, y)

    y_bar = sum(y) / m
    sst = sum((yi - y_bar) ** 2 for yi in y)
    r2 = round(1.0 - best_rss / sst, 4) if abs(sst) > 1e-12 else None

    rates = {f: 0.0 for f in FITTED_FAMILIES}
    for idx, f in enumerate(active_families):
        rates[f] = best_beta[idx]

    rng = random.Random(1)
    boot_samples = []
    boot_rates = {f: [] for f in FITTED_FAMILIES}
    for _ in range(boot_n):
        sample = [intervals[rng.randrange(m)] for _ in range(m)]
        X_s = [[iv["spend_M"][f] for f in active_families] for iv in sample]
        y_s = [iv["delta"] for iv in sample]
        s_beta, _ = nnls(X_s, y_s)
        s_dict = {f: 0.0 for f in FITTED_FAMILIES}
        for idx, f in enumerate(active_families):
            s_dict[f] = s_beta[idx]
        for f in FITTED_FAMILIES:
            boot_rates[f].append(s_dict[f])
        boot_samples.append(s_dict)

    ci90 = {}
    for f in FITTED_FAMILIES:
        if active_families and f in active_families:
            lo = percentile(boot_rates[f], 5)
            hi = percentile(boot_rates[f], 95)
            ci90[f] = [round(lo, 4), round(hi, 4)]
        else:
            ci90[f] = [0.0, 0.0]

    return rates, ci90, r2, boot_samples, thin, k


def probe_window(start_str, end_str, readings, meter_field, replies, fit_rates, boot_samples, slug_filter=None):
    start_dt = parse_ts(start_str)
    end_dt = parse_ts(end_str)
    start_ts = start_dt.timestamp()
    end_ts = end_dt.timestamp()

    valid_readings = [r for r in readings if r.get(meter_field) is not None]
    if not valid_readings:
        observed = 0.0
    else:
        li_cands = [i for i in range(len(valid_readings) - 1, -1, -1) if valid_readings[i]["epoch"] <= start_ts]
        li = li_cands[0] if li_cands else 0
        ri_cands = [i for i in range(len(valid_readings)) if valid_readings[i]["epoch"] >= end_ts]
        ri = ri_cands[0] if ri_cands else len(valid_readings) - 1
        window = valid_readings[li:ri + 1]
        observed = 0.0
        for a, b in zip(window, window[1:]):
            d = b[meter_field] - a[meter_field]
            if d > 0:
                observed += d
    observed = round(observed, 2)

    all_reply_list = list(replies.values())
    span_replies = [r for r in all_reply_list if start_ts <= r[5] <= end_ts]

    all_spend = {f: 0.0 for f in FITTED_FAMILIES}
    for r in span_replies:
        f = family(r[3])
        if f in all_spend:
            all_spend[f] += weigh(r[4])
    all_spend_M = {f: round(all_spend[f] / 1e6, 2) for f in FITTED_FAMILIES}
    all_est = sum((all_spend[f] / 1e6) * fit_rates[f] for f in FITTED_FAMILIES)

    all_sample_ests = [
        sum((all_spend[f] / 1e6) * s[f] for f in FITTED_FAMILIES)
        for s in boot_samples
    ]
    all_ci90 = [
        round(percentile(all_sample_ests, 5), 2),
        round(percentile(all_sample_ests, 95), 2),
    ]

    all_dict = {
        "spend_M": all_spend_M,
        "estimate_total": round(all_est, 2),
        "ci90": all_ci90,
    }

    probe_result = {
        "start": start_str,
        "end": end_str,
        "observed": observed,
        "all": all_dict,
        "unexplained": round(observed - all_est, 2),
    }

    if slug_filter:
        run_replies = [r for r in span_replies if r[0] in slug_filter]
        run_spend = {f: 0.0 for f in FITTED_FAMILIES}
        for r in run_replies:
            f = family(r[3])
            if f in run_spend:
                run_spend[f] += weigh(r[4])
        run_spend_M = {f: round(run_spend[f] / 1e6, 2) for f in FITTED_FAMILIES}
        run_est = sum((run_spend[f] / 1e6) * fit_rates[f] for f in FITTED_FAMILIES)
        run_sample_ests = [
            sum((run_spend[f] / 1e6) * s[f] for f in FITTED_FAMILIES)
            for s in boot_samples
        ]
        run_ci90 = [
            round(percentile(run_sample_ests, 5), 2),
            round(percentile(run_sample_ests, 95), 2),
        ]
        probe_result["run"] = {
            "spend_M": run_spend_M,
            "estimate_total": round(run_est, 2),
            "ci90": run_ci90,
        }

    return probe_result


def meter_points(readings, x, y):
    # Segment sum between the window edges: a drop between consecutive readings is a
    # meter reset inside the window, so it contributes 0, not a negative delta.
    li = next((i for i in range(len(readings) - 1, -1, -1) if readings[i]["epoch"] <= x), 0)
    ri = next((i for i in range(len(readings)) if readings[i]["epoch"] >= y), len(readings) - 1)
    window = readings[li:ri + 1]
    weekly_delta = five_hour_delta = 0.0
    resets = {"weekly": 0, "five_hour": 0}
    five_hour_ok = True
    for a, b in zip(window, window[1:]):
        d = b["weekly_pct"] - a["weekly_pct"]
        if d > 0:
            weekly_delta += d
        elif d < -0.5:
            resets["weekly"] += 1
        if a["five_hour_pct"] is None or b["five_hour_pct"] is None:
            five_hour_ok = False
            continue
        d = b["five_hour_pct"] - a["five_hour_pct"]
        if d > 0:
            five_hour_delta += d
        elif d < -0.5:
            resets["five_hour"] += 1
    left, right = readings[li], readings[ri]
    return {
        "readings_used": len(window),
        "weekly_delta": weekly_delta,
        "five_hour_delta": five_hour_delta,
        "resets_inside": resets,
        "five_hour_usable": five_hour_ok and resets["five_hour"] == 0,
        "edge_left": {"epoch": left["epoch"], "distance_s": abs(left["epoch"] - x),
                      "extrapolated": left["epoch"] > x},
        "edge_right": {"epoch": right["epoch"], "distance_s": abs(right["epoch"] - y),
                       "extrapolated": right["epoch"] < y},
    }


def files(root, slugs):
    for proj in sorted(p for p in root.iterdir() if p.is_dir()):
        if slugs and proj.name not in slugs:
            continue
        for f in proj.rglob("*.jsonl"):
            if "mined-corpus" in f.parts:
                continue
            yield proj.name, ("subagent" if "subagents" in f.parts else "main"), f


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since", help="ISO timestamp (UTC if no offset); default: start of the weekly window")
    ap.add_argument("--until", help="ISO timestamp (UTC if no offset); default: now")
    ap.add_argument("--slug", action="append", default=[], help="project folder name under ~/.claude/projects")
    ap.add_argument("--points", action="store_true",
                    help="convert each folder's share of the window into meter points from claude-usage's readings log; unbilled-family (non-Anthropic) weight is excluded from the split")
    ap.add_argument("--by-session", action="store_true",
                    help="attribute usage per session (slug/session) instead of per folder")
    ap.add_argument("--fit", action="store_true",
                    help="fit per-model meter rates (pts/M) via NNLS over tick intervals")
    ap.add_argument("--probe", nargs=2, metavar=("START", "END"),
                    help="compare observed meter ticks vs fitted spend estimate in [START, END] (implies --fit)")
    ap.add_argument("--meter", choices=["5h", "week"], default="5h",
                    help="meter to fit (5h or week; default: 5h)")
    ap.add_argument("--max-gap", type=int, default=180,
                    help="max tick bracket width in seconds for a precise tick (default: 180)")
    ap.add_argument("--max-span", type=int, default=18000,
                    help="max interval span in seconds (default: 18000)")
    ap.add_argument("--boot", type=int, default=1000,
                    help="bootstrap resamples for CI (default: 1000)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-dedupe", action="store_true")
    # Every slug starts with "-", which argparse reads as an option; join "--slug X" into "--slug=X".
    argv, rest = [], sys.argv[1:]
    while rest:
        arg = rest.pop(0)
        argv.append(f"--slug={rest.pop(0)}" if arg == "--slug" and rest else arg)
    a = ap.parse_args(argv)

    if a.probe:
        a.fit = True
    if a.boot < 1:
        sys.exit("usage-sweep: --boot must be at least 1")

    m = meter()
    assumed_window = False
    if a.since:
        since = parse_ts(a.since)
    elif m and m.get("weekly_resets_at"):
        since = datetime.fromtimestamp(m["weekly_resets_at"], timezone.utc) - timedelta(days=7)
        assumed_window = True
    else:
        sys.exit("usage-sweep: no --since given and claude-usage --json gave no weekly_resets_at")
    until = parse_ts(a.until) if a.until else datetime.now(timezone.utc)

    root = Path(os.environ.get("CLAUDE_PROJECTS_DIR", Path.home() / ".claude/projects"))
    if not root.is_dir():
        sys.exit(f"usage-sweep: {root} is not a directory")
    unknown = [s for s in a.slug if not (root / s).is_dir()]
    if unknown:
        sys.exit(f"usage-sweep: no such project folder under {root}: {' '.join(unknown)}")

    slug_set = set(a.slug)
    replies = {}
    report_replies = {}
    lines = files_read = skipped = anon = 0

    since_ts = since.timestamp()
    until_ts = until.timestamp()
    sweep_since_ts = since_ts
    sweep_until_ts = until_ts
    if a.probe:
        p_start_ts = parse_ts(a.probe[0]).timestamp()
        p_end_ts = parse_ts(a.probe[1]).timestamp()
        sweep_since_ts = min(since_ts, min(p_start_ts, p_end_ts))
        sweep_until_ts = max(until_ts, max(p_start_ts, p_end_ts))

    # The meter is global, so --fit sweeps every folder; --slug then filters only the report.
    for slug, scope, f in files(root, set() if a.fit else slug_set):
        is_report_folder = (not slug_set or slug in slug_set)
        if is_report_folder:
            files_read += 1
        rel = f.relative_to(root / slug)
        # A session is the first path segment under the project folder: s1.jsonl is
        # s1, anything under s1/subagents/ is also s1.
        session = rel.parts[0] if len(rel.parts) > 1 else rel.stem
        with open(f, errors="replace") as fh:
            for raw in fh:
                if '"usage"' not in raw:
                    continue
                try:
                    e = json.loads(raw)
                except ValueError:
                    if is_report_folder:
                        skipped += 1  # a live session's half-written last line
                    continue
                msg = e.get("message") or {}
                u = msg.get("usage")
                if e.get("type") != "assistant" or not u or not e.get("timestamp"):
                    continue
                ts_dt = parse_ts(e["timestamp"])
                rep_epoch = ts_dt.timestamp()
                if not (sweep_since_ts <= rep_epoch <= sweep_until_ts):
                    continue
                in_report_window = since_ts < rep_epoch < until_ts  # strict, as the report always was
                if is_report_folder and in_report_window:
                    lines += 1
                if a.no_dedupe or not msg.get("id"):
                    anon += 1
                    key = ("line", anon)
                else:
                    key = (msg.get("id"), e.get("requestId"))
                usage = {k: u.get(k) or 0 for k in USAGE_FIELDS}  # only the counted fields, to keep RAM small
                prev = replies.get(key)
                if prev is None or usage["output_tokens"] > prev[4]["output_tokens"]:
                    replies[key] = (slug, scope, session, msg.get("model") or "?", usage, rep_epoch)

                if is_report_folder and in_report_window:
                    prev_rep = report_replies.get(key)
                    if prev_rep is None or usage["output_tokens"] > prev_rep[4]["output_tokens"]:
                        report_replies[key] = (slug, scope, session, msg.get("model") or "?", usage, rep_epoch)

                # Advisor-tool sub-inference rides usage.iterations[] (type
                # "advisor_message"), each entry with its own model and token
                # fields; the top-level usage above covers the executor only.
                for idx, it in enumerate(u.get("iterations") or []):
                    if not isinstance(it, dict) or it.get("type") != "advisor_message":
                        continue
                    it_key = (*key, idx)
                    it_usage = {k: it.get(k) or 0 for k in USAGE_FIELDS}
                    prev_it = replies.get(it_key)
                    if prev_it is None or it_usage["output_tokens"] > prev_it[4]["output_tokens"]:
                        replies[it_key] = (slug, scope, session, it.get("model") or "?", it_usage, rep_epoch)
                    if is_report_folder and in_report_window:
                        prev_it_rep = report_replies.get(it_key)
                        if prev_it_rep is None or it_usage["output_tokens"] > prev_it_rep[4]["output_tokens"]:
                            report_replies[it_key] = (slug, scope, session, it.get("model") or "?", it_usage, rep_epoch)

    by_model = defaultdict(lambda: defaultdict(float))
    by_slug = defaultdict(float)
    by_scope = defaultdict(float)
    by_session = defaultdict(float)
    by_slug_billed = defaultdict(float)
    by_session_billed = defaultdict(float)
    for slug, scope, session, model, u, epoch in report_replies.values():
        w = weigh(u)
        d = by_model[model]
        d["weighted"] += w
        d["msgs"] += 1
        d["output"] += u.get("output_tokens") or 0
        d["cache_read_w"] += (u.get("cache_read_input_tokens") or 0) * WEIGHTS["cache_read"]
        by_slug[folder_label(slug)] += w
        by_scope[scope] += w
        if a.by_session:
            by_session[f"{folder_label(slug)}/{session}"] += w
        if family(model) != "unbilled":
            by_slug_billed[folder_label(slug)] += w
            if a.by_session:
                by_session_billed[f"{folder_label(slug)}/{session}"] += w

    total = sum(d["weighted"] for d in by_model.values())
    # Unbilled-family tokens (non-Anthropic lanes) do not move the Anthropic
    # meter, so they must not dilute the meter-point split.
    billed_total = sum(d["weighted"] for m, d in by_model.items() if family(m) != "unbilled")

    points = None
    readings = None
    readings_skipped = 0
    if a.points or a.fit:
        rlog = readings_log_path()
        readings, readings_skipped = read_readings(rlog)
        if not readings:
            sys.exit(f"usage-sweep: no usable readings in {rlog} — meter points need the readings log that claude-usage appends on cache refresh")

    if a.points:
        points = meter_points(readings, int(since.timestamp()), int(until.timestamp()))
        points["readings_skipped"] = readings_skipped
        points["by_slug"] = {k: round(by_slug_billed.get(k, 0.0) / billed_total * points["weekly_delta"], 2)
                             if billed_total else 0.0
                             for k, w in by_slug.items()}
        if a.by_session:
            points["by_session"] = {k: round(by_session_billed.get(k, 0.0) / billed_total * points["weekly_delta"], 2)
                                    if billed_total else 0.0
                                    for k, w in by_session.items()}
        points["by_model"] = {k: round(v["weighted"] / billed_total * points["weekly_delta"], 2)
                              if billed_total and family(k) != "unbilled" else 0.0
                              for k, v in by_model.items()}
        if total > billed_total:
            pct = round((total - billed_total) / total * 100, 1) if total else 0.0
            print(f"usage-sweep: {pct}% of window weight is unbilled-family or unknown-model tokens, excluded from meter points", file=sys.stderr)

    fit_obj = None
    probe_obj = None
    fit_k = None
    if a.fit:
        meter_field = "five_hour_pct" if a.meter == "5h" else "weekly_pct"
        intervals, ticks_total, ticks_precise = extract_ticks_and_intervals(
            readings, replies, meter_field, a.max_gap, a.max_span, since_ts, until_ts
        )
        rates, ci90, r2, boot_samples, thin, fit_k = fit_meter_rates(intervals, boot_n=a.boot)

        all_reply_list = list(replies.values())
        window_replies = [r for r in all_reply_list if since_ts < r[5] < until_ts]
        unbilled_weighted = sum(weigh(r[4]) for r in window_replies if family(r[3]) == "unbilled")
        unbilled_M = round(unbilled_weighted / 1e6, 2)
        window_spend_M = {
            f: round(sum(weigh(r[4]) for r in window_replies if family(r[3]) == f) / 1e6, 2)
            for f in FITTED_FAMILIES
        }
        fitted_spend_M = {
            f: round(sum(iv["spend_M"][f] for iv in intervals), 2)
            for f in FITTED_FAMILIES
        }

        families_report = {}
        for f in FITTED_FAMILIES:
            r_val = rates[f]
            families_report[f] = {
                "pts_per_M": round(r_val, 4),
                "M_per_pt": round(1.0 / r_val, 2) if r_val > 0 else None,
                "ci90": ci90[f],
                "spend_M": fitted_spend_M[f],
                "window_spend_M": window_spend_M[f],
            }

        fit_obj = {
            "meter": a.meter,
            "intervals": len(intervals),
            "ticks_total": ticks_total,
            "ticks_precise": ticks_precise,
            "thin": thin,
            "families": fit_k,
            "r2": r2,
            "unbilled_M": unbilled_M,
            "max_gap": a.max_gap,
            "max_span": a.max_span,
            "by_family": families_report,
        }

        if a.probe:
            probe_obj = probe_window(
                a.probe[0], a.probe[1], readings, meter_field, replies, rates, boot_samples, slug_filter=slug_set
            )

    result = {
        "since": since.isoformat(),
        "dedupe": not a.no_dedupe,
        "files": files_read,
        "usage_lines": lines,
        "messages_counted": int(sum(d["msgs"] for d in by_model.values())),
        "unparseable_lines": skipped,
        "total_weighted": round(total),
        "by_model": {k: {kk: round(vv) for kk, vv in v.items()} for k, v in by_model.items()},
        "by_slug": {k: round(v) for k, v in by_slug.items()},
        "main_weighted": round(by_scope["main"]),
        "subagent_weighted": round(by_scope["subagent"]),
        "meter": m,
        "window_assumed": assumed_window,
    }
    if points is not None:
        result["points"] = points
    if fit_obj is not None:
        result["fit"] = fit_obj
    if probe_obj is not None:
        result["probe"] = probe_obj
    if a.json:
        print(json.dumps(result, indent=2))
        return

    M = 1e6
    print(f"window: since {since:%Y-%m-%d %H:%M}Z  ({files_read} files, {result['messages_counted']} messages"
          f" from {lines} usage lines{'' if a.no_dedupe else ', one count per reply'})")
    print("\nby model:")
    for k, v in sorted(by_model.items(), key=lambda kv: -kv[1]["weighted"]):
        cr = 100 * v["cache_read_w"] / v["weighted"] if v["weighted"] else 0
        print(f"  {k:<32} {v['weighted'] / M:9.1f}M  msgs {int(v['msgs']):6d}  cache-read {cr:3.0f}%")
    print("\nby project folder:")
    for k, v in sorted(by_slug.items(), key=lambda kv: -kv[1]):
        print(f"  {k:<48} {v / M:9.1f}M")
    sub = 100 * by_scope["subagent"] / total if total else 0
    print(f"\nmain loop {by_scope['main'] / M:.1f}M · subagents {by_scope['subagent'] / M:.1f}M"
          f" (delegation {sub:.0f}%)")
    print(f"TOTAL weighted {total / M:.1f}M")
    if m:
        print(f"meter: weekly {m.get('weekly_pct')}% · {m.get('scoped') or 'no per-model cap'}"
              f" · 5h {m.get('five_hour_pct')}%")
        if m.get("weekly_pct"):
            print(f"implied weekly capacity (our weights): {total / (m['weekly_pct'] / 100) / M:.0f}M"
                  " (valid only when --since is the window start)")
    if assumed_window:
        print("window assumed = weekly reset - 7 days; an applied mid-week reset moves the start (pass --since)")
    if skipped:
        print(f"note: {skipped} unparseable line(s) skipped")
    if points is not None:
        print(f"\nmeter points: weekly {points['weekly_delta']:+.1f} pts"
              f" ({points['readings_used']} readings, {points['readings_skipped']} skipped)")
        for k, v in sorted(points["by_slug"].items(), key=lambda kv: -kv[1]):
            share = 100 * by_slug_billed.get(k, 0.0) / billed_total if billed_total else 0
            print(f"  {k:<48} {share:5.1f}% / {v:6.2f} pts")
        if a.by_session:
            for k, v in sorted(points["by_session"].items(), key=lambda kv: -kv[1]):
                print(f"  {k:<48} {v:6.2f} pts")
        print("  by model: (equal-rate shares; --fit gives per-model rates)")
        for k, v in sorted(points["by_model"].items(), key=lambda kv: -kv[1]):
            share = 100 * by_model[k]["weighted"] / billed_total if billed_total and family(k) != "unbilled" else 0
            print(f"    {k:<46} {share:5.1f}% / {v:6.2f} pts")
        el, er = points["edge_left"], points["edge_right"]
        if el["extrapolated"]:
            print("note: no reading at/before the window start; the first reading stands in for it")
        if er["extrapolated"]:
            print("note: no reading at/after the window end; the last reading stands in for it")
        if not points["five_hour_usable"]:
            print(f"note: five-hour delta {points['five_hour_delta']:+.1f} pts not usable"
                  f" ({points['resets_inside']['five_hour']} reset(s) inside the window)")
        dist = max(el["distance_s"], er["distance_s"])
        if dist > 7200:
            print(f"note: nearest reading is {dist // 60} min from the window edge; points are approximate")

    if fit_obj is not None:
        print(f"\nfit ({fit_obj['meter']} meter, {fit_obj['intervals']} intervals from {fit_obj['ticks_total']} ticks, {fit_obj['ticks_precise']} precise):")
        for fam in FITTED_FAMILIES:
            fdata = fit_obj["by_family"][fam]
            if fdata["spend_M"] > 0 or fdata["window_spend_M"] > 0 or fdata["pts_per_M"] > 0:
                rate = fdata["pts_per_M"]
                lo, hi = fdata["ci90"]
                m_str = f"{fdata['M_per_pt']:.1f}M" if fdata["M_per_pt"] is not None else "     -"
                print(f"  {fam:<8} {rate:6.2f} pts/M (90% {lo:.2f}..{hi:.2f})  = {m_str:>6} per pt   spend {fdata['spend_M']:5.1f}M (window {fdata['window_spend_M']:5.1f}M)")
        r2_val = fit_obj["r2"]
        print(f"r2 {r2_val:.4f}" if r2_val is not None else "r2 null")
        if fit_obj["thin"]:
            print(f"note: only {fit_obj['intervals']} intervals for {fit_k} families; rates and ranges are rough")
        print("note: spend the local logs can't see (cloud sessions, GitHub reviews) inflates the rates")

    if probe_obj is not None:
        print(f"\nprobe {probe_obj['start']} → {probe_obj['end']}:")
        print(f"  observed:    {probe_obj['observed']:+.1f} pts ({fit_obj['meter']} meter)")
        all_sp = sum(probe_obj['all']['spend_M'].values())
        print(f"  all:         {probe_obj['all']['estimate_total']:6.2f} pts (90% {probe_obj['all']['ci90'][0]:.2f}..{probe_obj['all']['ci90'][1]:.2f})  spend {all_sp:.1f}M")
        if "run" in probe_obj:
            run_sp = sum(probe_obj['run']['spend_M'].values())
            print(f"  run:         {probe_obj['run']['estimate_total']:6.2f} pts (90% {probe_obj['run']['ci90'][0]:.2f}..{probe_obj['run']['ci90'][1]:.2f})  spend {run_sp:.1f}M")
        print(f"  unexplained: {probe_obj['unexplained']:+.2f} pts")

    if a.slug and (a.fit or a.probe):
        print("note: --fit uses all project folders (ignoring --slug for the fit)")


if __name__ == "__main__":
    main()
