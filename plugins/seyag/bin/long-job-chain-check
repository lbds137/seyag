#!/usr/bin/env -S python3 -I -B
"""long-job-chain-check: find `long-job run` commands whose shell context would run work outside the job.
Probe: tests/long-job-chain-check.probe.sh.

Usage:
  long-job-chain-check TEXT        check a shell command text (one argument)
  long-job-chain-check --hook      read a Claude Code PreToolUse JSON object on stdin; check
                                   .tool_input.command (any other shape: silent exit 0; a config.toml warning may still reach stderr)

Findings (one line each, stdout; --hook prints only refusals, to stderr):
  refuse  a `&&` follows the pipeline holding `long-job run NAME`: the tail runs at once, outside the job.
          Plain mode exits 3; --hook exits 2 so Claude Code blocks the call.
  warn    a `||` follows it (runs only if the START fails), or a CLAUDE_/SYG_ variable is set on
          long-job's command line without a matching `--env NAME` (the job never sees it).
Also checks the runner named by the first word of SYG_LONG_JOB_CMD when set (the first word must be
the runner itself, not an interpreter such as `bash`), past leading prefix words (time, nice, nohup,
command, sudo, env, timeout, stdbuf) and their options/arguments.
Text that does not parse (unbalanced quotes) has no findings.
Heredoc bodies are data and come off before parsing (shell_quotes.strip_heredoc_bodies) — except
when a command in the body-stripped text runs a shell on its stdin (`cat <<EOF | bash`, `bash <<EOF`,
`sh -s <<EOF`): the body is that shell's script, so the text is parsed with bodies kept.
Recursion: the argument of `eval` is parsed as shell text (the Bash tool wraps commands in eval), and
so is the interior of every command/process substitution — $( ), <( ), >( ), backticks — together with
the unquoted text after it, since the $( ) waits only for the start (like `( … )&&b`, which refuses).
Interiors are located in the raw text by a quote-aware scanner, so single-quoted prose mentioning a
substitution (`echo '$(long-job run x -- a && b)'`, including the Bash tool's eval wrapper) is data,
not a target.
Not recursed: `bash -c` bodies (a chain inside them after `long-job run N --` is the correct form).
Eval join-and-reparse matches bash's own eval: measured `bash -c 'eval echo "a  &&  echo" B'` prints
a then B, exactly the join of eval's arguments with single spaces re-parsed. Inputs tried for a
divergence: `eval long-job run x -- a '\\&\\&' b` (measured: the escaped `&`s stay literal words through
eval's re-parse; the checker reads them the same way), and a folded substitution word — the token
fold joins interior tokens with no separators, so `$(a  b)` folds to a word whose interior reads
`ab)` and `eval $(long-job run x -- a && b)` used to reach the eval recursion as a non-command; the
substitution interiors are read from the raw text, so no verdict rides on the folded form. What does
differ (both then and now): the checker parses the substitution SOURCE, bash's eval re-parses its
OUTPUT — `eval $(echo "long-job run x -- a && b")` prints the text and bash then runs it, while the
checker sees only `echo`; output-to-code flow is out of this checker's model.
"""
import json
import os
import re
import shlex
import sys

# config.toml knobs (config_env, the Python twin of hooks/lib/config-env.sh); a wiring error proceeds env-only.
try:
    _SYG_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    sys.path.insert(0, os.path.join(_SYG_ROOT, "lib"))
    import config_env

    config_env.syg_config_env(_SYG_ROOT)
except Exception:
    pass

# hooks/lib/shell_quotes: heredoc bodies are data (stripped before parsing) and the
# reserved words that can lead a simple command. The path is inserted explicitly
# because python3 -I drops the script directory and every PYTHON* path; if the
# import fails the checker proceeds without stripping — quoted heredoc bodies are
# then parsed as commands, which over-arms (the accepted failure direction).
try:
    sys.path.insert(0, os.path.join(_SYG_ROOT, "hooks", "lib"))
    import shell_quotes as _sq

    _strip_heredoc_bodies = getattr(_sq, "strip_heredoc_bodies", None)
    _reads_script_from_stdin = getattr(_sq, "_reads_script_from_stdin", None)
except Exception:
    _sq = None
    _strip_heredoc_bodies = None
    _reads_script_from_stdin = None

REFUSE = ("{r}: refusing: '&& …' after '{r} run {n}' runs outside the job, at once, against "
          "the tree as it is now. Put the chain inside the job: {r} run {n} -- bash -c 'a && b' "
          "(or gate-run for a multi-step gate); a follow-up meant to run now goes after ';'.")
WARN_OR = ("{r}: warning: '|| …' after '{r} run {n}' runs only if the START fails, not the job; "
           "the job's result comes from {r} wait {n}.")
WARN_VAR = ("{r}: warning: {v} is set on {r}'s command line but the job never sees it; "
            "pass it with --env {v}.")

ASSIGN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
PREFIXED = re.compile(r"^(CLAUDE|SYG)_")
MAX_EVAL_DEPTH = 8
# Per prefix word: (options taking a separate argument, positional words consumed before the command).
PREFIX_WORDS = {
    "time": (("-f", "-o"), 0),
    "nice": (("-n",), 0),
    "nohup": ((), 0),
    "command": ((), 0),
    "sudo": (("-u", "-g", "-C", "-D", "-h", "-p", "-r", "-t", "-U"), 0),
    "env": (("-u", "-C", "-S"), 0),
    "timeout": (("-s", "-k"), 1),
    "stdbuf": (("-i", "-o", "-e"), 0),
}
PUNCT = "();<>|&\n"
OPS = ("&&", "||", "|&", ";;", "<(", ">(", ">>", "<<", ">&", "<&")
# Reserved words that can lead a simple command and hide argv[0] (`if long-job
# run N -- a && b; then :; fi`, `! long-job run N -- a && b`): the same set
# shell_quotes._LEADING_KEYWORDS strips, minus `time` — time stays for the
# PREFIX_WORDS loop in command_word(), which consumes its options (`time -f x`);
# a bare keyword run would leave `-f x` in front of the runner.
KEYWORDS = frozenset(
    ("!", "{", "}", "if", "then", "elif", "else", "while", "until", "do")
)
if _sq is not None and getattr(_sq, "_LEADING_KEYWORDS", None):
    KEYWORDS = frozenset(_sq._LEADING_KEYWORDS) - {"time"}
# Quoted punctuation is data (`long-job run x -- grep "&&" f`), but shlex's
# punctuation_chars lexer hands back the same token for a quoted "&&" as for an
# operator. Mask it before lexing: every punctuation character inside a quoted
# span becomes a private-use placeholder no operator test can match, while the
# quote characters themselves stay, so word gluing (`a'&&'b`) reads as bash
# reads it. The eval recursion reverses the mask, because bash's eval re-parses
# its arguments with the outer quotes gone.
_QMAP = {
    "&": "",
    "|": "",
    ";": "",
    "(": "",
    ")": "",
    "<": "",
    ">": "",
    "\n": "",
}
_QREV = {v: k for k, v in _QMAP.items()}


def _mask_quoted_ops(text):
    """`text` with every punctuation character inside a quoted span replaced by
    its _QMAP placeholder; unquoted text, escapes and quote marks untouched."""
    if "'" not in text and '"' not in text:
        return text
    out = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c == "\\":
            out.append(text[i:i + 2])
            i += 2
        elif c == "'":
            j = text.find("'", i + 1)
            if j == -1:
                out.append(text[i:])
                break
            out.append("".join(_QMAP.get(ch, ch) for ch in text[i:j + 1]))
            i = j + 1
        elif c == '"':
            j = i + 1
            while j < n:
                if text[j] == "\\":
                    j += 2
                elif text[j] == '"':
                    j += 1
                    break
                else:
                    j += 1
            out.append("".join(_QMAP.get(ch, ch) for ch in text[i:min(j, n)]))
            i = min(j, n)
        else:
            out.append(c)
            i += 1
    return "".join(out)


def _skip_single(text, i):
    """Index past the single-quoted span opening at i; the end when unterminated."""
    j = text.find("'", i + 1)
    return len(text) if j == -1 else j + 1


def _backtick_span(text, i):
    """(interior, index past the closing backtick) for the span opening at i-1;
    the rest of the text when unterminated."""
    start = i
    n = len(text)
    while i < n:
        c = text[i]
        if c == "\\":
            i += 2
        elif c == "`":
            return text[start:i], i + 1
        else:
            i += 1
    return text[start:], n


def _paren_span(text, i):
    """(interior, index past the matching close paren) for the substitution
    opening at i-1; the rest of the text when unterminated. Quoted spans are
    skipped whole, so a quoted `)` never closes the substitution."""
    depth = 1
    start = i
    n = len(text)
    while i < n:
        c = text[i]
        if c == "\\":
            i += 2
        elif c == "'":
            i = _skip_single(text, i)
        elif c == '"':
            _, i = _dquote_spans(text, i + 1)
        elif c == "`":
            _, i = _backtick_span(text, i + 1)
        elif c == "(":
            depth += 1
            i += 1
        elif c == ")":
            depth -= 1
            i += 1
            if depth == 0:
                return text[start:i - 1], i
        else:
            i += 1
    return text[start:], n


def _dquote_spans(text, i, names=()):
    """(span interiors with tails, index past the closing quote) found inside
    the double-quoted span starting at i; `$( )` and backticks stay live there,
    process substitution does not."""
    out = []
    n = len(text)
    while i < n:
        c = text[i]
        if c == "\\":
            i += 2
        elif c == '"':
            return out, i + 1
        elif c == "$" and text[i + 1:i + 2] == "(":
            interior, i = _paren_span(text, i + 2)
            out.append(_span(interior, text, i, True, names))
        elif c == "`":
            interior, i = _backtick_span(text, i + 1)
            out.append(_span(interior, text, i, True, names))
        else:
            i += 1
    return out, n


def _tail(text, i, in_dquote):
    """What bash still runs as shell syntax once a substitution closes: the raw
    text from i, with an enclosing double quote skipped to its close (its
    contents are an argument, not operators), other quoted spans masked, and
    escapes kept — the `$( )` waits only for the start, so an `&&` out here
    runs while the job does. Later substitutions collapse to one placeholder
    word, so a tail never holds a span and each span is checked once per
    nesting level."""
    out = []
    n = len(text)
    while i < n:
        c = text[i]
        if in_dquote:
            if c == "\\":
                i += 2
            elif c == '"':
                in_dquote = False
                i += 1
            else:
                i += 1
        elif c == "\\":
            out.append(text[i:i + 2])
            i += 2
        elif c == "'":
            j = text.find("'", i + 1)
            if j == -1:
                break
            out.append(" ")
            i = j + 1
        elif c == '"':
            j = i + 1
            while j < n:
                if text[j] == "\\":
                    j += 2
                elif text[j] == '"':
                    j += 1
                    break
                else:
                    j += 1
            out.append(_mask_quoted_ops(text[i:min(j, n)]))
            i = min(j, n)
        elif c in "$<>" and text[i + 1:i + 2] == "(":
            _, i = _paren_span(text, i + 2)
            out.append("_")
        elif c == "`":
            _, i = _backtick_span(text, i + 1)
            out.append("_")
        else:
            out.append(c)
            i += 1
    return "".join(out)


def _span(interior, text, i, in_dquote, names):
    """(interior, tail); the O(n) tail is built only when the interior names a
    runner, since only a runner call can be refused for what follows it."""
    if names_runner(interior, names):
        return interior, _tail(text, i, in_dquote)
    return interior, ""


def substitution_spans(text, names=()):
    """(interior, tail) for every substitution bash runs, in text order: $(),
    <(), >() and backticks, live outside single quotes and, for $() and
    backticks, inside double quotes. The tail is empty unless the interior
    contains one of `names`."""
    out = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c == "\\":
            i += 2
        elif c == "'":
            i = _skip_single(text, i)
        elif c == '"':
            spans, i = _dquote_spans(text, i + 1, names)
            out.extend(spans)
        elif c == "$" and text[i + 1:i + 2] == "(":
            interior, i = _paren_span(text, i + 2)
            out.append(_span(interior, text, i, False, names))
        elif c in "<>" and text[i + 1:i + 2] == "(":
            interior, i = _paren_span(text, i + 2)
            out.append(_span(interior, text, i, False, names))
        elif c == "`":
            interior, i = _backtick_span(text, i + 1)
            out.append(_span(interior, text, i, False, names))
        else:
            i += 1
    return out


def runner_names():
    names = {"long-job"}
    words = os.environ.get("SYG_LONG_JOB_CMD", "").split()
    if words:
        alias = words[0].rsplit("/", 1)[-1]
        if alias:
            names.add(alias)
    return names


def names_runner(text, names, _drop=str.maketrans("", "", "'\"\\")):
    """A runner name in text once quote and backslash characters are removed, so lo''ng-job (bash's long-job) still counts."""
    return any(r in text.translate(_drop) for r in names)


def tokens(text):
    # Quoted punctuation is masked first, so a quoted "&&" reaches the lexer as
    # placeholder characters inside the word, never as pure punctuation.
    # shlex with punctuation_chars="();<>|&\n" and whitespace_split=True keeps $, :, /, =, {, }
    # and similar inside words while splitting shell operators; a newline becomes its own token
    # (not whitespace) and comments are off, so `#` mid-word and `# ...` both stay visible.
    # Every all-punctuation token is then split into shell operators, longest match first from
    # OPS (&&, ||, |&, ;;, <(, >(, >>, <<, >&, <&), then single characters (so `)&&` becomes `)`
    # and `&&`; `;\n` becomes `;` and `\n`). Only unquoted punctuation can produce such a token:
    # shlex keeps quoted characters inside words regardless of punctuation_chars.
    # A backslash-newline is a line continuation, not a command break (wrong inside single quotes; rare).
    lex = shlex.shlex(_mask_quoted_ops(text.replace("\\\n", "")), posix=True, punctuation_chars=PUNCT)
    lex.whitespace = " \t\r"
    lex.commenters = ""
    lex.whitespace_split = True
    out = []
    for tok in lex:
        if len(tok) > 1 and all(c in PUNCT for c in tok):
            k = 0
            while k < len(tok):
                if tok[k:k + 2] in OPS:
                    out.append(tok[k:k + 2])
                    k += 2
                else:
                    out.append(tok[k])
                    k += 1
        else:
            out.append(tok)
    return out


def classify(tok):
    if tok == "&&":
        return "and"
    if tok == "||":
        return "or"
    if tok in ("|", "|&"):
        return "pipe"
    if tok in ("(", "{"):
        return "open"
    if tok in (")", "}"):
        return "close"
    if tok and all(c in "|&;\n" for c in tok):
        return "seq"  # ; ;; & ; newline
    if any(c in "<>" for c in tok):
        return "redir"
    return None


def items(text):
    """Yield ('op', kind), ('redir', None) or ('word', text); $( ), <( ) and backtick spans fold into one word."""
    toks = tokens(text)
    i, n = 0, len(toks)
    while i < n:
        t = toks[i]
        if t.endswith("$") and i + 1 < n and toks[i + 1] == "(":
            buf, depth, i = [t, "("], 1, i + 2
        elif t in ("<(", ">("):
            buf, depth, i = [t], 1, i + 1
        else:
            buf = None
        if buf is not None:
            while i < n and depth > 0:
                buf.append(toks[i])
                if toks[i] == "(":
                    depth += 1
                elif toks[i] == ")":
                    depth -= 1
                i += 1
            yield ("word", "".join(buf))
            continue
        if t.count("`") % 2 == 1:
            buf, i = [t], i + 1
            while i < n:
                buf.append(toks[i])
                i += 1
                if "`" in toks[i - 1]:
                    break
            yield ("word", "".join(buf))
            continue
        kind = classify(t)
        if kind in ("and", "or", "pipe", "open", "close", "seq"):
            yield ("op", kind)
        elif kind == "redir":
            yield ("redir", None)
        else:
            yield ("word", t)
        i += 1


def parse(text):
    """Return events: ('cmd', [words]) or ('op', kind)."""
    evs, words, skip = [], [], False

    def end_cmd():
        if words:
            evs.append(("cmd", list(words)))
            words.clear()

    for kind, val in items(text):
        if kind == "op":
            end_cmd()
            if val == "close":
                while evs and evs[-1] == ("op", "seq"):
                    evs.pop()
            evs.append(("op", val))
            skip = False
        elif kind == "redir":
            skip = True  # the redirect target is not a command word; a redirect does not end the command
        elif skip:
            skip = False
        else:
            words.append(val)
    end_cmd()
    return evs


def command_word(words):
    """Split a simple command into (assignments, argv), argv past any PREFIX_WORDS chain, its options/args, and env assignments."""
    # Leading reserved words first (`if long-job run N -- a && b; then :; fi`,
    # `! long-job run N -- a && b`, the `do` of a `for`/`while`/`until` body):
    # they precede any assignment a command could carry.
    while words and words[0] in KEYWORDS:
        words = words[1:]
    k = 0
    while k < len(words) and ASSIGN.match(words[k]):
        k += 1
    assigns, argv = words[:k], words[k:]
    # exec is not a prefix here: nothing after it runs, so its tail can't run outside the job.
    while argv and argv[0] in PREFIX_WORDS:
        prefix = argv[0]
        arg_opts, pos = PREFIX_WORDS[prefix]
        argv = argv[1:]
        while argv and argv[0].startswith("-"):
            opt = argv[0]
            argv = argv[1:]
            if opt == "--":
                break
            if opt in arg_opts and argv:
                argv = argv[1:]
        if prefix == "env":
            while argv and ASSIGN.match(argv[0]):
                assigns.append(argv[0])
                argv = argv[1:]
        argv = argv[pos:]
    return assigns, argv


def terminator(evs, i):
    """The operator that ends the pipeline holding evs[i], skipping pipes and the rest of an enclosing group."""
    depth = 0
    for kind, val in evs[i + 1:]:
        if kind == "cmd":
            continue
        if val == "open":
            depth += 1
        elif val == "close":
            if depth:
                depth -= 1
        elif depth == 0 and val in ("and", "or", "seq"):
            return val
    return None


def _dedup(findings):
    seen, out = set(), []
    for f in findings:
        if f not in seen:
            seen.add(f)
            out.append(f)
    return out


def check(text, depth=0):
    """Return a list of (level, message); level is 'refuse' or 'warn'. Unparseable text gives [].

    Cost: text naming no runner returns at once, and only a substitution whose
    interior names the runner is re-checked (with its tail), so each such span
    costs O(n). Nesting past MAX_EVAL_DEPTH is not checked; it fails open."""
    if depth > MAX_EVAL_DEPTH:
        return []
    runners = runner_names()
    if not names_runner(text, runners):
        return []
    # A heredoc BODY is data (quoted delimiter) or an accepted under-arm
    # (unquoted delimiter): strip it before parsing, except when a command in
    # the stripped text reads its script from stdin — then the body is that
    # shell's code and the text parses with bodies kept. An import failure
    # keeps the text whole, which over-arms.
    stripped = text
    if _strip_heredoc_bodies is not None:
        try:
            stripped = _strip_heredoc_bodies(text)
        except Exception:
            stripped = text
    src = stripped
    try:
        evs = parse(stripped)
    except ValueError:
        return []
    if stripped != text and _reads_script_from_stdin is not None and any(
        _reads_script_from_stdin(words) for kind, words in evs if kind == "cmd"
    ):
        try:
            evs = parse(text)
            src = text
        except ValueError:
            return []
    findings = []
    for i, (kind, val) in enumerate(evs):
        if kind != "cmd":
            continue
        assigns, argv = command_word(val)
        if argv and argv[0] == "eval" and depth < MAX_EVAL_DEPTH:
            # The eval argument is shell text of its own; the operators around the eval do not apply inside it.
            # bash re-parses the args with the outer quotes gone, so masked
            # punctuation comes back as the operators it was.
            arg = " ".join(argv[1:])
            findings += check("".join(_QREV.get(c, c) for c in arg), depth + 1)
            continue
        if not argv or len(argv) < 2 or argv[1] != "run":
            continue
        runner = argv[0].rsplit("/", 1)[-1]
        if runner not in runners:
            continue
        name = "".join(_QREV.get(c, c) for c in argv[2]) if len(argv) > 2 else "?"
        envs = set()
        j = 3
        while j < len(argv) and argv[j] != "--":
            if argv[j] == "--env" and j + 1 < len(argv):
                envs.add(argv[j + 1])
                j += 1
            j += 1
        for a in assigns:
            var = a.split("=", 1)[0]
            if PREFIXED.match(var) and var not in envs:
                findings.append(("warn", WARN_VAR.format(r=runner, v=var)))
        term = terminator(evs, i)
        if term == "and":
            findings.append(("refuse", REFUSE.format(r=runner, n=name)))
        elif term == "or":
            findings.append(("warn", WARN_OR.format(r=runner, n=name)))
    # Every substitution bash runs is shell text of its own, plus whatever
    # unquoted operators follow it: the $( ) waits only for the start.
    if depth < MAX_EVAL_DEPTH:
        for interior, tail in substitution_spans(src, runners):
            if names_runner(interior, runners):
                findings += check(interior + tail, depth + 1)
    return _dedup(findings)


def main(argv):
    if len(argv) == 2 and argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if len(argv) == 2 and argv[1] == "--hook":
        try:
            data = json.load(sys.stdin)
        except ValueError:
            return 0
        if not isinstance(data, dict) or not isinstance(data.get("tool_input"), dict):
            return 0
        cmd = data["tool_input"].get("command")
        if not isinstance(cmd, str):
            return 0
        refusals = [m for level, m in check(cmd) if level == "refuse"]
        if refusals:
            print("\n".join(refusals), file=sys.stderr)
            return 2
        return 0
    if len(argv) != 2:
        print("usage: long-job-chain-check TEXT | --hook", file=sys.stderr)
        return 2
    findings = check(argv[1])
    for _, m in findings:
        print(m)
    return 3 if any(level == "refuse" for level, _ in findings) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
