#!/usr/bin/env python3
"""zai-usage: the z.ai coding-plan quota percentages, live from z.ai's quota API.

The quota API is GET https://api.z.ai/api/monitor/usage/quota/limit with a bearer token (the
z.ai key, see zai_token): TOKENS_LIMIT entries give the 5h (number==5) and
weekly (unit==6) utilization percentages plus rolling nextResetTime. This is account truth —
the meter polls it (120s TTL, lock, background refresh for the statusline) and prints
Anthropic-style percentages. When the API is unreachable it falls back to the local transcript
scan (weighted-invocation model: GLM-5.3 1x/3x off/peak, flash 0.4x/1.2x, peak Mon-Fri
14:00-18:00 UTC+8; optional console anchors via --calibrate) and tags the line "local est" —
a floor, never confused with account truth.

  zai-usage                refresh if stale (API first), then print the one-line summary
  zai-usage --line         same line, refresh in the background when stale (statusline mode)
  zai-usage --json         full cache: pcts, resets, source; + local scan numbers when fallback
  zai-usage --sweep        force a refresh; silent
  zai-usage --models       per-model token totals for the last 7 days (monitor API)
  zai-usage --calibrate W [F] [--reset "YYYY-MM-DD HH:MM"]
                           offline mode: anchor the LOCAL scan to console readings

Scope: machine-local by design — usage figures stay off every repo. The token is read from
~/.claude/settings.json and sent by stdin, never argv, never printed.
"""

import calendar
import glob
import json
import os
import sys
import tempfile
import time
from fcntl import LOCK_EX, LOCK_NB, LOCK_UN, flock

# The state dir keeps the tool's old name (zai-spend): it holds the --calibrate anchors, which a
# rename would drop. The cache is regenerable, so it follows the new name.
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                     "zai-spend", "state.json")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
                     "claude-statusline", "zai-usage.json")
PROJECTS = os.environ.get("ZAI_SPEND_PROJECTS") or os.path.expanduser("~/.claude/projects")
QUOTA_URL = os.environ.get("ZAI_SPEND_QUOTA_URL", "https://api.z.ai/api/monitor/usage/quota/limit")
MODELS_URL = os.environ.get("ZAI_SPEND_MODELS_URL", "https://api.z.ai/api/monitor/usage/model-usage")
TTL = 120
SWEEP_LOCK = os.path.join(os.path.dirname(STATE), ".sweep.lock")
STATE_VERSION = 4
ROUTING_EPOCH = 1789900000  # the z.ai routing flip: readings before this stay local-est
TOK_FIELDS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")
# Weight table (main = glm-5.3 family, flash = glm-5.3-flash), from the plan's usage-revision
# notice. The peak window is matched in UTC+8 (hour and weekday both Beijing-side); it is
# overridable for tests (test mode skips the weekday gate).
W = {"main": (1.0, 3.0), "flash": (0.4, 1.2)}  # (off-peak, peak)
PEAK_UTC = os.environ.get("ZAI_SPEND_PEAK_UTC", "14-18")


def is_peak(epoch):
    try:
        a, b = (int(x) for x in PEAK_UTC.split("-"))
    except ValueError:
        return False
    if a == b:  # "0-0": never peak
        return False
    g = time.gmtime(epoch + 8 * 3600)  # the window is UTC+8 wall-clock time
    h = g.tm_hour
    if not (a <= h < b or (a > b and (h >= a or h < b))):
        return False
    # A non-default window is a test override: skip the weekday gate so fixtures are day-agnostic.
    return g.tm_wday < 5 or PEAK_UTC != "14-18"


def scan_file(path, offset, hours, glm_seen):
    """Read transcript lines from byte `offset`; fold glm usage into `hours` (hour -> bucket);
    return (new_offset, glm_seen). Buckets: {"i5","if","t5","tf","p"} — invocations and token
    sums per model family, prompts (string-content user lines, counted only after the
    session's first glm reply)."""
    try:
        with open(path, "rb") as f:
            f.seek(offset)
            buf = f.read()
    except OSError:
        return offset, glm_seen
    pos = 0
    for raw in buf.split(b"\n")[:-1]:  # a trailing partial line waits for its newline
        pos += len(raw) + 1
        try:
            ev = json.loads(raw)
        except ValueError:
            continue
        ts = ev.get("timestamp")
        if not isinstance(ts, str) or len(ts) < 19:
            continue
        try:  # timestamps are UTC; timegm reads the wall clock as UTC (mktime would apply DST)
            epoch = calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
        except ValueError:
            continue
        msg = ev.get("message") or {}
        if ev.get("type") == "assistant":
            model = msg.get("model") or ""
            if not model.startswith("glm"):
                continue
            glm_seen = True
            u = msg.get("usage") or {}
            toks = sum(u.get(k) or 0 for k in TOK_FIELDS)
            # thinking_tokens reads 0 while thinking arrives as blocks on this endpoint: output
            # may exclude it. Add only when it cannot already be inside output_tokens.
            th = (u.get("output_tokens_details") or {}).get("thinking_tokens") or 0
            if th > (u.get("output_tokens") or 0):
                toks += th
            b = hours.setdefault(epoch // 3600, {"i5": 0, "if": 0, "t5": 0, "tf": 0, "p": 0})
            if model.startswith("glm-5.3-flash"):
                b["if"] += 1
                b["tf"] += toks
            else:
                b["i5"] += 1
                b["t5"] += toks
        elif ev.get("type") == "user" and glm_seen:
            if isinstance(msg.get("content"), str):  # a real prompt; tool results arrive as arrays
                hours.setdefault(epoch // 3600, {"i5": 0, "if": 0, "t5": 0, "tf": 0, "p": 0})["p"] += 1
    return offset + pos, glm_seen


def bucket_weighted(b, epoch):
    """Quota-weighted invocations + raw weighted tokens for one hour bucket."""
    peak = is_peak(epoch * 3600)
    wm = W["main"][1] if peak else W["main"][0]
    wf = W["flash"][1] if peak else W["flash"][0]
    return b["i5"] * wm + b["if"] * wf, b["t5"] * wm + b["tf"] * wf


def sweep(state):
    """Bring state up to date with the transcripts on disk; write cache + state; return cache."""
    if state.get("v") != STATE_VERSION:  # older bucket shapes: wipe and rescan (~15 s cold)
        old, state = state, {"v": STATE_VERSION, "files": {}}
        for k in ("calW", "cal5", "reset_at"):  # calibration survives format bumps (weights don't)
            if old.get(k):
                state[k] = old[k]
        try:
            os.remove(CACHE)
        except OSError:
            pass
    files = state["files"]
    for entry in files.values():
        # JSON round-trips int hour keys as strings; re-int BEFORE scanning or the scanner's
        # int setdefault duplicates each key and the file's last-wins reload loses hours
        # (a past regression ate readings twice here — keep the normalization).
        entry["hours"] = {int(h): v for h, v in entry["hours"].items()}
    existing = set(glob.glob(os.path.join(PROJECTS, "**", "*.jsonl"), recursive=True))
    for path in list(files):  # deleted or archived: its contribution goes with it
        if path not in existing:
            del files[path]
    for path in sorted(existing):
        entry = files.setdefault(path, {"offset": 0, "glm": False, "hours": {}})
        try:
            st = os.stat(path)
        except OSError:
            continue
        if entry["offset"] == 0 and st.st_size > 0 and st.st_mtime < ROUTING_EPOCH:
            entry["offset"] = st.st_size  # untouched since before the routing: no glm inside
            continue
        if st.st_size < entry["offset"]:  # truncated or replaced: rescan whole
            entry["offset"], entry["hours"], entry["glm"] = 0, {}, False
        entry["offset"], entry["glm"] = scan_file(path, entry["offset"], entry["hours"], entry["glm"])
    cutoff = (time.time() - 8 * 86400) // 3600  # keep 8 days: the 7d window plus slack
    for entry in files.values():
        for h in [h for h in entry["hours"] if int(h) < cutoff]:
            del entry["hours"][h]

    now = time.time()
    win = {k: {"w": 0.0, "t": 0, "i": 0, "p": 0} for k in ("five_hour", "week")}
    for entry in files.values():
        for h, b in entry["hours"].items():
            age = now - int(h) * 3600
            w, t = bucket_weighted(b, int(h))
            for name, limit in (("five_hour", 6 * 3600), ("week", 7 * 86400 + 3600)):
                if age < limit:  # buckets that can overlap the window (hour-approximate)
                    win[name]["w"] += w
                    win[name]["t"] += t
                    win[name]["i"] += b["i5"] + b["if"]
                    win[name]["p"] += b["p"]
    out = {"as_of": int(now), "files": len(files), "week_reset_at": state.get("reset_at", 0)}
    for name in win:
        out[f"{name}_winv"] = round(win[name]["w"], 1)
        out[f"{name}_wtok"] = round(win[name]["t"] / 1e6, 1)
        out[f"{name}_inv"] = win[name]["i"]
        out[f"{name}_prompts"] = win[name]["p"]
    # Percentages: the console anchor converts weighted invocations into an implied cap.
    for cal_key, win_key, out_key in (("calW", "week", "week_pct"), ("cal5", "five_hour", "five_hour_pct")):
        cal = state.get(cal_key)
        if cal and cal.get("winv"):
            out[out_key] = round(win[win_key]["w"] * 100 / (cal["winv"] * 100.0 / cal["pct"]))
    out["anchors"] = {k: {"pct": state[k]["pct"], "at": state[k]["at"]}
                      for k in ("calW", "cal5") if state.get(k)}
    write_json(CACHE, out)
    write_json(STATE, state)
    return out


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def stale():
    try:
        return time.time() - os.path.getmtime(CACHE) > TTL
    except OSError:
        return True


def _routes_to_zai(base_url):
    from urllib.parse import urlparse
    host = urlparse(base_url or "").hostname or ""
    return host == "z.ai" or host.endswith(".z.ai")


def zai_token():
    """The z.ai key, never another lane's: the lane key file's ZAI_AUTH_TOKEN first (set whether the global
    route or a per-session overlay is on z.ai), then the calling session's env, then settings.json,
    each of the last two only when its base URL is z.ai (an OpenRouter key must not go to z.ai)."""
    keys = os.environ.get("CC_ROUTE_KEYS") or os.path.expanduser("~/.claude/lane-keys.env")
    try:
        with open(keys) as f:
            for line in f:
                if line.startswith("ZAI_AUTH_TOKEN="):
                    tok = line.split("=", 1)[1].strip().strip('"')
                    if tok and not tok.startswith("PASTE-"):  # the template's PASTE- placeholder
                        return tok
    except OSError:
        pass
    if _routes_to_zai(os.environ.get("ANTHROPIC_BASE_URL")) and os.environ.get("ANTHROPIC_AUTH_TOKEN"):
        return os.environ["ANTHROPIC_AUTH_TOKEN"]
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            env = json.load(f).get("env") or {}
    except (OSError, ValueError):
        return ""
    return env.get("ANTHROPIC_AUTH_TOKEN") or "" if _routes_to_zai(env.get("ANTHROPIC_BASE_URL")) else ""


def api_get(url, params=None):
    """Bearer GET via curl (token on stdin, never argv); returns parsed JSON or None."""
    import subprocess
    token = zai_token()
    if not token:
        return None
    cmd = ["curl", "-s", "-m", "10", "-H", "@-", "-H", "Accept: application/json"]
    for k, v in (params or {}).items():
        cmd += ["--data-urlencode", f"{k}={v}"]
    if params:
        cmd.append("-G")
    cmd.append(url)
    try:
        r = subprocess.run(cmd, input=f"Authorization: Bearer {token}",
                           capture_output=True, text=True, check=True, timeout=15)
        return json.loads(r.stdout)
    except (subprocess.CalledProcessError, ValueError, subprocess.TimeoutExpired, OSError):
        return None


def models():
    """Per-model consumption over the last 7 days, from the monitor API."""
    end = time.strftime("%Y-%m-%d %H:%M:%S")
    start = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() - 7 * 86400))
    d = api_get(MODELS_URL, {"startTime": start, "endTime": end})
    if not d or not d.get("success"):
        print("zai-usage: model-usage fetch failed")
        return 1
    data = d["data"]
    for m in data.get("modelSummaryList", []):
        print(f"{m['modelName']}: {m['totalTokens'] / 1e6:.0f}M tok")
    tu = data.get("totalUsage") or {}
    print(f"total: {tu.get('totalTokensUsage', 0) / 1e6:.0f}M tok, "
          f"{tu.get('totalModelCallCount', 0)} calls (7d, bucket tz UTC+8)")
    return 0


def poll_api():
    """Fetch the quota API and write the cache from it. Returns True on success."""
    d = api_get(QUOTA_URL)
    if not d or not d.get("success"):
        return False
    try:
        limits = [L for L in d["data"]["limits"] if L.get("type") == "TOKENS_LIMIT"]
        five = next(L for L in limits if L.get("number") == 5)
        week = next(L for L in limits if L.get("unit") == 6)
    except (KeyError, StopIteration, TypeError):
        return False
    out = {"as_of": int(time.time()), "source": "api",
           "five_hour_pct": round(five["percentage"]), "week_pct": round(week["percentage"]),
           "five_hour_reset_at": int(five.get("nextResetTime", 0) // 1000),
           "week_reset_at": int(week.get("nextResetTime", 0) // 1000)}
    write_json(CACHE, out)
    return True


def sweep_locked():
    """One refresher at a time: API first, transcript-scan fallback. A caller that loses the
    lock race keeps the old numbers."""
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    lock = open(SWEEP_LOCK, "w")
    try:
        flock(lock, LOCK_EX | LOCK_NB)
    except OSError:
        return load(CACHE, {})
    try:
        if poll_api():
            return load(CACHE, {})
        out = sweep(load(STATE, {}))
        out["source"] = "local"
        write_json(CACHE, out)
        return out
    finally:
        flock(lock, LOCK_UN)


def calibrate(args):
    """Anchor to console readings: --calibrate WEEK_PCT [5H_PCT] [--reset "YYYY-MM-DD HH:MM"]."""
    nums, reset = [], None
    it = iter(args)
    for a in it:
        if a == "--reset":
            reset = time.mktime(time.strptime(next(it), "%Y-%m-%d %H:%M"))
        elif a.replace(".", "", 1).isdigit():
            nums.append(float(a))
    if not nums:
        print('usage: zai-usage --calibrate WEEK_PCT [5H_PCT] [--reset "YYYY-MM-DD HH:MM"]')
        return 2
    sweep_locked()  # fresh numbers before anchoring
    # The sweep's own lock, waited for: a concurrent detached --sweep must not lose its offsets.
    with open(SWEEP_LOCK, "w") as lock:
        flock(lock, LOCK_EX)
        state = load(STATE, {})
        cache = load(CACHE, {})
        now = int(time.time())
        state["calW"] = {"pct": nums[0], "at": now, "winv": cache.get("week_winv", 0)}
        if len(nums) > 1:
            state["cal5"] = {"pct": nums[1], "at": now, "winv": cache.get("five_hour_winv", 0)}
        if reset:
            state["reset_at"] = int(reset)
        write_json(STATE, state)
    sweep_locked()  # bake the percentages into the cache
    cache = load(CACHE, {})
    caps = []
    if "week_pct" in cache:
        caps.append(f"wk cap ~{cache['week_winv'] * 100.0 / nums[0]:.0f} winv")
    if "five_hour_pct" in cache:
        caps.append(f"5h cap ~{cache['five_hour_winv'] * 100.0 / nums[1]:.0f} winv")
    print(f"anchored: weekly {nums[0]:g}%"
          + (f", 5h {nums[1]:g}%" if len(nums) > 1 else "")
          + (f", resets {time.strftime('%a %b %-d %H:%M', time.localtime(reset))}" if reset else "")
          + ("; " + ", ".join(caps) if caps else "")
          + " (re-anchor at the next console visit: the proxy drifts with the usage mix)")
    return 0


def report(mode):
    c = load(CACHE, {})
    if not c:
        print("…" if mode == "--line" else "zai-usage: no data yet (run a sweep first)")
        return 0 if mode == "--line" else 2
    if mode == "--json":
        print(json.dumps(c))
        return 0
    if mode == "--sweep":
        return 0

    def pct(k):
        return f"{c[k]}%" if k in c else "uncal"

    age = int(time.time() - c["as_of"])
    if c.get("source") == "api":
        # Anthropic-segment style ("5h:83% wk:56%", reset arrow when it matters) in the
        # hybrid format: colon + space after the timeframe.
        line = (f"5h: {pct('five_hour_pct')} (→{time.strftime('%H:%M', time.localtime(c['five_hour_reset_at']))})"
                f" wk: {pct('week_pct')} (→{time.strftime('%a %H:%M', time.localtime(c['week_reset_at']))})")
    elif "week_pct" in c:
        line = f"5h: {pct('five_hour_pct')} wk: {pct('week_pct')} · local est"
        if c.get("week_reset_at"):
            line += f" (→{time.strftime('%a %H:%M', time.localtime(c['week_reset_at']))})"
    else:
        line = (f"5h uncal ({c['five_hour_winv']}w/{c['five_hour_inv']} inv, {c['five_hour_wtok']}M tok), "
                f"wk uncal ({c['week_winv']}w/{c['week_inv']} inv, {c['week_wtok']}M tok) · local est")
    if age > TTL * 2:
        line += f" (+{age}s)"
    print(line)
    return 0


def main():
    argv = sys.argv[1:]
    mode = argv[0] if argv else ""
    if mode == "--models":
        return models()
    if mode == "--calibrate":
        return calibrate(argv[1:])
    if mode == "--line":
        if stale():  # sweep detached; print from the (possibly absent) cache and return at once
            if os.fork() == 0:
                os.setsid()
                devnull = os.open(os.devnull, os.O_WRONLY)
                for fd in (0, 1, 2):
                    os.dup2(devnull, fd)
                os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), "--sweep"])
        return report(mode)
    if mode == "--sweep" or stale():
        sweep_locked()
    return report(mode)


if __name__ == "__main__":
    sys.exit(main())
