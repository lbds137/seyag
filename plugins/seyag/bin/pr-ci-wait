#!/usr/bin/env python3
"""pr-ci-wait: wait for a PR's CI (and, where configured, its review run) to settle.

Usage:
  pr-ci-wait N [--sha FULL40]

Ported from Tzurot's `gh:ci-gate` (packages/tooling/src/gh/ci-gate.ts): the same
release condition, argument validation, head-drift check, startup-failure early
exit, review-run grace clock, and sentinel set — as a portable stdlib-only
script any project's Monitor can arm. Runs the real `gh`/`git` on PATH; every
`gh` call is bounded, so a hang reads as a bounded failure, never as a silent
wait.

`N` is the PR number. `--sha` is the full 40-hex commit SHA to watch — pass
`$(git rev-parse HEAD)` right after pushing, UNRESOLVED, so it resolves when
this command actually runs rather than at arm time. If omitted, the PR's
current head (`head.sha`) is read and used instead, and a log line says so
(after the always-first "Waiting for CI..." line and the anchor/review
config lines).

Sentinels (printed on their own line, exactly, once): CI_COMPLETE,
CI_GATE_TIMEOUT, CI_GATE_STARTUP_FAILURE, CI_GATE_REVIEW_MISSING. A
`gh pr checks N` report always prints last, on every outcome.

A completed run with conclusion `failure` and zero jobs on its attempt (a run
that never started, e.g. during a GitHub outage) takes the same
CI_GATE_STARTUP_FAILURE sentinel as a `startup_failure` run; `cancelled` runs
are not checked. A failed job-count lookup holds release until it succeeds (it
counts as a failed gh call for logging, and a `startup_failure` run in the same
poll is still reported).

Exit codes: 0 only on CI_COMPLETE; 1 for every other gate outcome (timeout,
startup failure, review missing); 2 for a usage/argument error (bad --sha,
--sha naming no local commit, or a PR head that persistently disagrees with
--sha after one re-read).

Workflow config (both are workflow `name` values, not job or step names):
  SYG_CI_ANCHOR       The workflow whose completion (plus nothing else still
                       pending) means CI has settled. Unset or empty falls
                       back to the QUIET-WINDOW rule: settled once >=1 run
                       exists, nothing is pending, and the run-id set has
                       been unchanged and all-completed for the quiet window
                       (see PR_CI_WAIT_QUIET_S) across polls — weaker than an
                       anchor, because a workflow created after the window
                       closes is missed.
  SYG_CI_REVIEW       The workflow whose run must exist and complete before
                       release, asserted POSITIVELY (a run that never
                       dispatches is otherwise invisible to "nothing
                       pending"). Unset: auto-detected as the first top-level
                       `name:` line equal to "Claude Code Review" in any
                       .github/workflows/*.yml|*.yaml at the repo root; none
                       found means no review assertion at all (settled ==
                       releasable). Set but EMPTY (SYG_CI_REVIEW=)
                       disables the assertion explicitly, overriding
                       auto-detection.

Test knobs (env, seconds; do not set these for a real wait — they exist so
the probe can run in seconds instead of minutes):
  PR_CI_WAIT_POLL_S       seconds between polls                  (default 30)
  PR_CI_WAIT_MAX_S        give-up bound                          (default 1500)
  PR_CI_WAIT_GRACE_S      review-run grace window                (default 300)
  PR_CI_WAIT_HEARTBEAT_S  heartbeat interval                     (default 600)
  PR_CI_WAIT_SETTLE_S     pause after --watch, before final report (default 5)
  PR_CI_WAIT_QUIET_S      quiet-window length (no-anchor mode)   (default 90)
  PR_CI_WAIT_FAKE_TICK_S  quiet-window clock advances this much per poll instead of wall time (probe only; default off)
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

FULL_SHA = re.compile(r"^[0-9a-f]{40}$", re.I)

# gh substitutes these literal placeholders from the repo the command runs
# in (or --repo), so no separate owner/repo lookup is needed.
REPO_SPEC = "{owner}/{repo}"

RUNS_PAGE_SIZE = 100
ERROR_REPEAT_EVERY = 10

# Bounds on individual gh/git calls (seconds) — not test knobs; a hang here
# must degrade to a bounded, reported failure, never to silence.
COMMIT_CHECK_TIMEOUT_S = 15
HEAD_FETCH_TIMEOUT_S = 15
RUNS_FETCH_TIMEOUT_S = 15
JOBS_FETCH_TIMEOUT_S = 15
CHECKS_REPORT_TIMEOUT_S = 60
# Floor on the `gh pr checks --watch` bound, which is otherwise whatever is left
# of PR_CI_WAIT_MAX_S once the gate releases.
WATCH_MIN_S = 5
# Re-read delay before believing a head-SHA mismatch (see confirm_head_sha).
# Not exposed as a knob: it fires at most once per run, so it costs the
# probe a few real seconds rather than minutes.
HEAD_RECHECK_S = 3

SENTINELS = {
    "releasable": "CI_COMPLETE",
    "timeout": "CI_GATE_TIMEOUT",
    "startup-failure": "CI_GATE_STARTUP_FAILURE",
    "review-missing": "CI_GATE_REVIEW_MISSING",
}


def _env_float(name, default):
    v = os.environ.get(name)
    if v is None or v == "":
        return default
    try:
        return float(v)
    except ValueError:
        return default


POLL_S = _env_float("PR_CI_WAIT_POLL_S", 30)
MAX_WAIT_S = _env_float("PR_CI_WAIT_MAX_S", 1500)
GRACE_S = _env_float("PR_CI_WAIT_GRACE_S", 300)
HEARTBEAT_S = _env_float("PR_CI_WAIT_HEARTBEAT_S", 600)
SETTLE_S = _env_float("PR_CI_WAIT_SETTLE_S", 5)
QUIET_S = _env_float("PR_CI_WAIT_QUIET_S", 90)
FAKE_TICK_S = _env_float("PR_CI_WAIT_FAKE_TICK_S", 0)


def log(msg):
    print(msg, flush=True)


def die(msg, code=2):
    print(f"pr-ci-wait: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


class GhApiError(Exception):
    """A bounded `gh` call failed — auth, rate limit, network, or a hang."""


def gh(args, timeout_s):
    """Run `gh <args>`, bounded. Returns stdout; raises GhApiError on any failure."""
    try:
        result = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=timeout_s)
    except subprocess.TimeoutExpired:
        raise GhApiError(f"timed out after {timeout_s}s")
    except OSError as exc:
        raise GhApiError(f"could not run gh: {exc}")
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip().splitlines()
        raise GhApiError(detail[0] if detail else "gh failed with no output")
    return result.stdout


def git_has_commit(sha):
    """Whether `sha` names a commit in this repo. A timeout means "could not
    tell", answered True — never confused with "does not exist" (see
    Tzurot's ci-gate.ts gitHasCommit for the reasoning this is ported from).
    """
    try:
        result = subprocess.run(
            ["git", "cat-file", "-e", f"{sha}^{{commit}}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=COMMIT_CHECK_TIMEOUT_S,
        )
    except subprocess.TimeoutExpired:
        return True
    except OSError:
        return False
    return result.returncode == 0


def fetch_pr_head_sha(pr):
    """The PR's current head SHA, or None when it cannot be read at all."""
    try:
        out = gh(["api", f"repos/{REPO_SPEC}/pulls/{pr}", "--jq", ".head.sha"], HEAD_FETCH_TIMEOUT_S)
    except GhApiError:
        return None
    sha = out.strip().lower()
    return sha if FULL_SHA.match(sha) else None


def classify_head_sha(sha, pr_head):
    if pr_head is None:
        return "unknown", None
    return ("match", None) if pr_head == sha else ("mismatch", pr_head)


def confirm_head_sha(sha, pr):
    """Classify, and on a mismatch re-read once before believing it — the
    first read can legitimately trail a just-landed push."""
    kind, extra = classify_head_sha(sha, fetch_pr_head_sha(pr))
    if kind != "mismatch":
        return kind, extra
    time.sleep(HEAD_RECHECK_S)
    return classify_head_sha(sha, fetch_pr_head_sha(pr))


def describe_head_mismatch(pr, sha, pr_head):
    return (
        f"--sha {sha} is not the head of PR #{pr}, which points at {pr_head}. "
        "The gate re-read once and still disagrees. Most often HEAD moved between "
        "the push and the arm (a branch checkout does it); an unusually slow GitHub "
        "replication is the other candidate. Confirm with `git rev-parse HEAD` and "
        f"`gh pr view {pr} --json headRefOid`, then re-arm."
    )


def resolve_sha(pr, sha_arg):
    """Validate an explicit --sha, or resolve one from the PR head when omitted.
    Returns (sha, was_omitted). Exits 2 on any validation failure."""
    if sha_arg:
        sha = sha_arg.lower()
        if not FULL_SHA.match(sha):
            die(
                f'--sha must be the full 40-character SHA, got "{sha}" ({len(sha)} chars). '
                "The runs API matches nothing on an abbreviated SHA, so the gate would wait "
                "forever. Use `git rev-parse HEAD`."
            )
        if not git_has_commit(sha):
            die(
                f"--sha {sha} is well-formed but does not name a commit in this repo. "
                "The runs API will never match it, so the gate would wait out its full "
                "timeout. Use `$(git rev-parse HEAD)` rather than completing an abbreviated "
                "SHA by hand."
            )
        return sha, False

    log(f"--sha omitted; resolving PR #{pr}'s current head…")
    head = fetch_pr_head_sha(pr)
    if head is None:
        die(
            f"--sha was omitted and PR #{pr}'s head could not be read (gh api failed or the "
            "PR does not exist). Pass --sha $(git rev-parse HEAD) explicitly."
        )
    if not git_has_commit(head):
        die(
            f"PR #{pr}'s head {head} does not name a commit in this local repo (fetch first, "
            "or run from the checkout that holds the branch)."
        )
    log(f"--sha omitted; using PR #{pr}'s head {head[:8]}…")
    return head, True


def autodetect_review_workflow():
    """The first top-level `name:` line equal to "Claude Code Review" across
    .github/workflows/*.yml|*.yaml at the repo root, or None."""
    try:
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=10
        )
    except OSError:
        return None
    if top.returncode != 0:
        return None
    wf_dir = Path(top.stdout.strip()) / ".github" / "workflows"
    if not wf_dir.is_dir():
        return None
    files = sorted(wf_dir.glob("*.yml")) + sorted(wf_dir.glob("*.yaml"))
    for f in files:
        try:
            text = f.read_text(errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            m = re.match(r"^name:\s*(.+?)\s*$", line)
            if m:
                value = m.group(1).strip().strip("'\"")
                if value == "Claude Code Review":
                    return value
                break  # only the FIRST top-level name: line in a workflow file counts
    return None


def resolve_workflow_config():
    """Reads SYG_CI_ANCHOR / SYG_CI_REVIEW, prints the effective
    config, and returns (anchor_or_None, review_workflow_or_None)."""
    anchor_raw = os.environ.get("SYG_CI_ANCHOR")
    anchor = anchor_raw or None
    if anchor:
        log(f'anchor: workflow "{anchor}" (SYG_CI_ANCHOR)')
    else:
        log(
            f"no anchor configured (SYG_CI_ANCHOR unset) — "
            f"using the quiet-window rule: "
            f"settled once nothing is pending and the run set has been unchanged for "
            f"{QUIET_S:g}s. Weaker than an anchor — a workflow created later than the window "
            "is missed. Set SYG_CI_ANCHOR to a workflow name to use the anchor rule instead."
        )

    # Presence check, not just value: set-but-EMPTY disables the assertion
    # (overriding auto-detection) rather than falling through to it.
    raw = os.environ.get("SYG_CI_REVIEW")
    if raw is not None:
        if raw == "":
            log("review: disabled (SYG_CI_REVIEW= set empty) — settled == releasable")
            review = None
        else:
            review = raw
            log(f'review: workflow "{review}" (SYG_CI_REVIEW)')
    else:
        review = autodetect_review_workflow()
        if review:
            log(f'review: workflow "{review}" (auto-detected from a workflow file)')
        else:
            log(
                'review: none found (no workflow named "Claude Code Review" under '
                ".github/workflows) — settled == releasable"
            )
    return anchor, review


def fetch_runs(sha):
    raw = gh(
        ["api", f"repos/{REPO_SPEC}/actions/runs?head_sha={sha}&per_page={RUNS_PAGE_SIZE}", "--jq", ".workflow_runs"],
        RUNS_FETCH_TIMEOUT_S,
    )
    try:
        runs = json.loads(raw)
    except json.JSONDecodeError:
        raise GhApiError(f"unparseable response: {raw.strip()[:120]}")
    if len(runs) >= RUNS_PAGE_SIZE:
        log(
            f"⚠️  {len(runs)} workflow runs on this SHA — at the {RUNS_PAGE_SIZE}-run page "
            "ceiling. Runs beyond page 1 are invisible to the gate, so it may release on a "
            "partial list."
        )
    return runs


def fetch_job_count(run):
    """Number of jobs on the run's own attempt. The attempt is pinned because the
    plain `runs/ID/jobs` endpoint reads the LATEST attempt, which can have jobs
    when the attempt this run object describes created none."""
    base = f"repos/{REPO_SPEC}/actions/runs/{run.get('id')}"
    attempt = run.get("run_attempt")
    path = f"{base}/attempts/{attempt}/jobs" if attempt is not None else f"{base}/jobs"
    raw = gh(["api", f"{path}?per_page=1", "--jq", ".total_count"], JOBS_FETCH_TIMEOUT_S)
    try:
        return int(raw.strip())
    except ValueError:
        raise GhApiError(f"unparseable job count: {raw.strip()[:120]}")


def find_zero_job_failures(runs, job_counts):
    """Completed runs with conclusion `failure` and zero jobs on their attempt.
    `job_counts` caches (id, run_attempt) -> count across polls. Returns
    (found, lookup_errors): a GhApiError from one run's lookup is collected as
    (run, exc) and nothing is cached for that run, so the other runs are still
    checked. Only `failure` is checked: a concurrency-`cancelled` run can
    legitimately have zero jobs."""
    found = []
    lookup_errors = []
    for r in runs:
        if r.get("status") != "completed" or r.get("conclusion") != "failure":
            continue
        key = (r.get("id"), r.get("run_attempt"))
        if key not in job_counts:
            try:
                job_counts[key] = fetch_job_count(r)
            except GhApiError as exc:
                lookup_errors.append((r, exc))
                continue
        if job_counts[key] == 0:
            found.append({"name": r.get("name"), "id": r.get("id")})
    return found, lookup_errors


def parse_gate_state(runs, anchor, review_workflow):
    pending = [f"{r.get('name')}({r.get('status')})" for r in runs if r.get("status") != "completed"]
    anchor_complete = anchor is not None and any(
        r.get("name") == anchor and r.get("status") == "completed" and r.get("conclusion") != "startup_failure"
        for r in runs
    )
    review_complete = review_workflow is not None and any(
        r.get("name") == review_workflow and r.get("status") == "completed" and r.get("conclusion") != "startup_failure"
        for r in runs
    )
    startup_failures = [{"name": r.get("name"), "id": r.get("id")} for r in runs if r.get("conclusion") == "startup_failure"]
    return {
        "total": len(runs),
        "pending": pending,
        "anchor_complete": anchor_complete,
        "review_complete": review_complete,
        "startup_failures": startup_failures,
        "run_ids": frozenset(r.get("id") for r in runs),
    }


def describe_wait_state(state, anchor_configured, review_configured):
    if state is None:
        return "no data (gh api failing)"
    if state["total"] == 0:
        return "no runs registered yet"
    pending = ", ".join(state["pending"]) if state["pending"] else "none"
    parts = [f"pending: {pending}"]
    if anchor_configured:
        parts.append(f"anchor {'done' if state['anchor_complete'] else 'not done'}")
    if review_configured:
        parts.append(f"review {'done' if state['review_complete'] else 'not done'}")
    return "; ".join(parts)


class QuietTracker:
    """The quiet-window settlement clock used when no anchor is configured.
    `update` must be called at most once per poll, only when a state was
    actually fetched (a failed poll leaves it untouched by simply not calling
    it — mirroring Tzurot's trackReviewGrace)."""

    def __init__(self, quiet_s):
        self.quiet_s = quiet_s
        self.ids = None
        self.since = None

    def update(self, state, now):
        if state["total"] == 0 or state["pending"]:
            self.ids = None
            self.since = None
            return False
        if self.ids != state["run_ids"]:
            self.ids = state["run_ids"]
            self.since = now
        return (now - self.since) >= self.quiet_s


def run_wait(sha, anchor, review_workflow):
    start = time.monotonic()
    consecutive_errors = 0
    last_heartbeat = start
    review_settled_at = None
    quiet = QuietTracker(QUIET_S)
    polls_done = 0
    job_counts = {}

    while True:
        state = None
        error_msg = None
        try:
            runs = fetch_runs(sha)
            zero_job_failures, lookup_errors = find_zero_job_failures(runs, job_counts)
            state = parse_gate_state(runs, anchor, review_workflow)
            state["zero_job_failures"] = zero_job_failures
            state["lookup_pending"] = bool(lookup_errors)
            if lookup_errors:
                error_msg = "; ".join(
                    f"job count for {r.get('name')} (run {r.get('id')}): {exc}" for r, exc in lookup_errors
                )
        except GhApiError as exc:
            error_msg = str(exc)

        if error_msg is not None:
            consecutive_errors += 1
            if consecutive_errors == 1 or consecutive_errors % ERROR_REPEAT_EVERY == 0:
                log(f"⚠️  gh api failed ({consecutive_errors}x): {error_msg}")
        elif consecutive_errors > 0:
            log(f"✓ gh api recovered after {consecutive_errors} failure(s)")
            consecutive_errors = 0

        # A poll with a failed job-count lookup still feeds the startup/zero-job
        # exit below, but is treated like a failed poll for release and the
        # review grace clock (`usable` False).
        usable = state is not None and not state["lookup_pending"]

        if state is not None and (state["startup_failures"] or state["zero_job_failures"]):
            startup = state["startup_failures"]
            zero = state["zero_job_failures"]
            if startup:
                failed = ", ".join(f"{f['name']} (run {f['id']})" for f in startup)
                rerun = " && ".join(f"gh run rerun {f['id']}" for f in startup)
                log(
                    f"❌ workflow run died before dispatch (startup_failure): {failed}. It created "
                    f"zero jobs, so it is absent from `gh pr checks` entirely. Rerun with: {rerun}"
                )
            if zero:
                failed = ", ".join(f"{f['name']} (run {f['id']})" for f in zero)
                rerun = " && ".join(f"gh run rerun {f['id']}" for f in startup + zero)
                label = "Rerun all with" if startup else "Rerun with"
                log(
                    f"❌ workflow run failed with zero jobs: {failed}. It is absent from "
                    "`gh pr checks` entirely. Rerun once; if it fails again with zero jobs, "
                    f"check the workflow file on the run page. {label}: {rerun}"
                )
            return "startup-failure"

        settled_now = False
        if usable:
            if anchor is not None:
                settled_now = state["total"] > 0 and state["anchor_complete"] and not state["pending"]
            else:
                clock = polls_done * FAKE_TICK_S if FAKE_TICK_S > 0 else time.monotonic()
                settled_now = quiet.update(state, clock)

        if usable and settled_now and (review_workflow is None or state["review_complete"]):
            return "releasable"

        if review_workflow is not None:
            if usable:
                if not settled_now:
                    review_settled_at = None
                else:
                    if review_settled_at is None:
                        review_settled_at = time.monotonic()
                    if time.monotonic() - review_settled_at >= GRACE_S:
                        log(
                            f'❌ CI finished but no "{review_workflow}" run exists for this SHA '
                            f"after {round(GRACE_S / 60)}m. Nothing ran, so there is nothing to "
                            "rerun: re-query the run list; if it is still absent, the workflow "
                            "did not dispatch — check its on: filter against the PR event."
                        )
                        return "review-missing"
            # a failed poll (state is None, or a failed job-count lookup) leaves
            # review_settled_at untouched

        elapsed = time.monotonic() - start
        if elapsed >= MAX_WAIT_S:
            log(f"⏱️  gate gave up after {round(elapsed / 60)}m — CI never reached a releasable state. Re-arm.")
            return "timeout"
        if time.monotonic() - last_heartbeat >= HEARTBEAT_S:
            last_heartbeat = time.monotonic()
            log(f"⏳ {round(elapsed / 60)}m — {describe_wait_state(state, anchor is not None, review_workflow is not None)}")

        polls_done += 1
        time.sleep(POLL_S)


def run_checks(pr, watch, timeout_s=CHECKS_REPORT_TIMEOUT_S, bound="what was left of PR_CI_WAIT_MAX_S"):
    args = ["pr", "checks", str(pr)]
    if watch:
        args += ["--watch", "--interval=30"]
    try:
        if watch:
            subprocess.run(
                ["gh", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout_s
            )
        else:
            subprocess.run(["gh", *args], timeout=timeout_s)
    except subprocess.TimeoutExpired:
        if watch:
            log(
                f"⚠️  `gh pr checks --watch` still running after {round(timeout_s)}s ({bound}); "
                "stopped it, reporting the decided outcome"
            )
        else:
            log(f"⚠️  `gh pr checks` could not run: timed out after {round(timeout_s)}s")
    except OSError as exc:
        log(f"⚠️  `gh pr checks` could not run: {exc}")


def main():
    parser = argparse.ArgumentParser(
        prog="pr-ci-wait", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("pr", type=int, help="PR number")
    parser.add_argument("--sha", help="full 40-hex commit SHA; omit to use the PR's current head")
    args = parser.parse_args()

    if args.pr < 1:
        die("PR number must be positive")

    log(f"⏱️  Waiting for CI on PR #{args.pr}" + (f" @ {args.sha.lower()[:8]}…" if args.sha else " …"))
    anchor, review = resolve_workflow_config()
    sha, was_omitted = resolve_sha(args.pr, args.sha)

    if not was_omitted:
        kind, extra = confirm_head_sha(sha, args.pr)
        if kind == "mismatch":
            die(describe_head_mismatch(args.pr, sha, extra))
        elif kind == "unknown":
            log("⚠️  Could not read the PR head; arming without the drift check.")

    started = time.monotonic()
    outcome = run_wait(sha, anchor, review)

    if outcome == "releasable":
        left = MAX_WAIT_S - (time.monotonic() - started)
        if left >= WATCH_MIN_S:
            run_checks(args.pr, watch=True, timeout_s=left)
        else:
            run_checks(args.pr, watch=True, timeout_s=WATCH_MIN_S,
                       bound=f"the {WATCH_MIN_S}s floor; PR_CI_WAIT_MAX_S was spent")
        time.sleep(SETTLE_S)

    log(SENTINELS[outcome])
    run_checks(args.pr, watch=False)

    sys.exit(0 if outcome == "releasable" else 1)


if __name__ == "__main__":
    main()
