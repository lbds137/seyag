#!/bin/bash
# safe-worktree-clean - judge agent worktrees (--all: every linked one) for safe removal; --apply removes SAFE ones; --apply-hold backs up and removes approved HOLD ones
#
# Usage:
#   safe-worktree-clean [--apply] [--repo DIR]... [--repos-file FILE] [--apply-hold ID] [--base REF] [--all] [--only PATH]... [--locks] [--locks-apply] [--json]
#
# Judges every worktree under <repo>/.claude/worktrees/ (--all: every linked worktree wherever it
# lives; --repo DIR repeatable, default: the current repo; --repos-file FILE reads one repo path
# per line, skipping blank lines and # comments and expanding ~/, exiting 2 if the file is
# missing) and prints SAFE or HOLD:<reason> for each; HOLD trees go into one batched report.
# With several repos in total, runs once per repo in the given order (--only applies to one repo
# and exits 2 with several repos).
# Dry run by default. --apply removes each SAFE tree on its own (unlock, git worktree remove
# --force, git branch -D, then one git worktree prune); a HOLD never blocks another tree.
# A tree is SAFE only when ALL hold, and any check that cannot run is a HOLD:
#   1 lock      no lock, or the first "pid <N>" in the lock reason is a dead process
#               (a lock reason without a pid is HOLD:lock-unparsable)
#   2 cwd       no process has its cwd inside the tree (/proc walk)
#   3 commits   `git cherry <base> <branch>` shows no +, or no path the branch changed from its
#               merge-base with <base> differs between <base> and the branch tip (net tip content:
#               a commit the branch itself reverted is not kept); squash/rebase-merged work passes
#               until <base> changes a file it touched, then HOLD (the owner's call), and a commit
#               subject alone never passes; no per-worktree ref (`refs/worktree/*`, `refs/bisect/*`,
#               `refs/rewritten/*` — the namespaces that die with the tree) holds a commit on
#               neither <base> nor another branch (HOLD:worktree-refs, HOLD:bisect-refs,
#               HOLD:rewritten-refs), and none points at a non-commit object, a blob, tree or
#               tag, which the backup cannot carry (HOLD:<namespace>-refs-object, never
#               approvable)
#   4 files     every dirty, staged or untracked file has <base>'s mode for that path (both
#               absent counts), and its content equals <base>'s or <base> subsumes it. Tracked:
#               `git merge-file <base> <tree HEAD's blob> <tree content>` is clean and yields
#               <base>'s bytes unchanged. Untracked: <base>'s file keeps every line of the tree's
#               file, in order (additions only). An untracked path that <base> lacks is HOLD,
#               and so is any assume-unchanged or skip-worktree entry (its edits are hidden)
#   5 ignored   ignored files are only safe-clean cache names (the entry's own last component,
#               or ignored by a rule file in a directory whose last component is a cache name;
#               read from safe-clean itself) or repo-declared regenerable paths:
#               .claude/worktree-regenerable as committed on <base> (never a tree's copy) plus
#               SYG_WORKTREE_REGENERABLE (whitespace-separated globs). One entry per line, #
#               comments: `<glob>` (bash pattern, * crosses /, a trailing / dropped) or
#               `<path> = <template>`, where the ignored file must equal <base>'s <template>
#               byte for byte. A malformed line, or a glob that matches every path (*, **, .*),
#               is skipped with a warning on stderr.
#   6 branch    the branch matches SYG_WORKTREE_BRANCH_RE (extended regex; unset or empty:
#               ^worktree-agent-); a detached HEAD instead needs check 7
#   7 detached  the tree is under <repo>/.claude/worktrees/ (outside is HOLD:detached-outside)
#               and HEAD's commit is reachable from <base> or a local branch
#   8 state     no in-progress git operation (rebase-merge, rebase-apply, MERGE_HEAD,
#               CHERRY_PICK_HEAD, REVERT_HEAD, BISECT_LOG, sequencer -> HOLD:in-progress), and
#               no submodule with uncommitted, untracked or ignored content, commits not on any
#               remote (including stashes, custom refs and reflogs), or a populated gitlink
#               directory without .git (HOLD:submodule)
#   9 gitfile   the tree's .git is a regular file pointing to its own <common>/worktrees/<id>
#               entry under <repo>/.git, with commondir and gitdir pointing back, no nested
#               .git exists below the tree other than gitfiles pointing under
#               <entry>/modules/, and no directory below the tree holds HEAD with objects,
#               refs, or commondir (worktree-gitfile-check, run before any git -C in the
#               tree), and no gitlink path is a symlink or resolves outside the tree
#               (judge_submodules, before git -C in that path) -> HOLD:gitfile
# Approvable HOLD trees and plan id: a HOLD tree under <repo>/.claude/worktrees/ whose reason
# codes are all in {unmerged, dirty, untracked-new, untracked-differs, ignored, branch-name,
# detached-unreferenced, worktree-refs, bisect-refs, rewritten-refs} and that has no unmerged
# index entries
# (`git ls-files -u`) is approvable ("approvable": true in --json; listed after the HOLD report as
# `  approvable with --apply-hold: <rel path>`); any other code or an unmerged index entry keeps
# the tree held under every mode. Every dry run with approvable trees also prints one summary line
# per plan — `hold plan <id> would remove <N> tree(s): <path1>, <path2>` (the sweep id gets the
# same shape after `sweep plan:`), listing the exact trees that id removes, truncated at three
# paths with `… +<k> more` in text; --json carries the full lists as `hold_plan_trees` per repo
# and `sweep_plan_trees` on the sweep object, plus `hold_plan_commit_carrying` /
# `sweep_plan_commit_carrying`: the plan's commit-carrying trees (reason `unmerged`,
# `detached-unreferenced`, `worktree-refs`, `bisect-refs` or `rewritten-refs` — any code that can
# carry commits not provably on <base> or another branch) with their commit counts beyond <base>.
# A repo's plan id (`hold plan: <id>`, JSON `"hold_plan"`, null
# when no tree is approvable) is the first 12 hex of sha256 over each approvable tree in path
# order: path, branch (or empty), `git rev-parse HEAD`, sorted reason lines, and `tree_state_sha`
# (sha256 over `git status --porcelain=v1 -z --ignored --untracked-files=all`, `git diff --binary
# HEAD`, `git diff --binary --cached HEAD` for the index, the file contents via `git
# hash-object --no-filters` or symlink target via `readlink` of each untracked and
# non-cache/non-regenerable ignored file, and `git for-each-ref refs/worktree/ refs/bisect/
# refs/rewritten/`), NUL-separated, with every child's exit status folded in after its output
# as a `\001<name>=<rc>\0` line so a failed child changes the sha (SYG_WORKTREE_STATE_BATCH_FAIL=1
# is a test seam, internal, that fails the hash-object batch child). Across several repos,
# `sweep plan: <id>` (JSON `"sweep_plan"`) is the first 12
# hex of sha256 over the repos' `<repo path>\0<plan id or empty>` lines in the given order when
# any repo has an approvable tree and no child dry run failed.
# --apply-hold ID (also --apply-hold=ID; implies --apply; refuses with --all, exit 2): removing a
# HOLD tree is the owner's call; pass the id from the dry run they approved — the printed summary
# line names the exact tree list that id removes, and the yes binds to that list. Recomputes the
# plan
# id (the sweep id across several repos) and verifies the resolved backup dir lies outside the
# repo and all its listed worktrees and is not on tmpfs/ramfs (unless
# SYG_WORKTREE_BACKUP_ALLOW_VOLATILE=1) before removing anything; a plan mismatch, a rejected
# backup dir, or a refused commit-carrying plan exits 2 and removes nothing (SAFE trees included).
# A plan containing a commit-carrying tree refuses with one line per offending tree (naming the
# tree and its commit count beyond <base>) unless the same invocation names that tree with
# --only; with --only, the plan is recomputed over exactly the named trees and must equal the
# approved id, so a change to an unrelated tree does not invalidate the approval — the flow for
# such trees is a scoped dry run (--only <tree>...), then --apply-hold <id> with the same --only.
# Across several repos, --only is refused outright, so a sweep plan containing a commit-carrying
# tree refuses at the parent (nothing removed anywhere); approve those trees per repo with the
# scoped flow. Across several repos, each repo's
# run re-verifies its own plan before removing, so a repo that changed after an earlier repo was
# applied exits 2 and keeps its trees (the sweep can end partly applied; the exit code says so).
# On a match, SAFE trees go as --apply, and each approvable HOLD tree is backed up under
# `umask 077` (dirs 0700, files 0600) to
# `${SYG_WORKTREE_BACKUP_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/seyag/worktree-backups}/<YYYY-MM-DDTHHMMSS>/<repo basename>--<tree basename>--<first 8 hex of sha256 over "<repo path>\0<tree path>">/`
# (`SYG_WORKTREE_RUN_STAMP` is internal: parent-to-child handoff and tests; a set but empty
# value is refused too) with `tree.tgz` (every file except .git and ignored entries accepted by
# is_cache_path or regen_verdict), `branch.bundle` (`git bundle create` of the branch or HEAD
# excluding <base>, omitted when there are no commits beyond <base>), `reflog.pack` (commits in
# the HEAD, branch, or per-worktree-ref (`refs/worktree/*`, `refs/bisect/*`, `refs/rewritten/*`)
# reflogs or tips not in the bundle or on <base>, omitted when none), `uncommitted.patch`
# (`git diff --binary HEAD`), `staged.patch` (`git diff --binary --cached HEAD`), `changes.txt`
# (including reflog/per-worktree-ref-only commits, the per-worktree refs, and ignored entries
# excluded as cache/regenerable), and `README.txt`,
# verified with `tar --quoting-style=literal -tzf`, `git bundle verify`, and `git index-pack` and
# re-checked for cwd, state, and lock changes before unlock / `git worktree remove --force` /
# `git branch -D`.
# <base> is --base REF, else SYG_WORKTREE_BASE, else origin/<default branch> (origin/HEAD,
# else origin/main), compared as the local ref stands (fetch first for a fresh verdict);
# a configured ref that does not resolve, or no default ref, makes every tree HOLD:no-base;
# for a repo whose integration branch is not its default branch (e.g. git-flow develop),
# set it to that branch's remote-tracking ref. A configured ref starting with - exits 2.
# --only PATH (also --only=PATH; repeatable) narrows the run to the named worktree(s) among
# those this run would judge (resolved relative to the caller's cwd before cd /); a PATH that
# matches none of them exits 2 before any judging or removal. --only PATH --apply is the
# per-tree close-out form; a matched --only does not narrow --locks (it still lists every
# worktree's index.lock), but an unmatched --only exits 2 before --locks runs.
# --locks also lists index.lock files in the repo's .git and every worktree's git dir; a lock
# is stale when it is 0 bytes, older than SYG_WORKTREE_LOCK_AGE_MIN minutes (integer, default
# 10), and no live git process works in the repo. --locks-apply deletes exactly the stale ones.
# --json prints one JSON object instead of text (`{"repos": [...], "sweep_plan": ...}` when
# sweeping several repos).
# Exit: 0 done; 1 --apply found no removable tree (nothing removed); 2 usage, plan mismatch, a
# refused commit-carrying plan, or
# not a git repo; 3 a backup, removal, or lock deletion failed. With several repos: 3 if any
# child exits 3, else 2 if any exits 2, else 1 only if every child exits 1, else 0.

set -uo pipefail

usage() { sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; }
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

# One summary line per plan id (see the header): the exact tree list the id would remove,
# display names passed in ready-to-print form, truncated at three with "… +<k> more".
plan_summary_line() { # $1 "hold plan <id>" | "sweep plan <id>", $2... display tree names
  local prefix=$1 out="" p n
  shift
  n=$#
  if [ "$n" -gt 3 ]; then
    for p in "${@:1:3}"; do out+="${out:+, }$p"; done
    out+=", … +$((n - 3)) more"
  else
    for p in "$@"; do out+="${out:+, }$p"; done
  fi
  printf '%s would remove %d tree(s): %s\n' "$prefix" "$n" "$out"
}

APPLY=false APPLY_HOLD="" ALL=false LOCKS=false LOCKS_APPLY=false JSON=false BASE_ARG="" BASE_SRC=""
REPOS=() ONLY_RAW=() ONLY_REAL=()

add_repos_file() {
  local f=$1 line
  if [ -z "$f" ] || [ ! -f "$f" ] || [ ! -r "$f" ]; then
    echo "safe-worktree-clean: cannot read --repos-file: $f" >&2
    exit 2
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line=$(trim "${line%$'\r'}")
    case "$line" in "" | "#"*) continue ;; esac
    case "$line" in
      [~]) line=$HOME ;;
      [~]/*) line="$HOME/${line#[~]/}" ;;
    esac
    REPOS+=("$line")
  done <"$f"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --apply) APPLY=true ;;
    --apply-hold)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      case "$2" in "" | -*) echo "safe-worktree-clean: --apply-hold needs a plan id" >&2; usage >&2; exit 2 ;; esac
      APPLY_HOLD=$2; APPLY=true; shift ;;
    --apply-hold=*)
      APPLY_HOLD=${1#--apply-hold=}
      case "$APPLY_HOLD" in "" | -*) echo "safe-worktree-clean: --apply-hold needs a plan id" >&2; usage >&2; exit 2 ;; esac
      APPLY=true ;;
    --all) ALL=true ;;
    --locks) LOCKS=true ;;
    --locks-apply) LOCKS=true; LOCKS_APPLY=true ;;
    --json) JSON=true ;;
    --repo)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      [ -n "$2" ] || { echo "safe-worktree-clean: --repo needs a path" >&2; usage >&2; exit 2; }
      REPOS+=("$2"); shift ;;
    --repo=*)
      [ -n "${1#--repo=}" ] || { echo "safe-worktree-clean: --repo needs a path" >&2; usage >&2; exit 2; }
      REPOS+=("${1#--repo=}") ;;
    --repos-file)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      add_repos_file "$2"; shift ;;
    --repos-file=*)
      add_repos_file "${1#--repos-file=}" ;;
    --only)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      [ -n "$2" ] || { echo "safe-worktree-clean: --only needs a path" >&2; usage >&2; exit 2; }
      ONLY_RAW+=("$2"); shift ;;
    --only=*)
      [ -n "${1#--only=}" ] || { echo "safe-worktree-clean: --only needs a path" >&2; usage >&2; exit 2; }
      ONLY_RAW+=("${1#--only=}") ;;
    --base)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      [ -n "$2" ] || { echo "safe-worktree-clean: --base needs a ref" >&2; usage >&2; exit 2; }
      BASE_ARG=$2; BASE_SRC="--base"; shift ;;
    --base=*)
      BASE_ARG=${1#--base=}
      [ -n "$BASE_ARG" ] || { echo "safe-worktree-clean: --base needs a ref" >&2; usage >&2; exit 2; }
      BASE_SRC="--base" ;;
    *) echo "safe-worktree-clean: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
[ ${#REPOS[@]} -gt 0 ] || REPOS=(.)
if [ -n "$APPLY_HOLD" ] && $ALL; then
  echo "safe-worktree-clean: --apply-hold cannot be used with --all" >&2
  exit 2
fi
if [ ${#REPOS[@]} -gt 1 ] && [ ${#ONLY_RAW[@]} -gt 0 ]; then
  echo "safe-worktree-clean: --only applies to one repo" >&2
  exit 2
fi
if [ -z "$BASE_SRC" ] && [ -n "${SYG_WORKTREE_BASE:-}" ]; then
  BASE_ARG=$SYG_WORKTREE_BASE
  BASE_SRC="SYG_WORKTREE_BASE"
fi
# git would read a leading - as an option (and `--base --apply` would swallow the flag).
case $BASE_ARG in -*)
  echo "safe-worktree-clean: base ref from $BASE_SRC may not start with '-': $BASE_ARG" >&2; exit 2 ;;
esac

SELF=$(readlink -f "${BASH_SOURCE[0]}")
SELF_DIR=$(cd "$(dirname "$SELF")" && pwd)
BACKUP_ROOT=$(realpath -m -- "${SYG_WORKTREE_BACKUP_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/seyag/worktree-backups}")
if [ -n "${SYG_WORKTREE_RUN_STAMP+set}" ] && [[ ! $SYG_WORKTREE_RUN_STAMP =~ ^[0-9A-Za-z][0-9A-Za-z._-]*$ ]]; then
  echo "safe-worktree-clean: SYG_WORKTREE_RUN_STAMP is internal and must be a plain name: $SYG_WORKTREE_RUN_STAMP" >&2
  exit 2
fi
RUN_STAMP=${SYG_WORKTREE_RUN_STAMP:-$(date +%Y-%m-%dT%H%M%S)}
RUN_DIR=$(realpath -m -- "$BACKUP_ROOT/$RUN_STAMP")

parse_repo_plan() {
  python3 -c '
import json, sys
d = json.load(sys.stdin)
print((d.get("repo") or "") + "\x1e" + (d.get("hold_plan") or ""))
' <<<"$1"
}

sweep_plan_of() {
  local idx
  for idx in "${!REPOS[@]}"; do
    printf '%s\0%s\n' "${R_MAINS[$idx]}" "${R_PLANS[$idx]}"
  done | sha256sum | cut -c1-12
}

check_backup_volatile() {
  [ "${SYG_WORKTREE_BACKUP_ALLOW_VOLATILE:-}" = 1 ] && return 0
  local probe=$RUN_DIR fstype
  while [ ! -e "$probe" ] && [ "$probe" != "/" ] && [ -n "$probe" ]; do
    probe=$(dirname -- "$probe")
  done
  fstype=$(stat -f -c %T -- "$probe" 2>/dev/null) || fstype=""
  case "$fstype" in
    tmpfs | ramfs)
      echo "safe-worktree-clean: backup dir $RUN_DIR is on $fstype (lost on reboot); choose a persistent SYG_WORKTREE_BACKUP_DIR or set SYG_WORKTREE_BACKUP_ALLOW_VOLATILE=1" >&2
      exit 2
      ;;
  esac
}

if [ ${#REPOS[@]} -gt 1 ]; then
  declare -A SEEN_MAIN_ENTRY=()
  for r in "${REPOS[@]}"; do
    r_main_raw=""
    if r_porc=$(git -C "$r" worktree list --porcelain -z 2>/dev/null | tr '\0' '\036'); then
      while IFS= read -r -d $'\036' wf; do
        case "$wf" in
          "worktree "*) r_main_raw=${wf#worktree }; break ;;
        esac
      done <<<"$r_porc"
    fi
    [ -n "$r_main_raw" ] || continue
    r_main_res=$(realpath -m -- "$r_main_raw")
    if [ -n "${SEEN_MAIN_ENTRY[$r_main_res]+set}" ]; then
      echo "safe-worktree-clean: ${SEEN_MAIN_ENTRY[$r_main_res]} and $r are the same repo ($r_main_res); list it once" >&2
      exit 2
    fi
    SEEN_MAIN_ENTRY[$r_main_res]=$r
  done

  COMMON_ARGS=()
  $ALL && COMMON_ARGS+=(--all)
  if $LOCKS_APPLY; then
    COMMON_ARGS+=(--locks-apply)
  elif $LOCKS; then
    COMMON_ARGS+=(--locks)
  fi
  [ "$BASE_SRC" = "--base" ] && COMMON_ARGS+=(--base "$BASE_ARG")

  R_MAINS=() R_PLANS=()
  has_hold_plan=false
  if [ -n "$APPLY_HOLD" ]; then
    DRY_ARGS=()
    $ALL && DRY_ARGS+=(--all)
    $LOCKS && DRY_ARGS+=(--locks)
    [ "$BASE_SRC" = "--base" ] && DRY_ARGS+=(--base "$BASE_ARG")
    CHILD_JSONS=()
    for r in "${REPOS[@]}"; do
      if d_out=$(bash "$SELF" --repo "$r" --json "${DRY_ARGS[@]}"); then
        CHILD_JSONS+=("$d_out")
        IFS=$'\036' read -r r_main r_plan < <(parse_repo_plan "$d_out")
        R_MAINS+=("$r_main")
        R_PLANS+=("$r_plan")
        [ -n "$r_plan" ] && has_hold_plan=true
        r_wts=()
        while IFS= read -r -d $'\036' wf; do
          case "$wf" in "worktree "*) r_wts+=("$(realpath -m -- "${wf#worktree }")") ;; esac
        done < <(git -C "$r" worktree list --porcelain -z 2>/dev/null | tr '\0' '\036')
        for wp in "${r_wts[@]}"; do
          if [ "$RUN_DIR" = "$wp" ] || [[ "$RUN_DIR" == "${wp%/}/"* ]]; then
            echo "safe-worktree-clean: backup dir $RUN_DIR is inside $wp; choose SYG_WORKTREE_BACKUP_DIR outside the repo and its worktrees" >&2
            exit 2
          fi
        done
      else
        echo "safe-worktree-clean: $r: dry run failed; nothing removed" >&2
        exit 2
      fi
    done
    check_backup_volatile
    SWEEP_PLAN=""
    if $has_hold_plan; then
      SWEEP_PLAN=$(sweep_plan_of)
    fi
    if [ -z "$SWEEP_PLAN" ] || [ "$APPLY_HOLD" != "$SWEEP_PLAN" ]; then
      echo "safe-worktree-clean: hold plan changed: approved $APPLY_HOLD, now ${SWEEP_PLAN:-none}; rerun the dry run and get a fresh yes" >&2
      exit 2
    fi
    # Sweep ids are unscoped (--only is refused for several repos), so one commit-carrying tree
    # anywhere in the sweep refuses the whole apply at the parent, before any child runs; the
    # per-repo scoped flow (--only) is the approval path for those trees. The children's dry-run
    # JSONs already name each repo's commit-carrying plan trees (hold_plan_commit_carrying).
    {
      printf '%s\0' "${CHILD_JSONS[@]}"
    } | python3 -c '
import json, sys
plan_id = sys.argv[1]
data = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").split("\0")[:-1]
refused = False
for x in data:
    d = json.loads(x)
    for t in d.get("hold_plan_commit_carrying") or []:
        refused = True
        print("safe-worktree-clean: --apply-hold refused: plan %s includes commit-carrying tree %s (%d commit(s) not on %s) — name it with --only to approve its removal"
              % (plan_id, t["path"], t["commits"], t["base"]), file=sys.stderr)
if refused:
    sys.exit(2)
' "$APPLY_HOLD" || exit 2
    export SYG_WORKTREE_RUN_STAMP=$RUN_STAMP
  fi

  any_3=false any_2=false all_1=true
  JSON_OBJS=() FAILED_REPOS=()
  # The text sweep's summary line aggregates each child's own summary line: total tree count
  # plus the first display names, capped at three (JSON carries the full sweep_plan_trees).
  SWEEP_TXT_N=0
  SWEEP_TXT_NAMES=()
  for idx in "${!REPOS[@]}"; do
    r=${REPOS[$idx]}
    child_extra=()
    if [ -n "$APPLY_HOLD" ]; then
      if [ -n "${R_PLANS[$idx]}" ]; then
        child_extra+=(--apply-hold "${R_PLANS[$idx]}")
      else
        child_extra+=(--apply)
      fi
    elif $APPLY; then
      child_extra+=(--apply)
    fi
    $JSON && child_extra+=(--json)
    c_out=$(SYG_WORKTREE_SWEEP_CHILD=1 bash "$SELF" --repo "$r" "${COMMON_ARGS[@]}" "${child_extra[@]}")
    c_rc=$?
    [ "$c_rc" -eq 3 ] && any_3=true
    [ "$c_rc" -eq 2 ] && any_2=true
    [ "$c_rc" -ne 1 ] && all_1=false
    if [ -z "$APPLY_HOLD" ] && { [ "$c_rc" -eq 2 ] || [ -z "$c_out" ]; }; then
      FAILED_REPOS+=("$r")
    fi
    if $JSON; then
      if [ -n "$c_out" ]; then
        JSON_OBJS+=("$c_out")
        if [ -z "$APPLY_HOLD" ]; then
          IFS=$'\036' read -r r_main r_plan < <(parse_repo_plan "$c_out")
          R_MAINS+=("$r_main")
          R_PLANS+=("$r_plan")
          [ -n "$r_plan" ] && has_hold_plan=true
        fi
      else
        err_json=$(python3 -c 'import json, sys; print(json.dumps({"repo": sys.argv[1], "error": f"exit {sys.argv[2]}"}))' "$r" "$c_rc")
        JSON_OBJS+=("$err_json")
        if [ -z "$APPLY_HOLD" ]; then
          R_MAINS+=("$(realpath -m -- "$r")")
          R_PLANS+=("")
        fi
      fi
    else
      [ -z "$c_out" ] || printf '%s\n' "$c_out"
      if [ -z "$APPLY_HOLD" ]; then
        if [ -n "$c_out" ]; then
          first_line=${c_out%%$'\n'*}
          r_main=${first_line#repo: }
          r_main=${r_main%%  base: *}
          r_plan=$(sed -n 's/^hold plan: \([0-9a-f]\{12\}\)$/\1/p' <<<"$c_out" | tail -n 1)
          hp_line=$(sed -n 's/^hold plan [0-9a-f]\{12\} would remove \([0-9]\{1,\}\) tree(s): \(.*\)$/\1\t\2/p' <<<"$c_out" | tail -n 1)
          if [ -n "$hp_line" ]; then
            SWEEP_TXT_N=$((SWEEP_TXT_N + ${hp_line%%$'\t'*}))
            hp_list=${hp_line#*$'\t'}
            while [ ${#SWEEP_TXT_NAMES[@]} -lt 3 ] && [ -n "$hp_list" ]; do
              case $hp_list in
                *", "*) hp_seg=${hp_list%%", "*}; hp_list=${hp_list#*", "} ;;
                *) hp_seg=$hp_list; hp_list="" ;;
              esac
              SWEEP_TXT_NAMES+=("$r_main/$hp_seg")
            done
          fi
        else
          r_main=$(realpath -m -- "$r")
          r_plan=""
        fi
        R_MAINS+=("$r_main")
        R_PLANS+=("$r_plan")
        [ -n "$r_plan" ] && has_hold_plan=true
      fi
    fi
  done

  if [ -z "$APPLY_HOLD" ]; then
    SWEEP_PLAN=""
    if [ ${#FAILED_REPOS[@]} -eq 0 ] && $has_hold_plan; then
      SWEEP_PLAN=$(sweep_plan_of)
    fi
  fi

  if $JSON; then
    {
      printf '%s\0' "$SWEEP_PLAN"
      for j in "${JSON_OBJS[@]}"; do
        printf '%s\0' "$j"
      done
    } | python3 -c '
import json, sys
f = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").split("\0")[:-1]
sweep_plan = f[0] or None
repos = [json.loads(x) for x in f[1:] if x]
trees = []
cc = []
for d in repos:
    trees += d.get("hold_plan_trees") or []
    cc += d.get("hold_plan_commit_carrying") or []
print(json.dumps({"repos": repos, "sweep_plan": sweep_plan,
                  "sweep_plan_trees": trees, "sweep_plan_commit_carrying": cc}, indent=2))
'
  else
    if [ -n "$APPLY_HOLD" ]; then
      shopt -s nullglob
      bk_readmes=("$RUN_DIR"/*/README.txt)
      shopt -u nullglob
      [ ${#bk_readmes[@]} -eq 0 ] || echo "backups: $RUN_DIR"
    elif ! $APPLY && [ ${#FAILED_REPOS[@]} -gt 0 ]; then
      failed_list=""
      for fr in "${FAILED_REPOS[@]}"; do
        failed_list="${failed_list:+$failed_list, }$fr"
      done
      echo "sweep plan: none (dry run failed for $failed_list; fix it or drop it from the list)"
    elif [ -n "$SWEEP_PLAN" ]; then
      echo "sweep plan: $SWEEP_PLAN"
      if [ "$SWEEP_TXT_N" -gt 0 ]; then
        sw_out=""
        sw_shown=0
        for sw_p in "${SWEEP_TXT_NAMES[@]}"; do
          [ "$sw_shown" -lt 3 ] || break
          sw_out+="${sw_out:+, }$sw_p"
          sw_shown=$((sw_shown + 1))
        done
        if [ "$sw_shown" -lt "$SWEEP_TXT_N" ]; then
          printf 'sweep plan %s would remove %d tree(s): %s, … +%d more\n' \
            "$SWEEP_PLAN" "$SWEEP_TXT_N" "$sw_out" "$((SWEEP_TXT_N - sw_shown))"
        else
          printf 'sweep plan %s would remove %d tree(s): %s\n' "$SWEEP_PLAN" "$SWEEP_TXT_N" "$sw_out"
        fi
      fi
    fi
  fi

  if $any_3; then exit 3
  elif $any_2; then exit 2
  elif $all_1; then exit 1
  else exit 0; fi
fi

REPO=${REPOS[0]}
COMMON=$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>&1) || {
  echo "safe-worktree-clean: not a git repo: $REPO ($COMMON)" >&2; exit 2; }
PORCELAIN=$(git -C "$REPO" worktree list --porcelain -z | tr '\0' '\036') || {
  echo "safe-worktree-clean: git worktree list failed in $REPO" >&2; exit 2; }
COMMON=$(realpath -e -- "$COMMON")
for p in "${ONLY_RAW[@]}"; do
  ONLY_REAL+=("$(realpath -m -- "$p")")
done
# Every later command names its directory, and no process of this tool may sit in a tree.
cd / || exit 2

# Worktrees: records of key-value fields, one blank field between worktrees.
WT_PATH=() WT_HEAD=() WT_BRANCH=() WT_LOCKED=() WT_LOCK_REASON=() WT_PRUNABLE=()
cur=-1
while IFS= read -r -d $'\036' f; do
  case "$f" in
    "worktree "*) cur=$((cur + 1)); WT_PATH[cur]=${f#worktree }; WT_HEAD[cur]=""
      WT_BRANCH[cur]=""; WT_LOCKED[cur]=false; WT_LOCK_REASON[cur]=""; WT_PRUNABLE[cur]="" ;;
    "HEAD "*) WT_HEAD[cur]=${f#HEAD } ;;
    "branch "*) WT_BRANCH[cur]=${f#branch refs/heads/} ;;
    locked) WT_LOCKED[cur]=true ;;
    "locked "*) WT_LOCKED[cur]=true; WT_LOCK_REASON[cur]=${f#locked } ;;
    prunable*) WT_PRUNABLE[cur]=${f#prunable}; WT_PRUNABLE[cur]=${WT_PRUNABLE[cur]# }
      [ -n "${WT_PRUNABLE[cur]}" ] || WT_PRUNABLE[cur]="prunable" ;;
  esac
done <<<"$PORCELAIN"
[ "$cur" -ge 0 ] || { echo "safe-worktree-clean: no worktrees listed in $REPO" >&2; exit 2; }
MAIN=$(realpath -m -- "${WT_PATH[0]}")
WT_ROOT="$MAIN/.claude/worktrees"

NO_BASE_REASON=""
if [ -n "$BASE_SRC" ]; then
  BASE=$BASE_ARG
  if ! git -C "$MAIN" rev-parse -q --verify "$BASE^{commit}" >/dev/null; then
    NO_BASE_REASON="base ref $BASE (from $BASE_SRC) does not resolve to a commit"
    BASE=""
  fi
else
  BASE_REF=$(git -C "$MAIN" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null)
  BASE=${BASE_REF#refs/remotes/}
  [ -n "$BASE" ] || BASE=origin/main
  if ! git -C "$MAIN" rev-parse -q --verify "$BASE^{commit}" >/dev/null; then
    BASE=""
    NO_BASE_REASON="no origin/HEAD or origin/main ref to compare against"
  fi
fi

# Source of truth for cache names: safe-clean's CACHE_NAMES line, read, never copied.
CACHE_NAMES=()
if [ -r "$SELF_DIR/safe-clean" ]; then
  read -ra CACHE_NAMES <<<"$(sed -n 's/^CACHE_NAMES=(\(.*\))$/\1/p' "$SELF_DIR/safe-clean")"
fi

# Repo-declared regenerable ignored paths (check 5): the file as committed on BASE, never a
# tree's or a working copy's version (a tree can't widen it), plus the env's globs.
REGEN_FILE=.claude/worktree-regenerable
REGEN_GLOBS=()
declare -A REGEN_TEMPLATE=()
# A glob of only *s, optionally after one dot (*, **, .*), matches every path or every dotfile,
# .env secrets included: refused. $1 the glob, $2 where it came from (for the warning).
# A trailing / (gitignore's directory form) is dropped: ignored paths are matched without it.
add_glob() {
  local g=$1
  while [[ $g == */ ]]; do g=${g%/}; done
  if [[ -z $g || $g =~ ^\.?\*+$ ]]; then
    echo "safe-worktree-clean: warning: $2: '$1' matches every path; ignored" >&2
  else
    REGEN_GLOBS+=("$g")
  fi
}
if [ -n "$BASE" ] && regen_text=$(git -C "$MAIN" cat-file blob "$BASE:$REGEN_FILE" 2>/dev/null); then
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=$(trim "${line%$'\r'}")
    case "$line" in "" | "#"*) continue ;; esac
    if [[ $line == *=* ]]; then
      key=$(trim "${line%%=*}") tmpl=$(trim "${line#*=}")
      if [ -z "$key" ] || [ -z "$tmpl" ]; then
        echo "safe-worktree-clean: warning: line $n of $REGEN_FILE on $BASE is malformed (an empty side of '='); line ignored" >&2
        continue
      fi
      REGEN_TEMPLATE[$key]=$tmpl
    else
      add_glob "$line" "line $n of $REGEN_FILE on $BASE"
    fi
  done <<<"$regen_text"
fi
# Split on any whitespace, newlines included (-d '' reads to the end; its EOF status is moot).
read -r -d '' -a env_globs <<<"${SYG_WORKTREE_REGENERABLE:-}"
for g in "${env_globs[@]}"; do add_glob "$g" SYG_WORKTREE_REGENERABLE; done

# Temp copies for check 4's merge-file and diff, made on first use; never under a tree. A
# signal exits with the conventional status, which runs the EXIT cleanup.
MF_TMP=""
trap '[ -z "$MF_TMP" ] || rm -rf -- "$MF_TMP"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

BRANCH_RE=${SYG_WORKTREE_BRANCH_RE:-}
[ -n "$BRANCH_RE" ] || BRANCH_RE='^worktree-agent-'
AGE_MIN=${SYG_WORKTREE_LOCK_AGE_MIN:-}
[[ $AGE_MIN =~ ^[0-9]+$ ]] || AGE_MIN=10

# /proc scan. Mode cwd: prints "path NUL pid NUL" for each given path some process has its cwd
# inside. Mode git: prints "pid NUL" for each process whose argv[0] is git (or git-*) and whose
# cwd or any argument lies inside a given path. Unreadable foreign pids are skipped; exit 3 when
# /proc itself cannot be read, which callers turn into HOLD.
proc_scan() {
  python3 - "$@" <<'PYEOF'
import os, sys

mode, paths = sys.argv[1], [os.path.realpath(p) for p in sys.argv[2:]]
try:
    os.readlink("/proc/self/cwd")
except OSError:
    sys.exit(3)


def inside(p, root):
    return p == root or p.startswith(root.rstrip("/") + "/")


out = sys.stdout.buffer
for d in os.listdir("/proc"):
    if not d.isdigit():
        continue
    try:
        cwd = os.readlink(f"/proc/{d}/cwd")
    except OSError:
        continue
    if mode == "cwd":
        for p in paths:
            if inside(cwd, p):
                out.write(os.fsencode(p) + b"\0" + d.encode() + b"\0")
        continue
    try:
        with open(f"/proc/{d}/cmdline", "rb") as f:
            argv = [os.fsdecode(a) for a in f.read().split(b"\0") if a]
    except OSError:
        continue
    prog = os.path.basename(argv[0]) if argv else ""
    if prog != "git" and not prog.startswith("git-"):
        continue
    words = [cwd] + [a for a in argv[1:] if a.startswith("/")]
    if any(inside(os.path.realpath(w), p) for w in words for p in paths):
        out.write(d.encode() + b"\0")
PYEOF
}

# True when mode $1 equals the given path's mode on BASE ("" for absent; both absent is equal).
mode_as_base() {
  local base_mode
  base_mode=$(git -C "$MAIN" ls-tree "$BASE" -- "$2" 2>/dev/null) || return 1
  [ "$1" = "${base_mode%% *}" ]
}

# True when $1's blob and $3's mode equal the given path's state on BASE (both absent counts
# as equal). $1: a blob sha or "" for absent; $2 the path; $3 a git mode or "" for absent.
same_as_base() {
  local base_blob
  base_blob=$(git -C "$MAIN" rev-parse -q --verify "$BASE:$2" 2>/dev/null) || base_blob=""
  [ "$1" = "$base_blob" ] && mode_as_base "$3" "$2"
}

# The git mode of the working file $1/$2 as the index would record it; "" when absent.
wt_mode() {
  if [ -L "$1/$2" ]; then echo 120000
  elif [ ! -e "$1/$2" ]; then echo ""
  elif [ -x "$1/$2" ]; then echo 100755
  else echo 100644; fi
}

# True when BASE already holds the tree's change to a path (check 4, run only where
# same_as_base failed). ours = BASE's blob; theirs = $4 "file" (the working file),
# "blob:<sha>" (that blob) or "" (empty); the tree's mode $5 (wt_mode, or the index mode; ""
# when absent) must equal BASE's mode for the path. $3 picks the content rule:
#   head   a tracked path: `git merge-file -p ours <the tree's HEAD blob> theirs` exits 0 and
#          prints BASE's bytes unchanged.
#   empty  an untracked path: BASE keeps every line of the tree's file, in order (BASE = the
#          tree's lines plus additions only), by GNU diff: exit 0 or 1 with no tree-only line.
#          A trailing-newline difference on a shared line counts as a tree-only line.
# An absent blob is an empty file; a binary file, a symlink or any failed step is false.
# Contents go only to the private temp dir.
subsumed_by_base() {
  local t=$1 p=$2 anc=$3 theirs=$4 d f
  mode_as_base "${5-}" "$p" || return 1
  # mktemp -d makes the dir mode 0700, the copies hold file contents, and a
  # SIGKILL skips the trap, so they can be left behind in it.
  [ -n "$MF_TMP" ] || MF_TMP=$(mktemp -d) || return 1
  d=$MF_TMP
  { : >"$d/ours" && : >"$d/anc" && : >"$d/theirs"; } 2>/dev/null || return 1
  if git -C "$MAIN" rev-parse -q --verify "$BASE:$p" >/dev/null 2>&1; then
    git -C "$MAIN" cat-file blob "$BASE:$p" >"$d/ours" 2>/dev/null || return 1
  fi
  if [ "$anc" = head ] && git -C "$t" rev-parse -q --verify "HEAD:$p" >/dev/null 2>&1; then
    git -C "$t" cat-file blob "HEAD:$p" >"$d/anc" 2>/dev/null || return 1
  fi
  case "$theirs" in
    file) { [ -f "$t/$p" ] && [ ! -L "$t/$p" ] && cat -- "$t/$p" >"$d/theirs"; } 2>/dev/null || return 1 ;;
    blob:*) git -C "$t" cat-file blob "${theirs#blob:}" >"$d/theirs" 2>/dev/null || return 1 ;;
  esac
  for f in ours anc theirs; do
    [ ! -s "$d/$f" ] || LC_ALL=C grep -qI '' "$d/$f" || return 1
  done
  if [ "$anc" = empty ]; then
    diff --unchanged-line-format= --old-line-format='%L' --new-line-format= \
      "$d/theirs" "$d/ours" >"$d/out" 2>/dev/null
    case $? in 0 | 1) [ ! -s "$d/out" ] ;; *) return 1 ;; esac
    return
  fi
  git merge-file -p "$d/ours" "$d/anc" "$d/theirs" >"$d/out" 2>/dev/null && cmp -s "$d/out" "$d/ours"
}

# Check 5's repo-declared entries. Prints nothing; returns 0 when the ignored entry $2 (a
# directory with a trailing /) in tree $1 passes, 1 when no entry names it, 2 when it is a
# declared template path whose bytes differ from BASE's template (or the template is absent).
regen_verdict() {
  local t=$1 q=${2%/} g tmpl_blob file_blob
  if [ -n "${REGEN_TEMPLATE[$q]+set}" ]; then
    [ "$q" = "$2" ] || return 2
    tmpl_blob=$(git -C "$MAIN" rev-parse -q --verify "$BASE:${REGEN_TEMPLATE[$q]}" 2>/dev/null) || return 2
    file_blob=$(git -C "$t" hash-object --no-filters -- "$q" 2>/dev/null) || return 2
    [ -n "$file_blob" ] && [ "$file_blob" = "$tmpl_blob" ] && return 0
    return 2
  fi
  for g in "${REGEN_GLOBS[@]}"; do
    # shellcheck disable=SC2053 # the entry is a pattern by design
    [[ $q == $g ]] && return 0
  done
  return 1
}

is_cache_path() { # the entry's own last path component, or its ignore rule's containing dir's, is a cache name
  local t=$1 q=${2%/} leaf n out meta src dir
  leaf=${q##*/}
  for n in "${CACHE_NAMES[@]}"; do [ "$leaf" = "$n" ] && return 0; done
  out=$(git -C "$t" check-ignore -v -- "$q" 2>/dev/null) || return 1
  meta=${out%%$'\t'*}
  [[ $meta =~ ^(.+):[0-9]+: ]] || return 1
  src=${BASH_REMATCH[1]}
  [[ $src == */* ]] || return 1
  dir=${src%/*}
  leaf=${dir##*/}
  for n in "${CACHE_NAMES[@]}"; do [ "$leaf" = "$n" ] && return 0; done
  return 1
}

# Fill the array named $1 with the NUL-separated output of the command after it; return
# nonzero when the command fails (a bare `mapfile < <(cmd)` would hide that).
z_list() {
  local -n z_arr=$1
  shift
  mapfile -d '' z_arr < <("$@"; printf '\001rc=%s\0' "$?")
  local last=${z_arr[-1]:-}
  unset 'z_arr[-1]'
  [ "$last" = $'\001rc=0' ]
}

REASONS=()
hold() { REASONS+=("$1"$'\t'"$2"); }

# True when BASE contains the branch $1's net changes (check 3, run only when git cherry
# reported + commits): no path the branch changed from its merge-base with BASE differs
# between BASE and the branch tip.
branch_contained() {
  local ref="refs/heads/$1" mb p
  local -a br_changed=() base_diff=()
  local -A br_set=()
  if ! mb=$(git -C "$MAIN" merge-base "$BASE" "$ref" 2>/dev/null) || [ -z "$mb" ] ||
    ! z_list br_changed git -C "$MAIN" diff --no-renames --no-ext-diff --no-textconv \
      --ignore-submodules=none --name-only -z "$mb" "$ref" 2>/dev/null ||
    ! z_list base_diff git -C "$MAIN" diff --no-renames --no-ext-diff --no-textconv \
      --ignore-submodules=none --name-only -z "$BASE" "$ref" 2>/dev/null; then
    return 1
  fi
  for p in "${br_changed[@]}"; do
    if [ -n "$p" ]; then br_set[$p]=1; fi
  done
  for p in "${base_diff[@]}"; do
    if [ -n "$p" ] && [ -n "${br_set[$p]+set}" ]; then
      return 1
    fi
  done
  return 0
}

# Criteria 3-9 for tree index $1; criteria 1-2 are judged by the caller.
judge_git() {
  local i=$1 t=${WT_PATH[$1]} b=${WT_BRANCH[$1]} head=${WT_HEAD[$1]}
  local out p blob wt_blob idx line sha subj n_unmerged=0 first=""
  if ! out=$(bash "$SELF_DIR/worktree-gitfile-check" --repo "$MAIN" "$t" 2>&1); then
    hold gitfile "${out#"worktree-gitfile-check: REFUSED: $t: "}"
    return
  fi
  if [ -z "$BASE" ]; then
    hold no-base "$NO_BASE_REASON"
    return
  fi
  # 6 + 7: what removal would delete or orphan.
  if [ -n "$b" ]; then
    local re_rc
    [[ $b =~ $BRANCH_RE ]] 2>/dev/null
    # shellcheck disable=SC2319 # the condition's own status is wanted: 2 means an invalid regex
    re_rc=$?
    case $re_rc in
      0) ;;
      1) hold branch-name "branch $b does not match $BRANCH_RE" ;;
      *) hold branch-name "SYG_WORKTREE_BRANCH_RE is not a valid extended regex: $BRANCH_RE" ;;
    esac
    # 3: commits on the branch with no equivalent on the base.
    if ! out=$(git -C "$MAIN" cherry "$BASE" "refs/heads/$b" 2>&1); then
      hold git-error "git cherry $BASE $b failed: ${out//$'\n'/ }"
    else
      while IFS= read -r line; do
        [ "${line:0:1}" = + ] || continue
        n_unmerged=$((n_unmerged + 1))
        if [ -z "$first" ]; then
          sha=${line#+ }
          subj=$(git -C "$MAIN" log -1 --format=%s "$sha" 2>/dev/null) || subj=""
          first="${sha:0:12} ${subj:-<empty subject>}"
        fi
      done <<<"$out"
      if [ "$n_unmerged" -gt 0 ] && ! branch_contained "$b"; then
        hold unmerged "$n_unmerged commit(s) not on $BASE and $BASE does not provably contain the branch's changes, first: $first"
      fi
    fi
  else
    case "$(realpath -m -- "$t")/" in
      "$WT_ROOT"/?*) ;;
      *) hold detached-outside "detached HEAD outside $WT_ROOT: only agent trees under .claude/worktrees/ are removable while detached" ;;
    esac
    if ! out=$(git -C "$MAIN" rev-list -n 1 "$head" --not "$BASE" --branches 2>&1); then
      hold git-error "git rev-list for detached HEAD ${head:0:12} failed: ${out//$'\n'/ }"
    elif [ -n "$out" ]; then
      hold detached-unreferenced "detached HEAD ${head:0:12} has commits on neither $BASE nor any branch"
    fi
  fi
  # The per-worktree ref namespaces (refs/worktree/, refs/bisect/, refs/rewritten/) die with
  # the tree, so a tip holding commits on neither BASE nor another branch holds, and a
  # non-commit tip (the backup packs commits only) holds under every mode.
  local ns wt_refs wt_sha wt_type wt_ref first_ns_ref
  local -a ns_tips=() wt_excl=()
  if [ -n "$b" ]; then
    # --exclude takes a glob: escape the wildmatch metacharacters so the branch name is
    # matched literally and cannot widen the exclude to other refs (git refuses ?*[ in
    # refnames today; the escape is defense in depth).
    local b_excl=$b
    b_excl=${b_excl//\\/\\\\}
    b_excl=${b_excl//\*/\\*}
    b_excl=${b_excl//\?/\\?}
    b_excl=${b_excl//\[/\\[}
    wt_excl=("--exclude=refs/heads/$b_excl")
  fi
  for ns in worktree bisect rewritten; do
    if ! wt_refs=$(git -C "$t" for-each-ref --format='%(objectname) %(objecttype) %(refname)' "refs/$ns/" 2>&1); then
      hold git-error "git for-each-ref refs/$ns/ failed: ${wt_refs//$'\n'/ }"
      continue
    fi
    ns_tips=()
    first_ns_ref=""
    while IFS=' ' read -r wt_sha wt_type wt_ref; do
      [ -n "$wt_sha" ] || continue
      # rev-list prints nothing for a blob/tree tip and the backup packs commits only, so a
      # ref at any other object type is held under every mode (not approvable).
      if [ "$wt_type" != commit ]; then
        hold "$ns-refs-object" "$wt_ref points at a $wt_type; back it up by hand before removing the tree"
        continue
      fi
      ns_tips+=("$wt_sha")
      [ -n "$first_ns_ref" ] || first_ns_ref=$wt_ref
    done <<<"$wt_refs"
    if [ ${#ns_tips[@]} -gt 0 ]; then
      if ! out=$(git -C "$t" rev-list -n 1 "${ns_tips[@]}" --not "$BASE" "${wt_excl[@]}" --branches 2>&1); then
        hold git-error "git rev-list for refs/$ns/ failed: ${out//$'\n'/ }"
      elif [ -n "$out" ]; then
        hold "$ns-refs" "refs/$ns/* holds commits on neither $BASE nor another branch (${#ns_tips[@]} ref(s) in the namespace, first: $first_ns_ref)"
      fi
    fi
  done
  # 4: tracked files whose worktree content differs from HEAD, and staged files whose index
  # content differs from HEAD: that content must equal the base's (absent on both counts), or
  # the base must subsume the change (subsumed_by_base).
  local -a changed=() staged=() untracked=() ignored=() status=()
  local theirs rv entry
  local -a flagged=()
  if ! z_list changed git -C "$t" diff --name-only -z --no-renames HEAD ||
    ! z_list staged git -C "$t" diff --cached --name-only -z --no-renames HEAD; then
    hold git-error "git diff in the tree failed"
  fi
  # 4: assume-unchanged (lowercase tag) and skip-worktree (S, also every path outside a sparse
  # checkout) entries hide their edits from the diffs above.
  if ! z_list flagged git -C "$t" ls-files -v -z; then
    hold git-error "git ls-files -v in the tree failed"
  fi
  for entry in "${flagged[@]}"; do
    case "${entry:0:1}" in
      s) hold hidden "${entry:2} is marked skip-worktree and assume-unchanged; its edits are not visible" ;;
      [a-z]) hold hidden "${entry:2} is marked assume-unchanged; its edits are not visible" ;;
      S) hold hidden "${entry:2} is marked skip-worktree; its edits are not visible" ;;
    esac
  done
  local mode
  for p in "${changed[@]}"; do
    if [ -e "$t/$p" ] || [ -L "$t/$p" ]; then
      wt_blob=$(git -C "$t" hash-object -- "$p" 2>/dev/null) || wt_blob="unreadable"
      theirs="file"
    else
      wt_blob="" theirs=""
    fi
    mode=$(wt_mode "$t" "$p")
    same_as_base "$wt_blob" "$p" "$mode" || subsumed_by_base "$t" "$p" head "$theirs" "$mode" ||
      hold dirty "$p differs from $BASE"
  done
  for p in "${staged[@]}"; do
    idx=$(git -C "$t" ls-files -s -- "$p" 2>/dev/null)
    case "$idx" in
      "") blob="" ;;
      *$'\n'*) blob="conflicted" ;;
      *) blob=$(cut -d' ' -f2 <<<"$idx") ;;
    esac
    same_as_base "$blob" "$p" "${idx%% *}" ||
      { [ "$blob" != conflicted ] && subsumed_by_base "$t" "$p" head "${blob:+blob:$blob}" "${idx%% *}"; } ||
      hold dirty "$p (staged) differs from $BASE"
  done
  # 4: untracked files: equal to (or subsumed by) the base's blob, with the base's mode (the
  # executable bit, or a symlink), never a path the base lacks.
  if ! z_list untracked git -C "$t" ls-files -z --others --exclude-standard; then
    hold git-error "git ls-files --others in the tree failed"
  fi
  for p in "${untracked[@]}"; do
    if ! git -C "$MAIN" rev-parse -q --verify "$BASE:${p%/}" >/dev/null 2>&1; then
      hold untracked-new "$p is untracked and not on $BASE"
    elif mode=$(wt_mode "$t" "${p%/}"); [ "${p%/}" != "$p" ] ||
      { ! same_as_base "$(git -C "$t" hash-object -- "$p" 2>/dev/null)" "$p" "$mode" &&
        ! subsumed_by_base "$t" "$p" empty file "$mode"; }; then
      hold untracked-differs "$p is untracked and differs from $BASE"
    fi
  done
  # 5: ignored files: only safe-clean cache names and repo-declared regenerable paths.
  # --ignored=matching lists each path an ignore rule matched (pkg/__pycache__/, dist/), where
  # ls-files --directory would collapse it into pkg/; a matched directory passes as a whole.
  # --no-renames: a rename record's extra NUL field would read as an entry.
  if ! z_list status git -C "$t" status --porcelain=v1 -z --no-renames --ignored=matching --untracked-files=all; then
    hold git-error "git status --ignored in the tree failed"
  fi
  for p in "${status[@]}"; do
    case "$p" in "!! "*) ignored+=("${p#!! }") ;; esac
  done
  for p in "${ignored[@]}"; do
    regen_verdict "$t" "$p"
    rv=$?
    if [ "$rv" -eq 0 ]; then
      continue
    elif [ "$rv" -eq 2 ]; then
      hold ignored "ignored ${p%/} differs from its declared template ${REGEN_TEMPLATE[${p%/}]}"
    elif [ ${#CACHE_NAMES[@]} -eq 0 ]; then
      hold ignored "$p is ignored, and safe-clean's cache list could not be read"
    elif ! is_cache_path "$t" "$p"; then
      hold ignored "$p is ignored and not a safe-clean cache name or a declared regenerable path"
    fi
  done
  local op gp
  local -a ops_found=()
  for op in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG sequencer; do
    if ! gp=$(git -C "$t" rev-parse --git-path "$op" 2>&1) || [ -z "$gp" ]; then
      hold git-error "git rev-parse --git-path $op failed: ${gp//$'\n'/ }"
      break
    fi
    case "$gp" in
      /*) ;;
      *) gp="$t/$gp" ;;
    esac
    if [ -e "$gp" ] || [ -L "$gp" ]; then
      ops_found+=("$op")
    fi
  done
  if [ ${#ops_found[@]} -gt 0 ]; then
    hold in-progress "in-progress git operation in the tree: ${ops_found[*]}"
  fi
  judge_submodules "$t" ""
}

judge_submodules() {
  local root=$1 prefix=$2 entry sub rel full sub_status sub_unpushed escaped full_real root_real
  local -a sub_entries=()
  if ! z_list sub_entries git -C "$root" ls-files -s -z; then
    hold git-error "git ls-files -s in ${prefix:-the tree} failed"
    return
  fi
  for entry in "${sub_entries[@]}"; do
    case "$entry" in "160000 "*) ;; *) continue ;; esac
    sub=${entry#*$'\t'}
    rel=${prefix:+$prefix/}$sub
    full="$root/$sub"
    # A symlink, or a path that resolves outside the tree, would send git -C out of it: hold, never recurse.
    escaped=false
    if [ -L "$full" ]; then
      escaped=true
    elif [ -e "$full" ]; then
      full_real=$(realpath -e -- "$full" 2>/dev/null); root_real=$(realpath -e -- "$root" 2>/dev/null)
      [[ -n "$full_real" && -n "$root_real" && "$full_real" == "$root_real"/?* ]] || escaped=true
    fi
    if $escaped; then
      hold gitfile "submodule $rel is a symlink or resolves outside the tree; git -C would run there"
      continue
    fi
    if [ ! -e "$full/.git" ] && [ ! -L "$full/.git" ]; then
      if [ -d "$full" ] && [ -n "$(ls -A -- "$full" 2>/dev/null)" ]; then
        hold submodule "submodule $rel is not initialised but its directory is not empty"
      fi
      continue
    fi
    if ! sub_status=$(git -C "$full" status --porcelain --ignored --untracked-files=all 2>&1); then
      hold git-error "git status in submodule $rel failed: ${sub_status//$'\n'/ }"
    elif ! sub_unpushed=$(git -C "$full" rev-list --max-count=1 --all --reflog HEAD --not --remotes 2>&1); then
      hold git-error "git rev-list in submodule $rel failed: ${sub_unpushed//$'\n'/ }"
    elif [ -n "$sub_status" ]; then
      hold submodule "submodule $rel has uncommitted, untracked, or ignored content"
    elif [ -n "$sub_unpushed" ]; then
      hold submodule "submodule $rel has commit(s) not on any remote (${sub_unpushed:0:12})"
    fi
    judge_submodules "$full" "$rel"
  done
}

# Agent trees and their cwd scan.
TREES=()
for i in $(seq 1 "$cur"); do
  if $ALL; then
    TREES+=("$i")
  else
    case "$(realpath -m -- "${WT_PATH[$i]}")/" in "$WT_ROOT"/?*) TREES+=("$i") ;; esac
  fi
done
if [ ${#ONLY_RAW[@]} -gt 0 ]; then
  for k in "${!ONLY_RAW[@]}"; do
    matched=false
    for i in "${TREES[@]}"; do
      if [ "$(realpath -m -- "${WT_PATH[$i]}")" = "${ONLY_REAL[$k]}" ]; then
        matched=true
        break
      fi
    done
    if ! $matched; then
      echo "safe-worktree-clean: --only ${ONLY_RAW[$k]}: not a worktree this run judges in $MAIN (agent trees under .claude/worktrees/; --all widens)" >&2
      exit 2
    fi
  done
  only_trees=()
  for i in "${TREES[@]}"; do
    tp=$(realpath -m -- "${WT_PATH[$i]}")
    for op in "${ONLY_REAL[@]}"; do
      if [ "$tp" = "$op" ]; then
        only_trees+=("$i")
        break
      fi
    done
  done
  TREES=("${only_trees[@]}")
fi
declare -A CWD_PID=()
CWD_SCAN_OK=true
if [ ${#TREES[@]} -gt 0 ]; then
  tree_paths=()
  for i in "${TREES[@]}"; do tree_paths+=("$(realpath -m -- "${WT_PATH[$i]}")"); done
  scan=$(proc_scan cwd "${tree_paths[@]}" | tr '\0' '\036') || CWD_SCAN_OK=false
  while IFS= read -r -d $'\036' p && IFS= read -r -d $'\036' pid; do
    CWD_PID[$p]=$pid
  done <<<"$scan"
fi

# Judge every tree; record the verdict.
V_IDX=() V_VERDICT=() V_REASONS=() V_APPROVABLE=() V_ACTION=() V_HOLD_REMOVED=()
for i in "${TREES[@]}"; do
  REASONS=()
  t=${WT_PATH[$i]}
  if [ -n "${WT_PRUNABLE[$i]}" ]; then
    hold prunable "${WT_PRUNABLE[$i]}; the tree is gone, its branch is the owner's call"
  else
    # 1: the lock.
    if ${WT_LOCKED[$i]}; then
      if [[ ${WT_LOCK_REASON[$i]} =~ (^|[^[:alnum:]_])[Pp][Ii][Dd][\ :=]+([0-9]+) ]]; then
        pid=${BASH_REMATCH[2]}
        [ -d "/proc/$pid" ] && hold locked-live "lock pid $pid is alive"
      else
        hold lock-unparsable "lock reason names no pid: '${WT_LOCK_REASON[$i]}'"
      fi
    fi
    # 2: a live cwd.
    if ! $CWD_SCAN_OK; then
      hold proc-unreadable "cannot read /proc to check for processes inside the tree"
    elif [ -n "${CWD_PID[$(realpath -m -- "$t")]:-}" ]; then
      hold live-cwd "pid ${CWD_PID[$(realpath -m -- "$t")]} has its cwd inside the tree"
    fi
    judge_git "$i"
  fi
  V_IDX+=("$i")
  if [ ${#REASONS[@]} -eq 0 ]; then
    V_VERDICT+=(SAFE)
    V_REASONS+=("")
    V_APPROVABLE+=(false)
  else
    V_VERDICT+=(HOLD)
    reasons_str=$(printf '%s\n' "${REASONS[@]}")
    V_REASONS+=("$reasons_str")
    approvable=false
    case "$(realpath -m -- "$t")/" in
      "$WT_ROOT"/?*)
        approvable=true
        for r_entry in "${REASONS[@]}"; do
          case "${r_entry%%$'\t'*}" in
            unmerged | dirty | untracked-new | untracked-differs | ignored | branch-name | detached-unreferenced | worktree-refs | bisect-refs | rewritten-refs) ;;
            *) approvable=false; break ;;
          esac
        done
        if $approvable; then
          if ! unmerged_idx=$(git -C "$t" ls-files -u 2>/dev/null) || [ -n "$unmerged_idx" ]; then
            approvable=false
          fi
        fi
        ;;
    esac
    V_APPROVABLE+=("$approvable")
  fi
  V_ACTION+=("")
  V_HOLD_REMOVED+=(false)
done

# Populate array $1 with each untracked path and each ignored path not accepted by
# is_cache_path/regen_verdict in tree $2 (for an ignored directory, every regular file
# or symlink below it in LC_ALL=C sorted order).
at_risk_files() {
  local -n ar_out=$1
  local t=$2 entry p q rv sub
  local -a st=()
  ar_out=()
  z_list st git -C "$t" status --porcelain=v1 -z --no-renames --ignored=matching --untracked-files=all || return 1
  for entry in "${st[@]}"; do
    case "$entry" in
      "?? "*)
        p=${entry#"?? "}
        q=${p%/}
        if [ -L "$t/$q" ] || [ -f "$t/$q" ]; then
          ar_out+=("$q")
        elif [ -d "$t/$q" ]; then
          while IFS= read -r -d '' sub; do
            ar_out+=("$q/$sub")
          done < <(find "$t/$q" \( -type f -o -type l \) -printf '%P\0' 2>/dev/null | LC_ALL=C sort -z)
        fi
        ;;
      "!! "*)
        p=${entry#"!! "}
        q=${p%/}
        regen_verdict "$t" "$p"
        rv=$?
        if [ "$rv" -eq 0 ] || { [ "$rv" -ne 2 ] && [ ${#CACHE_NAMES[@]} -gt 0 ] && is_cache_path "$t" "$p"; }; then
          continue
        fi
        if [ -L "$t/$q" ] || [ -f "$t/$q" ]; then
          ar_out+=("$q")
        elif [ -d "$t/$q" ]; then
          while IFS= read -r -d '' sub; do
            ar_out+=("$q/$sub")
          done < <(find "$t/$q" \( -type f -o -type l \) -printf '%P\0' 2>/dev/null | LC_ALL=C sort -z)
        fi
        ;;
    esac
  done
  return 0
}

# True when path $2 of tree $1 may go to one `git hash-object --stdin-paths` batch: not a
# symlink, and no newline or CR in it (git strips a trailing CR) and no leading " (git
# C-unquotes such a line, so it would hash a different file). tree_state_sha asks it exactly
# once per non-symlink path while building the per-path read plan (the symlink split happens
# just before the call; the ! -L test below stays as defense for future callers), and both
# the batch filter and the lookup read that plan, so the two cannot drift apart.
batchable_path() {
  [ ! -L "$1/$2" ] && [[ $2 != *$'\n'* ]] && [[ $2 != *$'\r'* ]] && [[ $2 != \"* ]]
}

# sha256 over the tree's restorable state (see the header's plan-id contract). Two invariants:
# one read plan per path (L symlink / B batchable / F per-file hash-object), decided once, so
# a path batched at build time can never be re-judged at lookup time; and every child's exit
# status folded into the hashed stream after its output as a \001<name>=<rc>\0 line (the batch:
# \001batch=<git rc>:<0|1>\0), so a failed child changes the sha — the same inputs with one
# failed child hash differently from a successful read, while an unchanged healthy tree hashes
# identically across runs; folding rcs means a failed child never hashes the same as a
# successful read of the same content, though a DETERMINISTIC failure (e.g. an untracked
# mode-000 file failing per-file hash-object with rc 128 every run) hashes the same on both
# runs, and the judge/backup layers are what catch content hidden that way.
# The stream's field order and sentinels are pinned byte-for-byte by the P38
# and P38b per-file reference formulas (tests/safe-worktree-clean.probe.sh):
# reordering the stream changes this function and both formulas together.
# SYG_WORKTREE_STATE_BATCH_FAIL=1 is a test seam (internal, ignored unless set to exactly 1):
# it skips the hash-object batch child (batch_ok=false, rc_batch=1), forcing the per-file
# fallback.
tree_state_sha() {
  local t=$1 p f_hash batch_out batch_ok=true bi=0 n=0 rc rc_ar=0 rc_batch=0
  local -a risk_files=() batch_paths=() batch_shas=() plan=()
  at_risk_files risk_files "$t" 2>/dev/null || rc_ar=$?
  for p in "${risk_files[@]}"; do
    if [ -L "$t/$p" ]; then
      plan+=(L)
    elif batchable_path "$t" "$p"; then
      plan+=(B)
      batch_paths+=("$p")
    else
      plan+=(F)
    fi
  done
  if [ ${#batch_paths[@]} -gt 0 ]; then
    if [ "${SYG_WORKTREE_STATE_BATCH_FAIL:-}" = 1 ]; then
      batch_ok=false
      rc_batch=1
    elif batch_out=$(printf '%s\n' "${batch_paths[@]}" | git -C "$t" hash-object --no-filters --stdin-paths 2>/dev/null) && [ -n "$batch_out" ]; then
      mapfile -t batch_shas <<<"$batch_out"
      [ ${#batch_shas[@]} -eq ${#batch_paths[@]} ] || batch_ok=false
    else
      rc_batch=$?
      batch_ok=false
    fi
  fi
  {
    printf '\001atrisk=%s\0' "$rc_ar"
    rc=0
    git -C "$t" status --porcelain=v1 -z --ignored --untracked-files=all 2>/dev/null || rc=$?
    printf '\001status=%s\0' "$rc"
    rc=0
    git -C "$t" diff --binary HEAD 2>/dev/null || rc=$?
    printf '\001diff=%s\0' "$rc"
    rc=0
    git -C "$t" diff --binary --cached HEAD 2>/dev/null || rc=$?
    printf '\001diffcached=%s\0' "$rc"
    printf '\001batch=%s:%s\0' "$rc_batch" "$($batch_ok && echo 0 || echo 1)"
    for p in "${risk_files[@]}"; do
      rc=0
      if [ "${plan[n]}" = L ]; then
        f_hash=$(readlink -- "$t/$p" 2>/dev/null) || { rc=$?; f_hash=""; }
      elif [ "${plan[n]}" = B ] && $batch_ok; then
        f_hash=${batch_shas[$bi]}
        bi=$((bi + 1))
      else
        f_hash=$(git -C "$t" hash-object --no-filters -- "$p" 2>/dev/null) || { rc=$?; f_hash=""; }
      fi
      printf '%s\0%s\0' "$p" "$f_hash"
      printf '\001hash=%s\0' "$rc"
      n=$((n + 1))
    done
    rc=0
    git -C "$t" for-each-ref --format='%(objectname) %(refname)' refs/worktree/ refs/bisect/ refs/rewritten/ 2>/dev/null || rc=$?
    printf '\001foreachref=%s\0' "$rc"
  } | sha256sum | cut -d' ' -f1
}

# Plan id over approvable HOLD trees in path order, plus the exact list that id removes
# (PLAN_TREES, printed by the summary line and the JSON) and its commit-carrying trees
# (PLAN_CC: path, commit count beyond BASE, BASE — the --apply-hold naming-refusal input).
rel() { local p; p=$(realpath -m -- "$1"); printf '%s' "${p#"$MAIN"/}"; }
HOLD_PLAN=""
V_HEAD_SHA=() V_STATE_SHA=()
PLAN_TREES=() PLAN_TREES_REL=() PLAN_CC=()
app_lines=()
for k in "${!V_IDX[@]}"; do
  ${V_APPROVABLE[$k]} || continue
  app_lines+=("${WT_PATH[${V_IDX[$k]}]}"$'\t'"$k")
done
if [ ${#app_lines[@]} -gt 0 ]; then
  mapfile -t sorted_app < <(printf '%s\n' "${app_lines[@]}" | LC_ALL=C sort -t $'\t' -k1,1)
  for entry in "${sorted_app[@]}"; do
    k=${entry##*$'\t'}
    i=${V_IDX[$k]}
    t=${WT_PATH[$i]}
    V_HEAD_SHA[k]=$(git -C "$t" rev-parse HEAD 2>/dev/null)
    V_STATE_SHA[k]=$(tree_state_sha "$t")
    PLAN_TREES+=("$t")
    PLAN_TREES_REL+=("$(rel "$t")")
    cc=false
    while IFS=$'\t' read -r cc_code _cc_detail; do
      case $cc_code in
        unmerged | worktree-refs | bisect-refs | rewritten-refs | detached-unreferenced) cc=true ;;
      esac
    done <<<"${V_REASONS[$k]}"
    if $cc; then
      # The refusal line's count: commits the tree's branch (or detached HEAD) holds beyond BASE.
      if [ -n "${WT_BRANCH[$i]}" ]; then
        cc_n=$(git -C "$MAIN" rev-list --count "$BASE..refs/heads/${WT_BRANCH[$i]}" 2>/dev/null)
      else
        cc_n=$(git -C "$MAIN" rev-list --count "$BASE..${V_HEAD_SHA[k]}" 2>/dev/null)
      fi
      [ -n "$cc_n" ] || cc_n=0
      # The count is the branch/HEAD's beyond-base commits, so a tree whose only commit-carrying
      # reason is worktree-refs/bisect-refs/rewritten-refs (orphan commits in per-worktree refs,
      # branch even with BASE) prints "(0 commit(s) not on <base>)" and still refuses — deliberate
      # (the spec pins the branch-count form); it names the tree either way.
      PLAN_CC+=("$t"$'\t'"$cc_n"$'\t'"$BASE")
    fi
  done
  HOLD_PLAN=$(
    for entry in "${sorted_app[@]}"; do
      k=${entry##*$'\t'}
      i=${V_IDX[$k]}
      t=${WT_PATH[$i]}
      b=${WT_BRANCH[$i]}
      sorted_reasons=$(LC_ALL=C sort <<<"${V_REASONS[$k]}")
      printf '%s\0%s\0%s\0%s\0%s\0' "$t" "$b" "${V_HEAD_SHA[$k]}" "$sorted_reasons" "${V_STATE_SHA[$k]}"
    done | sha256sum | cut -c1-12
  )
fi

if [ -n "$APPLY_HOLD" ]; then
  for wt_p in "${WT_PATH[@]}"; do
    wp=$(realpath -m -- "$wt_p")
    if [ "$RUN_DIR" = "$wp" ] || [[ "$RUN_DIR" == "${wp%/}/"* ]]; then
      echo "safe-worktree-clean: backup dir $RUN_DIR is inside $wp; choose SYG_WORKTREE_BACKUP_DIR outside the repo and its worktrees" >&2
      exit 2
    fi
  done
  check_backup_volatile
  if [ -z "$HOLD_PLAN" ] || [ "$APPLY_HOLD" != "$HOLD_PLAN" ]; then
    echo "safe-worktree-clean: hold plan changed: approved $APPLY_HOLD, now ${HOLD_PLAN:-none}; rerun the dry run and get a fresh yes" >&2
    exit 2
  fi
  # Naming refusal (see the header): a matched plan may still carry a commit-carrying tree the
  # invocation did not name. With --only the plan was recomputed over exactly the named trees,
  # so reaching this point unnamed means no --only was given; one line per offending tree,
  # exit 2, nothing removed (SAFE trees included).
  if [ ${#ONLY_RAW[@]} -eq 0 ] && [ ${#PLAN_CC[@]} -gt 0 ]; then
    for cc_entry in "${PLAN_CC[@]}"; do
      cc_t=${cc_entry%%$'\t'*}
      cc_rest=${cc_entry#*$'\t'}
      printf 'safe-worktree-clean: --apply-hold refused: plan %s includes commit-carrying tree %s (%d commit(s) not on %s) — name it with --only to approve its removal\n' \
        "$APPLY_HOLD" "$(rel "$cc_t")" "${cc_rest%%$'\t'*}" "${cc_rest#*$'\t'}" >&2
    done
    exit 2
  fi
fi

BACKUP_ERR=""
BK_DIR=""
backup_tree() {
  local k=$2 t=${WT_PATH[$1]} b=${WT_BRANCH[$1]} head=${WT_HEAD[$1]}
  local repo_base tree_base main_sha err entry p q rv commits_out status_txt head_sha bundle_ref
  local q_main q_bundle q_ref q_reflog q_tgz q_staged restore_git tar_list t_entry reflog_tips="" reflog_only="" reflog_lines="" wt_refs="" wt_sha wt_ref
  local -a ig_status=() tar_excludes=() excluded_entries=() top_entries=() expected_in_tar=() diff_head=()
  local -A in_tar=()
  repo_base=$(basename -- "$MAIN")
  tree_base=$(basename -- "$t")
  main_sha=$(printf '%s\0%s' "$MAIN" "$t" | sha256sum | cut -c1-8)
  BK_DIR="$RUN_DIR/${repo_base}--${tree_base}--${main_sha}"
  if ! err=$(umask 077 && mkdir -p -- "$RUN_DIR" && chmod 0700 "$RUN_DIR" 2>&1); then
    BACKUP_ERR=$err
    return 1
  fi
  if [ -e "$BK_DIR" ] || [ -L "$BK_DIR" ]; then
    BACKUP_ERR="$BK_DIR already exists"
    return 1
  fi
  if ! err=$(umask 077 && mkdir -- "$BK_DIR" && chmod 0700 "$BK_DIR" 2>&1); then
    if [ -e "$BK_DIR" ] || [ -L "$BK_DIR" ]; then
      BACKUP_ERR="$BK_DIR already exists"
    else
      BACKUP_ERR=$err
    fi
    return 1
  fi
  if ! z_list ig_status git -C "$t" status --porcelain=v1 -z --no-renames --ignored=matching --untracked-files=all; then
    BACKUP_ERR="git status --ignored in the tree failed"
    return 1
  fi
  if ! at_risk_files expected_in_tar "$t"; then
    BACKUP_ERR="git status --ignored in the tree failed"
    return 1
  fi
  if ! z_list diff_head git -C "$t" diff --name-only -z --no-renames HEAD; then
    BACKUP_ERR="git diff --name-only HEAD in the tree failed"
    return 1
  fi
  for p in "${diff_head[@]}"; do
    if [ -e "$t/$p" ] || [ -L "$t/$p" ]; then
      expected_in_tar+=("$p")
    fi
  done
  for entry in "${ig_status[@]}"; do
    case "$entry" in "!! "*) ;; *) continue ;; esac
    p=${entry#!! }
    q=${p%/}
    regen_verdict "$t" "$p"
    rv=$?
    if [ "$rv" -eq 0 ] || { [ "$rv" -ne 2 ] && [ ${#CACHE_NAMES[@]} -gt 0 ] && is_cache_path "$t" "$p"; }; then
      tar_excludes+=("--exclude=$q")
      excluded_entries+=("$q")
    fi
  done
  while IFS= read -r -d '' entry; do
    entry=${entry#./}
    [ "$entry" = "." ] || [ "$entry" = ".git" ] && continue
    top_entries+=("$entry")
  done < <(find "$t" -mindepth 1 -maxdepth 1 -printf '%P\0' 2>/dev/null)
  if [ ${#top_entries[@]} -gt 0 ]; then
    if ! err=$(umask 077 && tar -C "$t" --anchored --no-wildcards "${tar_excludes[@]}" \
      -czf "$BK_DIR/tree.tgz" -- "${top_entries[@]}" 2>&1); then
      BACKUP_ERR="tar failed: $err"
      return 1
    fi
  else
    if ! err=$(umask 077 && tar -C "$t" -czf "$BK_DIR/tree.tgz" --files-from=/dev/null 2>&1); then
      BACKUP_ERR="tar failed: $err"
      return 1
    fi
  fi
  chmod 0600 "$BK_DIR/tree.tgz" 2>/dev/null || true

  if ! commits_out=$(git -C "$t" log --oneline "$BASE..HEAD" 2>&1); then
    BACKUP_ERR="git log failed: $commits_out"
    return 1
  fi
  bundle_ref=${b:+refs/heads/$b}
  bundle_ref=${bundle_ref:-HEAD}
  if [ -n "$commits_out" ]; then
    if ! err=$(umask 077 && git -C "$t" bundle create "$BK_DIR/branch.bundle" "$BASE..$bundle_ref" 2>&1); then
      BACKUP_ERR="git bundle create failed: $err"
      return 1
    fi
    chmod 0600 "$BK_DIR/branch.bundle" 2>/dev/null || true
  fi

  if ! wt_refs=$(git -C "$t" for-each-ref --format='%(objectname) %(refname)' refs/worktree/ refs/bisect/ refs/rewritten/ 2>&1); then
    BACKUP_ERR="git for-each-ref for per-worktree refs failed: $wt_refs"
    return 1
  fi
  reflog_tips=$(
    {
      git -C "$t" rev-list --walk-reflogs HEAD 2>/dev/null || true
      if [ -n "$b" ]; then
        git -C "$t" rev-list --walk-reflogs "refs/heads/$b" 2>/dev/null || true
      fi
      if [ -n "$wt_refs" ]; then
        while IFS=' ' read -r wt_sha wt_ref; do
          [ -n "$wt_sha" ] || continue
          printf '%s\n' "$wt_sha"
          git -C "$t" rev-list --walk-reflogs "$wt_ref" 2>/dev/null || true
        done <<<"$wt_refs"
      fi
    } | LC_ALL=C sort -u
  )
  if [ -n "$reflog_tips" ]; then
    if ! reflog_only=$(git -C "$t" rev-list --stdin "^$BASE" "^$bundle_ref" <<<"$reflog_tips" 2>&1); then
      BACKUP_ERR="git rev-list for reflogs failed: $reflog_only"
      return 1
    fi
  fi
  if [ -n "$reflog_only" ]; then
    if ! reflog_lines=$(git -C "$t" log --no-walk --stdin --format='%H %s' <<<"$reflog_only" 2>&1); then
      BACKUP_ERR="git log for reflogs failed: $reflog_lines"
      return 1
    fi
    if ! (
      umask 077
      git -C "$t" rev-list --objects --stdin "^$BASE" <<<"$reflog_only" \
        | git -C "$t" pack-objects -q --stdout >"$BK_DIR/reflog.pack"
    ) 2>"$BK_DIR/.err"; then
      BACKUP_ERR="reflog.pack failed: $(cat "$BK_DIR/.err" 2>/dev/null)"
      rm -f "$BK_DIR/.err"
      return 1
    fi
    rm -f "$BK_DIR/.err"
    chmod 0600 "$BK_DIR/reflog.pack" 2>/dev/null || true
  fi

  if ! (umask 077 && git -C "$t" diff --binary HEAD >"$BK_DIR/uncommitted.patch" 2>"$BK_DIR/.err"); then
    BACKUP_ERR="git diff failed: $(cat "$BK_DIR/.err" 2>/dev/null)"
    rm -f "$BK_DIR/.err"
    return 1
  fi
  rm -f "$BK_DIR/.err"
  chmod 0600 "$BK_DIR/uncommitted.patch" 2>/dev/null || true

  if ! (umask 077 && git -C "$t" diff --binary --cached HEAD >"$BK_DIR/staged.patch" 2>"$BK_DIR/.err"); then
    BACKUP_ERR="git diff --cached failed: $(cat "$BK_DIR/.err" 2>/dev/null)"
    rm -f "$BK_DIR/.err"
    return 1
  fi
  rm -f "$BK_DIR/.err"
  chmod 0600 "$BK_DIR/staged.patch" 2>/dev/null || true

  if ! status_txt=$(git -C "$t" status --porcelain=v1 --ignored --untracked-files=all 2>&1); then
    BACKUP_ERR="git status failed: $status_txt"
    return 1
  fi
  if ! (
    umask 077
    {
      printf '=== HOLD reasons ===\n'
      while IFS=$'\t' read -r code detail; do
        printf 'HOLD:%s  %s\n' "$code" "$detail"
      done <<<"${V_REASONS[$k]}"
      printf '\n=== Commits (%s..HEAD) ===\n' "$BASE"
      if [ -n "$commits_out" ]; then
        printf '%s\n' "$commits_out"
      else
        printf 'no commits beyond %s\n' "$BASE"
      fi
      printf '\n=== Commits only in reflogs or per-worktree refs (in reflog.pack) ===\n'
      if [ -n "$reflog_lines" ]; then
        printf '%s\n' "$reflog_lines"
      else
        printf 'none\n'
      fi
      printf '\n=== Per-worktree refs (refs/worktree/*, refs/bisect/*, refs/rewritten/*) ===\n'
      if [ -n "$wt_refs" ]; then
        printf '%s\n' "$wt_refs"
      else
        printf 'none\n'
      fi
      printf '\n=== Status ===\n'
      [ -z "$status_txt" ] || printf '%s\n' "$status_txt"
      printf '\n=== Excluded as cache/regenerable (not in tree.tgz) ===\n'
      if [ ${#excluded_entries[@]} -gt 0 ]; then
        printf '%s\n' "${excluded_entries[@]}"
      else
        printf 'none\n'
      fi
    } >"$BK_DIR/changes.txt"
  ) 2>"$BK_DIR/.err"; then
    BACKUP_ERR="writing changes.txt failed: $(cat "$BK_DIR/.err" 2>/dev/null)"
    rm -f "$BK_DIR/.err"
    return 1
  fi
  rm -f "$BK_DIR/.err"
  chmod 0600 "$BK_DIR/changes.txt" 2>/dev/null || true

  if ! tar_list=$(tar --quoting-style=literal -tzf "$BK_DIR/tree.tgz" 2>"$BK_DIR/.err"); then
    BACKUP_ERR="tar verify failed: $(cat "$BK_DIR/.err" 2>/dev/null)"
    rm -f "$BK_DIR/.err"
    return 1
  fi
  rm -f "$BK_DIR/.err"
  while IFS= read -r t_entry; do
    [ -n "$t_entry" ] || continue
    in_tar[$t_entry]=1
    in_tar[${t_entry%/}]=1
  done <<<"$tar_list"
  for p in "${expected_in_tar[@]}"; do
    if [ -z "${in_tar[$p]+set}" ]; then
      BACKUP_ERR="tree.tgz lacks $p"
      return 1
    fi
  done
  if [ -f "$BK_DIR/branch.bundle" ]; then
    if ! err=$(git -C "$t" bundle verify "$BK_DIR/branch.bundle" 2>&1 >/dev/null); then
      BACKUP_ERR="bundle verify failed: $err"
      return 1
    fi
  fi
  if [ -f "$BK_DIR/reflog.pack" ]; then
    if ! err=$(umask 077 && git -C "$t" index-pack -o "$BK_DIR/reflog.idx" "$BK_DIR/reflog.pack" 2>&1 >/dev/null); then
      BACKUP_ERR="reflog.pack verify failed: $err"
      return 1
    fi
    chmod 0600 "$BK_DIR/reflog.idx" 2>/dev/null || true
    [ ! -f "$BK_DIR/reflog.rev" ] || chmod 0600 "$BK_DIR/reflog.rev" 2>/dev/null || true
  fi

  head_sha=$(git -C "$t" rev-parse HEAD 2>/dev/null) || head_sha=$head
  printf -v q_main '%q' "$MAIN"
  printf -v q_bundle '%q' "$BK_DIR/branch.bundle"
  printf -v q_ref '%q' "${b:-HEAD}:${b:-restored-worktree}"
  printf -v q_reflog '%q' "$BK_DIR/reflog.pack"
  printf -v q_tgz '%q' "$BK_DIR/tree.tgz"
  printf -v q_staged '%q' "$BK_DIR/staged.patch"
  if [ -f "$BK_DIR/branch.bundle" ]; then
    restore_git="  git -C $q_main fetch $q_bundle $q_ref"
  else
    restore_git="  no branch.bundle: no commits beyond $BASE"
  fi
  if [ -f "$BK_DIR/reflog.pack" ]; then
    restore_git+=$'\n'"  git -C $q_main index-pack --stdin --fix-thin < $q_reflog  # then: git -C $q_main branch <name> <sha from changes.txt>"
  fi
  # The per-worktree ref namespaces die with the tree; the hint stands alone (reflog.pack is
  # omitted when every tip sits on <base>, yet the refs still need recreating).
  if [ -n "$wt_refs" ]; then
    restore_git+=$'\n'"  # refs/worktree/*, refs/bisect/* and refs/rewritten/* die with the tree; recreate each: git -C $q_main update-ref <refname> <sha from changes.txt>"
  fi
  if ! (
    umask 077
    cat >"$BK_DIR/README.txt" <<EOF
repo: $MAIN
tree: $t
branch: ${b:-detached}
HEAD: $head_sha
base: $BASE

Restore:
$restore_git
  git -C <tree or new worktree> apply --index $q_staged
  tar -xzf $q_tgz -C <dest>
EOF
  ) 2>"$BK_DIR/.err"; then
    BACKUP_ERR="writing README.txt failed: $(cat "$BK_DIR/.err" 2>/dev/null)"
    rm -f "$BK_DIR/.err"
    return 1
  fi
  rm -f "$BK_DIR/.err"
  chmod 0600 "$BK_DIR/README.txt" 2>/dev/null || true
  return 0
}

# Apply: each SAFE tree independently (and with --apply-hold, each approvable HOLD tree after
# a verified backup); a failed step stops that tree only.
rc=0
removed=0
backed_up=0
if $APPLY; then
  for k in "${!V_IDX[@]}"; do
    [ "${V_VERDICT[$k]}" = SAFE ] || continue
    i=${V_IDX[$k]} t=${WT_PATH[${V_IDX[$k]}]} b=${WT_BRANCH[${V_IDX[$k]}]}
    if ${WT_LOCKED[$i]} && ! err=$(git -C "$MAIN" worktree unlock "$t" 2>&1); then
      V_ACTION[k]="failed: unlock: ${err//$'\n'/ }"; rc=3; continue
    fi
    if ! err=$(git -C "$MAIN" worktree remove --force "$t" 2>&1); then
      V_ACTION[k]="failed: remove: ${err//$'\n'/ }"; rc=3; continue
    fi
    removed=$((removed + 1))
    if [ -n "$b" ] && ! err=$(git -C "$MAIN" branch -D "$b" 2>&1); then
      V_ACTION[k]="removed; branch delete failed: ${err//$'\n'/ }"; rc=3; continue
    fi
    V_ACTION[k]="removed${b:+, branch $b deleted}"
  done
  if [ -n "$APPLY_HOLD" ]; then
    for k in "${!V_IDX[@]}"; do
      ${V_APPROVABLE[$k]} || continue
      i=${V_IDX[$k]} t=${WT_PATH[$i]} b=${WT_BRANCH[$i]}
      if ! backup_tree "$i" "$k"; then
        V_ACTION[k]="failed: backup: ${BACKUP_ERR//$'\n'/ }"; rc=3; continue
      fi
      backed_up=$((backed_up + 1))
      live_pid=""
      cwd_ok=true
      cwd_scan=$(proc_scan cwd "$t" | tr '\0' '\036') || cwd_ok=false
      while IFS= read -r -d $'\036' _p && IFS= read -r -d $'\036' _pid; do
        live_pid=$_pid
      done <<<"$cwd_scan"
      if [ -n "$live_pid" ]; then
        V_ACTION[k]="backed up to $BK_DIR; kept: pid $live_pid has its cwd inside the tree"; rc=3; continue
      fi
      now_head=$(git -C "$t" rev-parse HEAD 2>/dev/null)
      now_state=$(tree_state_sha "$t")
      if ! $cwd_ok || [ "$now_head" != "${V_HEAD_SHA[$k]}" ] || [ "$now_state" != "${V_STATE_SHA[$k]}" ]; then
        V_ACTION[k]="backed up to $BK_DIR; kept: tree changed during backup"; rc=3; continue
      fi
      now_porcelain=$(git -C "$MAIN" worktree list --porcelain -z 2>/dev/null | tr '\0' '\036') || now_porcelain=""
      now_locked=false now_lock_reason="" in_target=false found_target=false
      while IFS= read -r -d $'\036' f; do
        case "$f" in
          "worktree "*)
            if [ "${f#worktree }" = "$t" ]; then
              in_target=true found_target=true
            else
              in_target=false
            fi
            ;;
          locked) $in_target && now_locked=true ;;
          "locked "*)
            if $in_target; then
              now_locked=true
              now_lock_reason=${f#locked }
            fi
            ;;
        esac
      done <<<"$now_porcelain"
      lock_changed=false
      if ! $found_target; then
        lock_changed=true
      elif $now_locked; then
        if ! ${WT_LOCKED[$i]}; then
          lock_changed=true
        elif [[ $now_lock_reason =~ (^|[^[:alnum:]_])[Pp][Ii][Dd][\ :=]+([0-9]+) ]]; then
          [ -d "/proc/${BASH_REMATCH[2]}" ] && lock_changed=true
        else
          lock_changed=true
        fi
      fi
      if $lock_changed; then
        V_ACTION[k]="backed up to $BK_DIR; kept: tree locked during backup"; rc=3; continue
      fi
      if $now_locked && ! err=$(git -C "$MAIN" worktree unlock "$t" 2>&1); then
        V_ACTION[k]="backed up to $BK_DIR; failed: unlock: ${err//$'\n'/ }"; rc=3; continue
      fi
      if ! err=$(git -C "$MAIN" worktree remove --force "$t" 2>&1); then
        V_ACTION[k]="backed up to $BK_DIR; failed: remove: ${err//$'\n'/ }"; rc=3; continue
      fi
      V_HOLD_REMOVED[k]=true
      removed=$((removed + 1))
      if [ -n "$b" ] && ! err=$(git -C "$MAIN" branch -D "$b" 2>&1); then
        V_ACTION[k]="backed up to $BK_DIR; removed; branch delete failed: ${err//$'\n'/ }"; rc=3; continue
      fi
      V_ACTION[k]="backed up to $BK_DIR; removed${b:+, branch $b deleted}"
    done
  fi
  [ "$removed" -eq 0 ] || git -C "$MAIN" worktree prune >/dev/null 2>&1 || rc=3
  [ "$removed" -gt 0 ] || [ "$rc" -ne 0 ] || rc=1
fi

# Locks: the main .git and every worktree's git dir.
L_PATH=() L_VERDICT=() L_DETAIL=() L_ACTION=()
if $LOCKS; then
  repo_paths=("$MAIN" "$COMMON")
  for i in $(seq 1 "$cur"); do repo_paths+=("$(realpath -m -- "${WT_PATH[$i]}")"); done
  git_live=$(proc_scan git "${repo_paths[@]}" | tr '\0' ' ')
  git_scan_rc=$?
  now=$(date +%s)
  shopt -s nullglob
  for l in "$COMMON/index.lock" "$COMMON"/worktrees/*/index.lock; do
    [ -e "$l" ] || continue
    L_PATH+=("$l")
    L_ACTION+=("")
    mtime=$(stat -c %Y -- "$l" 2>/dev/null) || mtime=$now
    age=$(((now - mtime) / 60))
    if [ -s "$l" ]; then
      L_VERDICT+=(HOLD:nonempty); L_DETAIL+=("$(stat -c %s -- "$l") bytes")
    elif [ $((now - mtime)) -le $((AGE_MIN * 60)) ]; then
      L_VERDICT+=(HOLD:fresh); L_DETAIL+=("${age} min old, stale after $AGE_MIN")
    elif [ "$git_scan_rc" -ne 0 ]; then
      L_VERDICT+=(HOLD:proc-unreadable); L_DETAIL+=("cannot read /proc to check for live git")
    elif [ -n "$git_live" ]; then
      L_VERDICT+=(HOLD:git-live); L_DETAIL+=("live git pid(s) in the repo: ${git_live% }")
    else
      L_VERDICT+=(STALE); L_DETAIL+=("0 bytes, ${age} min old, no live git")
    fi
  done
  shopt -u nullglob
  if $LOCKS_APPLY; then
    for k in "${!L_PATH[@]}"; do
      [ "${L_VERDICT[$k]}" = STALE ] || continue
      if err=$(rm -f -- "${L_PATH[$k]}" 2>&1); then L_ACTION[k]=deleted; else
        L_ACTION[k]="failed: ${err//$'\n'/ }"; rc=3; fi
    done
  fi
fi

if $JSON; then
  trees_wire=""
  for p in "${PLAN_TREES[@]}"; do trees_wire+="$p"$'\x1e'; done
  cc_wire=""
  for cc_entry in "${PLAN_CC[@]}"; do
    cc_t=${cc_entry%%$'\t'*}
    cc_rest=${cc_entry#*$'\t'}
    cc_wire+="$cc_t"$'\x1f'"${cc_rest%%$'\t'*}"$'\x1f'"${cc_rest#*$'\t'}"$'\x1e'
  done
  {
    printf '%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0' "$MAIN" "$BASE" "$APPLY" "$LOCKS" "$HOLD_PLAN" \
      "$trees_wire" "$cc_wire" "${#V_IDX[@]}"
    for k in "${!V_IDX[@]}"; do
      i=${V_IDX[$k]}
      printf '%s\0%s\0%s\0%s\0%s\0%s\0' "${WT_PATH[$i]}" "${WT_BRANCH[$i]}" "${V_VERDICT[$k]}" \
        "${V_APPROVABLE[$k]}" "${V_REASONS[$k]}" "${V_ACTION[$k]}"
    done
    for k in "${!L_PATH[@]}"; do
      printf '%s\0%s\0%s\0%s\0' "${L_PATH[$k]}" "${L_VERDICT[$k]}" "${L_DETAIL[$k]}" "${L_ACTION[$k]}"
    done
  } | python3 -c '
import json, sys
f = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").split("\0")[:-1]
repo, base, apply_, locks, hold_plan, trees_raw, cc_raw, n = f[:8]
f = f[8:]
hold_plan_trees = [x for x in trees_raw.split("\x1e") if x]
hold_plan_cc = []
for e in cc_raw.split("\x1e"):
    if not e:
        continue
    pth, cnt, bs = e.split("\x1f")
    hold_plan_cc.append({"path": pth, "commits": int(cnt), "base": bs})
trees = []
for k in range(int(n)):
    path, branch, verdict, approvable, reasons, action = f[6 * k:6 * k + 6]
    trees.append({"path": path, "branch": branch or None, "verdict": verdict,
                  "approvable": approvable == "true",
                  "reasons": [dict(zip(("code", "detail"), r.split("\t", 1)))
                              for r in reasons.splitlines()],
                  "action": action or None})
f = f[6 * int(n):]
lks = [{"path": f[i], "verdict": f[i + 1], "detail": f[i + 2], "action": f[i + 3] or None}
       for i in range(0, len(f), 4)]
out = {"repo": repo, "base": base or None, "apply": apply_ == "true",
       "hold_plan": hold_plan or None, "hold_plan_trees": hold_plan_trees,
       "hold_plan_commit_carrying": hold_plan_cc, "worktrees": trees}
if locks == "true":
    out["locks"] = lks
print(json.dumps(out, indent=2))
'
  exit $rc
fi

echo "repo: $MAIN  base: ${BASE:-none}  $($ALL && echo 'worktrees judged' || echo 'agent worktrees'): ${#V_IDX[@]}$($APPLY || echo '  (dry run; --apply removes the SAFE ones)')"
nhold=0
nhold_removed=0
for k in "${!V_IDX[@]}"; do
  i=${V_IDX[$k]}
  if [ "${V_VERDICT[$k]}" = SAFE ]; then
    printf 'SAFE  %s  [%s]%s\n' "$(rel "${WT_PATH[$i]}")" "${WT_BRANCH[$i]:-detached}" \
      "${V_ACTION[$k]:+  ${V_ACTION[$k]}}"
  elif ${V_HOLD_REMOVED[$k]}; then
    nhold_removed=$((nhold_removed + 1))
  else
    nhold=$((nhold + 1))
  fi
done
if [ "$nhold_removed" -gt 0 ]; then
  echo "HOLD removed after backup: $nhold_removed tree(s)"
  for k in "${!V_IDX[@]}"; do
    ${V_HOLD_REMOVED[$k]} || continue
    i=${V_IDX[$k]}
    printf '  %s  [%s]  %s\n' "$(rel "${WT_PATH[$i]}")" "${WT_BRANCH[$i]:-detached}" "${V_ACTION[$k]}"
  done
fi
if [ "$nhold" -gt 0 ]; then
  echo "HOLD report: $nhold tree(s) left in place"
  for k in "${!V_IDX[@]}"; do
    if [ "${V_VERDICT[$k]}" != HOLD ] || ${V_HOLD_REMOVED[$k]}; then continue; fi
    i=${V_IDX[$k]}
    printf '  %s  [%s]%s\n' "$(rel "${WT_PATH[$i]}")" "${WT_BRANCH[$i]:-detached}" \
      "${V_ACTION[$k]:+  ${V_ACTION[$k]}}"
    while IFS=$'\t' read -r code detail; do
      printf '    HOLD:%s  %s\n' "$code" "$detail"
    done <<<"${V_REASONS[$k]}"
  done
  if [ -n "$HOLD_PLAN" ] && [ -z "$APPLY_HOLD" ]; then
    for k in "${!V_IDX[@]}"; do
      ${V_APPROVABLE[$k]} || continue
      printf '  approvable with --apply-hold: %s\n' "$(rel "${WT_PATH[${V_IDX[$k]}]}")"
    done
    [ ${#PLAN_TREES_REL[@]} -eq 0 ] || plan_summary_line "hold plan $HOLD_PLAN" "${PLAN_TREES_REL[@]}"
    echo "hold plan: $HOLD_PLAN"
  fi
fi
if [ -z "${SYG_WORKTREE_SWEEP_CHILD:-}" ] && [ "$backed_up" -gt 0 ]; then
  echo "backups: $RUN_DIR"
fi
if $APPLY && [ "$removed" -eq 0 ] && [ "$rc" -eq 1 ]; then echo "nothing removed: no SAFE tree"; fi
if $LOCKS; then
  if [ ${#L_PATH[@]} -eq 0 ]; then
    echo "locks: no index.lock files"
  else
    echo "locks (stale = 0 bytes, older than $AGE_MIN min, no live git in the repo):"
    for k in "${!L_PATH[@]}"; do
      printf '  %s  %s  (%s)%s\n' "${L_VERDICT[$k]}" "${L_PATH[$k]}" "${L_DETAIL[$k]}" \
        "${L_ACTION[$k]:+  ${L_ACTION[$k]}}"
    done
  fi
fi
exit $rc
