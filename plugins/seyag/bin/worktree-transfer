#!/bin/bash
# worktree-transfer - transfer a delegation worker's uncommitted worktree changes into the main tree, verify byte-identity, and remove the worktree and branch
#
# Usage:
#   worktree-transfer [--base SHA] [--rebase-base] <worktree-path>
#
# Run from the MAIN working tree, never from inside the transferred worktree.
# Stages everything the worker left uncommitted in <worktree-path> into one
# binary-capable patch file, verifies the no-commit contract and worktree state,
# applies the patch to the main tree's index and working tree, verifies
# byte-identity against the main tree's staged diff, and removes the worktree
# and its agent branch. Local git only; no network calls.
#
# Checks run in a FIXED order; the first failure refuses with one line
# `STOP: <check-name>: <reason>` on stderr and exits 1, and nothing after the
# failed check runs. Every check before `apply` is read-only or touches only
# the worktree; `apply` is the first write to the main tree; `removal` runs
# only after every prior check has passed:
#   1 main-tree-identity    `git rev-parse --show-toplevel` in the invoking cwd
#                           equals the first `worktree ` line of
#                           `git worktree list --porcelain` (the main working tree)
#                           and HEAD is on a branch (`symbolic-ref` resolves —
#                           a detached main refuses)
#   2 main-tree-clean       `git status --porcelain --untracked-files=all` in the main
#                           root prints nothing (the flag pins it against
#                           status.showUntrackedFiles=no)
#   3 worktree-registered   resolved <worktree-path> appears in the porcelain
#                           listing with a `branch refs/heads/<name>` line (detached
#                           trees refuse) matching SYG_WORKTREE_BRANCH_RE
#   4 worktree-gitfile      `worktree-gitfile-check --repo <main> <wt>` verifies
#                           `<wt>/.git` is a regular file pointing to its own
#                           `<main>/.git/worktrees/<id>` entry (with `commondir` and
#                           `gitdir` pointing back), no nested `.git` exists below
#                           `<wt>` other than gitfiles pointing under `<entry>/modules/`,
#                           and no directory below `<wt>` holds `HEAD` with `objects`,
#                           `refs`, or `commondir` before any `git -C <wt>` runs
#   5 base-unchanged        when --base SHA is given, `<sha>^{commit}` resolves and
#                           equals the main tree's HEAD, or under --rebase-base the
#                           worktree's HEAD (the dispatch base; skipped when
#                           omitted); a worktree HEAD that does not resolve also refuses base-unchanged
#   6 no-unpushed-base      worktree HEAD equals the main tree's HEAD (ahead is as
#                           wrong as behind; runs before the patch is built; when
#                           main is an ancestor of worktree HEAD, the behind-main
#                           hint replaces the --rebase-base suggestion); under
#                           --rebase-base, deferred to check 9 `rebase-proof`
#   7 empty-patch           `git -C <wt> add -A` then `git -C <wt> diff --cached --binary`
#                           written to a temp file is non-empty
#   8 nothing-outside-patch no `git -C <wt> ls-files -v` entry is assume-unchanged
#                           (lowercase tag) or skip-worktree (`S`) on disk, every
#                           staged gitlink (`160000`) commit resolves in the main
#                           repo or its submodule, and every non-empty
#                           `git -C <wt> status --porcelain` line after staging
#                           matches `^[MADRCT] `
#   9 rebase-proof          under --rebase-base (skipped otherwise), finds every
#                           merge-base of worktree HEAD and main HEAD and verifies
#                           that no path in G (paths the worktree's branch changed
#                           since any merge-base union the patch's paths from
#                           RAW_DIFF) conflicts with any path in X (paths differing
#                           between worktree HEAD and main HEAD), including
#                           file-vs-directory prefix boundaries, then prints the
#                           proof line on success; check 11 `byte-identical`
#                           remains the backstop, so rebase-proof is an early
#                           refusal with a readable proof, not the only guard. A
#                           main HEAD that is an ancestor of worktree HEAD refuses
#                           first with a pull-or-land hint; conflict refusals
#                           attribute each path to main or the worktree's branch
#  10 apply                 `git apply --index <patchfile>` in the main root succeeds
#  11 byte-identical        `git diff --cached --binary` in the main root matches
#                           `<patchfile>` via `cmp`; `--binary` must appear on BOTH
#                           sides because a plain diff renders a binary change as a
#                           notice `git apply` fails to consume — as must --no-color
#                           --no-ext-diff and the a/ b/ prefixes, so user diff config
#                           (diff.noprefix, diff.external, color.ui) cannot change
#                           what either side produces (a mismatch leaves the main
#                           tree staged for inspection)
#  12 removal               `git worktree unlock <wt>`, `git worktree remove --force <wt>`,
#                           then — re-checking SYG_WORKTREE_BRANCH_RE at the removal
#                           site — `git branch -D <branch>`, then `git worktree prune`
#
# Branch regex: SYG_WORKTREE_BRANCH_RE (extended regex applied with `[[ $b =~ $re ]]`),
# shared with safe-worktree-clean check 6. Unset or set-but-empty both fall back to
# `^worktree-agent-`. An invalid regex refuses (`not a valid extended regex`) without
# deleting anything.
#
# Stated non-goal: the two removal-failure wordings (`git worktree remove --force` vs
# `git branch -D`) are best-effort operator messages; a refusal at check 12 never
# loses the patch because it is already applied and verified in the main tree.
#
# Exit codes: 0 success; 1 refusal (`STOP: <check-name>: <reason>`); 2 usage error.
#
# Fixture check: run tests/worktree-transfer.probe.sh after ANY edit.

set -uo pipefail

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

refuse() {
  local check=$1 reason=$2
  reason=${reason//$'\n'/ }
  printf 'STOP: %s: %s\n' "$check" "$reason" >&2
  exit 1
}

BASE_ARG=""
BASE_GIVEN=false
REBASE_BASE=false
POSITIONALS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --base)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      [ -n "$2" ] || { usage >&2; exit 2; }
      BASE_ARG=$2
      BASE_GIVEN=true
      shift
      ;;
    --base=*)
      BASE_ARG=${1#--base=}
      [ -n "$BASE_ARG" ] || { usage >&2; exit 2; }
      BASE_GIVEN=true
      ;;
    --rebase-base)
      REBASE_BASE=true
      ;;
    --)
      shift
      while [ $# -gt 0 ]; do
        POSITIONALS+=("$1")
        shift
      done
      break
      ;;
    -*)
      usage >&2
      exit 2
      ;;
    *)
      POSITIONALS+=("$1")
      ;;
  esac
  shift
done

if [ ${#POSITIONALS[@]} -ne 1 ] || [ -z "${POSITIONALS[0]}" ]; then
  usage >&2
  exit 2
fi

WT_PATH=$(realpath -m -- "${POSITIONALS[0]}" 2>/dev/null) || {
  usage >&2
  exit 2
}

BRANCH_RE=${SYG_WORKTREE_BRANCH_RE:-}
[ -n "$BRANCH_RE" ] || BRANCH_RE='^worktree-agent-'

# Match branch $1 against BRANCH_RE. Returns 0 on match, 1 on mismatch, 2 on invalid regex.
match_branch_re() {
  local b=$1 re_rc
  [[ "" =~ $BRANCH_RE ]] 2>/dev/null
  # shellcheck disable=SC2319 # exit status 2 from [[ =~ ]] indicates an invalid extended regex
  re_rc=$?
  if [ "$re_rc" -gt 1 ]; then
    return 2
  fi
  [[ $b =~ $BRANCH_RE ]] 2>/dev/null
}

z_list() {
  local -n z_arr=$1
  shift
  mapfile -d '' z_arr < <("$@"; printf '\001rc=%s\0' "$?")
  local last=${z_arr[-1]:-}
  unset 'z_arr[-1]'
  [ "$last" = $'\001rc=0' ]
}

TMP_DIR=""
trap '[ -z "$TMP_DIR" ] || rm -rf -- "$TMP_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

SELF_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
PASSED_CHECKS=()

# 1. main-tree-identity
MAIN_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) \
  || refuse main-tree-identity "not inside a git working tree"
[ -n "$MAIN_ROOT" ] || refuse main-tree-identity "not inside a git working tree"
MAIN_ROOT=$(realpath -m -- "$MAIN_ROOT")
PORCELAIN=$(git -C "$MAIN_ROOT" worktree list --porcelain 2>/dev/null) \
  || refuse main-tree-identity "git worktree list --porcelain failed in $MAIN_ROOT"

FIRST_WT=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*)
      FIRST_WT=$(realpath -m -- "${line#worktree }")
      break
      ;;
  esac
done <<<"$PORCELAIN"

if [ -z "$FIRST_WT" ] || [ "$FIRST_WT" != "$MAIN_ROOT" ]; then
  refuse main-tree-identity "must run from the main working tree ($FIRST_WT), not a linked worktree ($MAIN_ROOT)"
fi
[ -n "$(git -C "$MAIN_ROOT" symbolic-ref -q --short HEAD)" ] \
  || refuse main-tree-identity "main working tree is detached (the staged unit would sit on no branch)"
PASSED_CHECKS+=("main-tree-identity")

# 2. main-tree-clean
MAIN_STATUS=$(git -C "$MAIN_ROOT" status --porcelain --untracked-files=all 2>&1) \
  || refuse main-tree-clean "git status --porcelain failed: $MAIN_STATUS"
if [ -n "$MAIN_STATUS" ]; then
  refuse main-tree-clean "main working tree is not clean"
fi
PASSED_CHECKS+=("main-tree-clean")

# 3. worktree-registered
WT_FOUND=false
WT_BRANCH=""
WT_DETACHED=false
cur_wt=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*)
      cur_wt=$(realpath -m -- "${line#worktree }")
      if [ "$cur_wt" = "$WT_PATH" ]; then
        WT_FOUND=true
      fi
      ;;
    "branch refs/heads/"*)
      if [ "$cur_wt" = "$WT_PATH" ]; then
        WT_BRANCH=${line#branch refs/heads/}
      fi
      ;;
    detached)
      if [ "$cur_wt" = "$WT_PATH" ]; then
        WT_DETACHED=true
      fi
      ;;
    "")
      cur_wt=""
      ;;
  esac
done <<<"$PORCELAIN"

if ! $WT_FOUND; then
  refuse worktree-registered "path is not a registered linked worktree: $WT_PATH"
elif [ "$WT_PATH" = "$MAIN_ROOT" ]; then
  refuse worktree-registered "$WT_PATH is the main working tree itself; pass the worker worktree's path"
elif [ ! -d "$WT_PATH" ]; then
  refuse worktree-registered "registered worktree's directory is missing: $WT_PATH"
fi
if $WT_DETACHED || [ -z "$WT_BRANCH" ]; then
  refuse worktree-registered "worktree at $WT_PATH is detached (there is no branch to delete)"
fi

match_branch_re "$WT_BRANCH"
case $? in
  0) ;;
  1) refuse worktree-registered "branch '$WT_BRANCH' does not match $BRANCH_RE (removal/deletion is sanctioned only for agent worktree branches)" ;;
  *) refuse worktree-registered "SYG_WORKTREE_BRANCH_RE is not a valid extended regex (unusable): $BRANCH_RE" ;;
esac
PASSED_CHECKS+=("worktree-registered")

# 4. worktree-gitfile
if ! gf_err=$(bash "$SELF_DIR/worktree-gitfile-check" --repo "$MAIN_ROOT" "$WT_PATH" 2>&1); then
  refuse worktree-gitfile "${gf_err#"worktree-gitfile-check: REFUSED: $WT_PATH: "}"
fi
PASSED_CHECKS+=("worktree-gitfile")

behind_hint() {
  local ahead=$1 label=$2 up_sha up_name
  if [ "$MAIN_HEAD" = "$ahead" ] || ! git -C "$MAIN_ROOT" merge-base --is-ancestor "$MAIN_HEAD" "$ahead" 2>/dev/null; then
    return 1
  fi
  if up_sha=$(git -C "$MAIN_ROOT" rev-parse --verify -q '@{upstream}^{commit}' 2>/dev/null) \
    && [ -n "$up_sha" ] \
    && git -C "$MAIN_ROOT" merge-base --is-ancestor "$ahead" "$up_sha" 2>/dev/null \
    && up_name=$(git -C "$MAIN_ROOT" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) \
    && [ -n "$up_name" ]; then
    printf 'main HEAD is behind %s and its upstream %s already has %s: run git pull --ff-only in the main tree, then rerun' "$label" "$up_name" "$label"
  else
    local wc_note=""
    [ "$label" = "worktree HEAD" ] && wc_note=" (a worker commit?)"
    printf 'main HEAD is behind %s: %s has commit(s) main lacks%s; land them on main first, --rebase-base cannot transfer onto a main that lacks them' "$label" "$label" "$wc_note"
  fi
  return 0
}

join_first_5() {
  local joined="" limit=$# i=0 item
  [ "$limit" -gt 5 ] && limit=5
  for item in "$@"; do
    [ "$i" -lt "$limit" ] || break
    if [ -n "$joined" ]; then
      joined="$joined, $item"
    else
      joined=$item
    fi
    i=$((i + 1))
  done
  if [ $# -gt 5 ]; then
    joined="$joined (+$(( $# - 5 )) more)"
  fi
  printf '%s' "$joined"
}

# 5. base-unchanged
MAIN_HEAD=$(git -C "$MAIN_ROOT" rev-parse --verify "HEAD^{commit}" 2>/dev/null) \
  || refuse base-unchanged "cannot resolve main working tree HEAD"
WT_HEAD=$(git -C "$WT_PATH" rev-parse HEAD 2>&1) \
  || refuse base-unchanged "git rev-parse HEAD failed in worktree: $WT_HEAD"
if $BASE_GIVEN; then
  case "$BASE_ARG" in
    -*) refuse base-unchanged "cannot resolve --base '$BASE_ARG' to a commit" ;;
  esac
  RESOLVED_BASE=$(git -C "$MAIN_ROOT" rev-parse --verify "$BASE_ARG^{commit}" 2>/dev/null) \
    || refuse base-unchanged "cannot resolve --base '$BASE_ARG' to a commit"
  if $REBASE_BASE; then
    if [ "$RESOLVED_BASE" != "$WT_HEAD" ]; then
      refuse base-unchanged "worktree HEAD ($WT_HEAD) is not --base ($RESOLVED_BASE)"
    fi
  else
    if [ "$RESOLVED_BASE" != "$MAIN_HEAD" ]; then
      if b_hint=$(behind_hint "$RESOLVED_BASE" 'the --base commit'); then
        refuse base-unchanged "main HEAD ($MAIN_HEAD) differs from --base ($RESOLVED_BASE); $b_hint"
      fi
      refuse base-unchanged "main HEAD ($MAIN_HEAD) moved from --base ($RESOLVED_BASE); if main moved by a merge, rerun with --rebase-base"
    fi
  fi
  PASSED_CHECKS+=("base-unchanged")
else
  PASSED_CHECKS+=("base-unchanged (skipped: no --base)")
fi

# 6. no-unpushed-base
# Without --rebase-base, the worktree must sit on the main tree's HEAD (ahead is
# as wrong as behind), and this check runs BEFORE the patch is built so a worker
# that committed its work is diagnosed by its HEAD, not by an empty patch. With
# --rebase-base, the check is deferred and a worker commit is diagnosed by
# rebase-proof naming its paths.
if $REBASE_BASE; then
  PASSED_CHECKS+=("no-unpushed-base (deferred to rebase-proof)")
else
  if [ "$WT_HEAD" != "$MAIN_HEAD" ]; then
    if b_hint=$(behind_hint "$WT_HEAD" 'worktree HEAD'); then
      refuse no-unpushed-base "worktree HEAD ($WT_HEAD) differs from the main tree HEAD ($MAIN_HEAD); $b_hint"
    fi
    refuse no-unpushed-base "worktree HEAD ($WT_HEAD) differs from the main tree HEAD ($MAIN_HEAD); the patch was built on a base the main tree no longer matches; if main moved by a merge, rerun with --rebase-base"
  fi
  PASSED_CHECKS+=("no-unpushed-base")
fi

# 7. empty-patch
TMP_DIR=$(mktemp -d) || refuse empty-patch "mktemp -d failed"
PATCH_FILE="$TMP_DIR/unit.patch"
is_hidden_entry() {
  local LC_ALL=C tag=${1:0:1} p=${1:2}
  case "$tag" in
    [a-z]) return 0 ;;
    S) [ -e "$WT_PATH/$p" ] || [ -L "$WT_PATH/$p" ] ;;
    *) return 1 ;;
  esac
}

FLAGGED=()
if ! z_list FLAGGED git -C "$WT_PATH" ls-files -v -z; then
  refuse nothing-outside-patch "git ls-files -v failed in worktree"
fi
for entry in "${FLAGGED[@]}"; do
  if is_hidden_entry "$entry"; then
    refuse nothing-outside-patch "${entry:2}: assume-unchanged or skip-worktree edits would be lost"
  fi
done
add_err=$(git -C "$WT_PATH" add -A 2>&1) \
  || refuse empty-patch "git add -A failed in worktree: $add_err"
RAW_DIFF=()
if ! z_list RAW_DIFF git -C "$WT_PATH" diff --cached --raw --no-renames --no-abbrev --ignore-submodules=none -z 2>/dev/null; then
  refuse nothing-outside-patch "git diff --cached --raw failed in worktree"
fi
for ((i = 0; i + 1 < ${#RAW_DIFF[@]}; i += 2)); do
  meta=${RAW_DIFF[i]}
  rpath=${RAW_DIFF[i + 1]}
  read -r _ new_mode _ new_sha _ <<<"$meta"
  [ "$new_mode" = "160000" ] || continue
  if ! git -C "$MAIN_ROOT" cat-file -e "$new_sha^{commit}" 2>/dev/null \
    && { [ ! -e "$MAIN_ROOT/$rpath/.git" ] \
      || ! git -C "$MAIN_ROOT/$rpath" cat-file -e "$new_sha^{commit}" 2>/dev/null; }; then
    refuse nothing-outside-patch "gitlink '$rpath' commit $new_sha does not resolve in main repo"
  fi
done
# stderr goes to its own file, never into the patch: a warn-but-succeed diff
# must not mix notice text into what `git apply` will consume.
if ! git -C "$WT_PATH" diff --cached --binary --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ >"$PATCH_FILE" 2>"$TMP_DIR/diff.err"; then
  refuse empty-patch "git diff --cached --binary failed in worktree: $(cat "$TMP_DIR/diff.err")"
fi
if [ ! -s "$PATCH_FILE" ]; then
  refuse empty-patch "patch is empty; nothing to transfer from $WT_PATH"
fi
PASSED_CHECKS+=("empty-patch")

# 8. nothing-outside-patch
WT_STATUS=$(git -C "$WT_PATH" status --porcelain 2>&1) \
  || refuse nothing-outside-patch "git status --porcelain failed in worktree: $WT_STATUS"
PATCH_STATUS_RE='^[MADRCT] '
while IFS= read -r sline; do
  [ -n "$sline" ] || continue
  if [[ ! $sline =~ $PATCH_STATUS_RE ]]; then
    refuse nothing-outside-patch "worktree has unstageable state outside patch: '$sline'"
  fi
done <<<"$WT_STATUS"
PASSED_CHECKS+=("nothing-outside-patch")

# 9. rebase-proof
REBASE_PROOF_LINE=""
if $REBASE_BASE; then
  MB_OUT=$(git -C "$MAIN_ROOT" merge-base --all "$WT_HEAD" "$MAIN_HEAD" 2>/dev/null) \
    || refuse rebase-proof "no merge base between worktree HEAD and main HEAD"
  MBS=()
  while IFS= read -r mb_line; do
    [ -n "$mb_line" ] && MBS+=("$mb_line")
  done <<<"$MB_OUT"
  [ ${#MBS[@]} -gt 0 ] || refuse rebase-proof "no merge base between worktree HEAD and main HEAD"
  MB=${MBS[0]}

  if b_hint=$(behind_hint "$WT_HEAD" 'worktree HEAD'); then
    AHEAD_RAW=()
    if ! z_list AHEAD_RAW git -C "$MAIN_ROOT" diff --name-only -z --no-renames --ignore-submodules=none "$MAIN_HEAD" "$WT_HEAD" 2>/dev/null; then
      refuse rebase-proof "git diff --name-only failed between main HEAD and worktree HEAD"
    fi
    AHEAD_PATHS=()
    for p in "${AHEAD_RAW[@]}"; do
      [ -n "$p" ] && AHEAD_PATHS+=("$p")
    done
    if [ ${#AHEAD_PATHS[@]} -gt 0 ]; then
      refuse rebase-proof "main HEAD (${MAIN_HEAD:0:12}) is an ancestor of worktree HEAD (${WT_HEAD:0:12}); $b_hint; paths on the worktree's branch: $(join_first_5 "${AHEAD_PATHS[@]}")"
    fi
  fi

  declare -A BRANCH_SET=() PATCH_SET=() GUARD=() GUARD_DIRS=()
  for mb in "${MBS[@]}"; do
    BRANCH_DIFF_RAW=()
    if ! z_list BRANCH_DIFF_RAW git -C "$MAIN_ROOT" diff --name-only -z --no-renames --ignore-submodules=none "$mb" "$WT_HEAD" 2>/dev/null; then
      refuse rebase-proof "git diff --name-only failed between merge-base and worktree HEAD"
    fi
    for p in "${BRANCH_DIFF_RAW[@]}"; do
      [ -n "$p" ] || continue
      BRANCH_SET["$p"]=1
      GUARD["$p"]=1
    done
  done

  for ((i = 0; i + 1 < ${#RAW_DIFF[@]}; i += 2)); do
    p=${RAW_DIFF[i + 1]}
    [ -n "$p" ] || continue
    PATCH_SET["$p"]=1
    GUARD["$p"]=1
  done

  for g in "${!GUARD[@]}"; do
    dir=$g
    while [[ $dir == */* ]]; do
      dir=${dir%/*}
      [ -n "$dir" ] && GUARD_DIRS["$dir"]=1
    done
  done

  DIFF_RAW=()
  if ! z_list DIFF_RAW git -C "$MAIN_ROOT" diff --name-only -z --no-renames --ignore-submodules=none "$WT_HEAD" "$MAIN_HEAD" 2>/dev/null; then
    refuse rebase-proof "git diff --name-only failed between worktree HEAD and main HEAD"
  fi

  CONFLICT_PATHS=()
  for x in "${DIFF_RAW[@]}"; do
    [ -n "$x" ] || continue
    conflict=false
    if [[ -n ${GUARD["$x"]:-} || -n ${GUARD_DIRS["$x"]:-} ]]; then
      conflict=true
    else
      dir=$x
      while [[ $dir == */* ]]; do
        dir=${dir%/*}
        if [ -n "$dir" ] && [[ -n ${GUARD["$dir"]:-} ]]; then
          conflict=true
          break
        fi
      done
    fi
    if $conflict; then
      CONFLICT_PATHS+=("$x")
    fi
  done

  if [ ${#CONFLICT_PATHS[@]} -gt 0 ]; then
    declare -A MAIN_SET=()
    for mb in "${MBS[@]}"; do
      MAIN_DIFF_RAW=()
      if ! z_list MAIN_DIFF_RAW git -C "$MAIN_ROOT" diff --name-only -z --no-renames --ignore-submodules=none "$mb" "$MAIN_HEAD" 2>/dev/null; then
        refuse rebase-proof "git diff --name-only failed between merge-base and main HEAD"
      fi
      for p in "${MAIN_DIFF_RAW[@]}"; do
        [ -n "$p" ] || continue
        MAIN_SET["$p"]=1
      done
    done
    MAIN_CONFLICTS=()
    BRANCH_CONFLICTS=()
    for cpath in "${CONFLICT_PATHS[@]}"; do
      if [[ -n ${MAIN_SET["$cpath"]:-} ]]; then
        MAIN_CONFLICTS+=("$cpath")
      else
        BRANCH_CONFLICTS+=("$cpath")
      fi
    done
    conflict_parts=""
    if [ ${#MAIN_CONFLICTS[@]} -gt 0 ]; then
      conflict_parts="changed on main: $(join_first_5 "${MAIN_CONFLICTS[@]}")"
    fi
    if [ ${#BRANCH_CONFLICTS[@]} -gt 0 ]; then
      branch_part="changed only on the worktree's branch: $(join_first_5 "${BRANCH_CONFLICTS[@]}")"
      if [ -n "$conflict_parts" ]; then
        conflict_parts="$conflict_parts; $branch_part"
      else
        conflict_parts=$branch_part
      fi
    fi
    refuse rebase-proof "path(s) this transfer depends on differ between worktree HEAD (${WT_HEAD:0:12}) and main HEAD (${MAIN_HEAD:0:12}): $conflict_parts"
  fi

  MB_LABEL=${MB:0:12}
  if [ ${#MBS[@]} -gt 1 ]; then
    MB_LABEL="$MB_LABEL (+$(( ${#MBS[@]} - 1 )) more merge bases)"
  fi
  REBASE_PROOF_LINE="rebase-proof: ${#GUARD[@]} path(s) identical at worktree HEAD ${WT_HEAD:0:12} and main HEAD ${MAIN_HEAD:0:12} (${#BRANCH_SET[@]} changed on the worktree's branch since merge-base $MB_LABEL, ${#PATCH_SET[@]} in the patch)"
  WT_TREE=$(git -C "$MAIN_ROOT" rev-parse --verify "$WT_HEAD^{tree}" 2>/dev/null || true)
  MAIN_TREE=$(git -C "$MAIN_ROOT" rev-parse --verify "$MAIN_HEAD^{tree}" 2>/dev/null || true)
  if [ -n "$WT_TREE" ] && [ "$WT_TREE" = "$MAIN_TREE" ]; then
    REBASE_PROOF_LINE="$REBASE_PROOF_LINE; whole trees identical"
  fi
  PASSED_CHECKS+=("rebase-proof")
else
  PASSED_CHECKS+=("rebase-proof (skipped: no --rebase-base)")
fi

# 10. apply
APPLY_ERR=$(git -C "$MAIN_ROOT" apply --index "$PATCH_FILE" 2>&1) \
  || refuse apply "git apply --index failed: $APPLY_ERR"
PASSED_CHECKS+=("apply")

# 11. byte-identical
if ! git -C "$MAIN_ROOT" diff --cached --binary --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ | cmp - "$PATCH_FILE" >/dev/null 2>&1; then
  KEPT_PATCH=$PATCH_FILE
  TMP_DIR=""
  refuse byte-identical "main tree staged diff differs from worktree patch; main tree left staged for inspection; the patch is kept at $KEPT_PATCH for comparison"
fi
PASSED_CHECKS+=("byte-identical")

# 12. removal
# Ignored files in the worktree are deleted with the tree by
# `git worktree remove --force` and are NOT part of the patch. List them on
# stderr so nothing vanishes silently; this is a notice, not a gate — build
# output and cache droppings are normal here.
IGN=$(git -C "$WT_PATH" status --porcelain --ignored --untracked-files=all 2>&1 | grep '^!! ' || true)
if [ -n "$IGN" ]; then
  printf 'note: ignored file(s) in the worktree will be deleted with the tree; transfer any you want by hand first:\n%s\n' "$IGN" >&2
fi
git -C "$MAIN_ROOT" worktree unlock "$WT_PATH" >/dev/null 2>&1 || true
if ! rm_err=$(git -C "$MAIN_ROOT" worktree remove --force "$WT_PATH" 2>&1); then
  refuse removal "patch is applied and verified in main tree, but worktree removal failed ($rm_err); remove manually: git worktree remove --force '$WT_PATH' && git branch -D '$WT_BRANCH'"
fi
if ! match_branch_re "$WT_BRANCH"; then
  refuse removal "patch is applied and verified and worktree is removed, but branch '$WT_BRANCH' failed regex re-check ($BRANCH_RE); refusing to delete branch"
fi
if ! br_err=$(git -C "$MAIN_ROOT" branch -D -- "$WT_BRANCH" 2>&1); then
  refuse removal "patch is applied and verified and worktree is removed, but branch deletion failed ($br_err); run manually: git branch -D '$WT_BRANCH'"
fi
git -C "$MAIN_ROOT" worktree prune >/dev/null 2>&1 || true
PASSED_CHECKS+=("removal")

# Non-gating notice for the ad-hoc path: printed only on success, after the
# patch is verified, so it can never precede a STOP line on stderr.
if ! $BASE_GIVEN; then
  printf 'warning: no --base given; the patch was applied onto the main tree HEAD (%s) unpinned\n' "$MAIN_HEAD" >&2
fi

git -C "$MAIN_ROOT" diff --cached --stat
if [ -n "$REBASE_PROOF_LINE" ]; then
  printf '%s\n' "$REBASE_PROOF_LINE"
fi
checks_joined=""
for c in "${PASSED_CHECKS[@]}"; do
  if [ -n "$checks_joined" ]; then
    checks_joined="$checks_joined, $c"
  else
    checks_joined="$c"
  fi
done
printf 'checks passed: %s\n' "$checks_joined"
printf 'worktree removed\n'
printf 'branch %s deleted\n' "$WT_BRANCH"
printf 'next step: run the gates, then commit\n'
exit 0
