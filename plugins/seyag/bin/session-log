#!/usr/bin/env python3
"""session-log: list, grep and mining-ledger view over the local Claude Code session logs.

Reads every top-level transcript under ~/.claude/projects (or CLAUDE_PROJECTS_DIR)
and the mining ledger at ~/.claude/mined-corpus/ledger.tsv (or SESSION_LEDGER).
An app session (a phone/web session, keyed by its bridge id) can span several
transcripts: a /clear keeps the app session and starts a new transcript. A
transcript without a bridge id is a local (terminal) session.

Usage:
  session-log list   [FILTERS] [--no-archive] [--paths-to FILE]
                                                    one row per transcript, local times; FILE gets the
                                                    full local transcript paths (for session-extract)
  session-log stats  [FILTERS] [--subagents] [--by driver|slug|session] [--json]
                                                    per-driver process metrics, local transcripts only
  session-log grep   [FILTERS] [--no-archive] [--role user|agent|tool|all] [-i] [--raw]
                     [--subagents] [--max N] PATTERN         search decoded text, one line per hit
  session-log ledger [FILTERS] [--no-archive] [--lens L] [--unmined]
                                                    mined / unmined per transcript and lens, UTC
  session-log mark   --lens L[,L...] [--note TEXT] TRANSCRIPT FROM TO
                                                    record a mined span in the ledger

FILTERS:  --since T  --until T  --project SUBSTR  --app PREFIX
Times T:  today | yesterday | Nd | YYYY-MM-DD | YYYY-MM-DDTHH:MM | YYYY-MM-DDTHH:MM:SS
          local time unless a trailing Z (UTC). --until and mark TO round up to the end
          of their precision: --until 2026-09-25 is through the end of that day.
Lenses:   owner, agent, procedure.
Archive:  $CLAUDE_SESSION_ARCHIVE or ~/Documents/claude-session-archive holds the owner's claude.ai
          export, one cse_<24 chars>.jsonl per app session; list/grep/ledger read it as a second
          source and drop any archive event whose uuid already appears in a local transcript of the
          same app session, so local wins and nothing is double-counted; --no-archive skips it.
mark:     TRANSCRIPT is a transcript id or a unique prefix of at least 8 chars, or a full
          cse_... bridge id for a cloud-only app session (recorded with transcript "-");
          start/end are also allowed for a cse_... id whose archive file exists.
          FROM / TO are times, or start / end (the transcript's first / last entry).
grep:     Python re over decoded text. Roles: user = owner turns and mid-turn queued
          messages (default), agent = assistant text, tool = tool calls and errored tool
          results, all = every role. --raw keeps <system-reminder> blocks in the searched
          text; --subagents also reads subagent transcripts (project shown as .../sub).
          Exits 0 with hits, 1 with none.
stats:    reads local transcripts only (--no-archive is accepted and has no effect). A driver is the
          (model, message-id prefix) pair: msg_ + claude-* = anthropic, msg_ + other = zai, gen- =
          openrouter, else unknown; <synthetic> is skipped; --subagents adds subagent files, keyed
          with a /sub suffix. Per driver: replies, tool calls and errors, owner turns (never in
          subagent files; automated <task-notification> and <local-command-stdout|stderr|caveat>
          entries are not owner turns, a <command-name> slash command is), mid-turn
          queued messages (tagged vs plain), deduped tokens. An errored tool result goes to the driver
          of its tool_use; an owner turn or queued message goes to the next reply's driver. Error
          classes: hook:<name>, classifier-denied:<reason>, classifier-unavailable, edit-miss,
          edit-multimatch, edit-noop, read-first, stale-read, missing-file, exit-code, other.
          Also: SYG_/HARNESS_ bypass-prefix use, and per hook block whether the next reply (a later
          message.id, not a sibling call) used the same tool (retried) or another (moved_on).
          --by slug|session splits each driver by project or session. Error text is never printed.
Ids are shown shortened (transcript 8 chars, app and archive cse id 14 chars); a full id appearing inside printed
message text (a title, a prompt, a grep snippet) is masked the same way. The ledger holds full ids.
Usage errors exit 2.
"""
import argparse
import json
import os
import re
import sys
from collections import Counter
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(os.environ.get("CLAUDE_PROJECTS_DIR", Path.home() / ".claude/projects"))
LEDGER = Path(os.environ.get("SESSION_LEDGER", Path.home() / ".claude/mined-corpus/ledger.tsv"))
ARCHIVE_DIR = Path(os.environ.get("CLAUDE_SESSION_ARCHIVE", Path.home() / "Documents/claude-session-archive"))
ARCHIVE_FILE_RE = re.compile(r"^cse_[A-Za-z0-9]{24}\.jsonl$")
LEDGER_HEADER = "# marked_at_utc\tlens\ttranscript_id\tapp_id\tslug\tfrom_utc\tto_utc\tnote"
LENSES = ("owner", "agent", "procedure")
MINEABLE = ("user", "assistant", "queue-operation")
TITLE_KEYS = {"custom-title": "customTitle", "ai-title": "aiTitle", "agent-name": "agentName"}
TYPE_RE = re.compile(r'"type": ?"(user|assistant|queue-operation|bridge-session|custom-title|ai-title|agent-name)"')
REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
CSE_RE = re.compile(r"cse_[A-Za-z0-9]{24}")
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)
TIME_FORMS = "today, yesterday, Nd, YYYY-MM-DD, YYYY-MM-DDTHH:MM, YYYY-MM-DDTHH:MM:SS (local; trailing Z = UTC)"
UTC = timezone.utc
FAR_PAST, FAR_FUTURE = datetime(1970, 1, 1, tzinfo=UTC), datetime(9999, 1, 1, tzinfo=UTC)


def die(msg, code=2):
    print(f"session-log: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"session-log: {msg}", file=sys.stderr)


# ---- time values -----------------------------------------------------------------------

def parse_time(s, upper=False):
    """A CLI time value as an aware UTC datetime; upper=True gives the exclusive end of its precision."""
    now = datetime.now().astimezone()
    if m := re.fullmatch(r"(\d+)d", s):
        return (now - timedelta(days=int(m.group(1)))).astimezone(UTC)
    utc = False
    if s in ("today", "yesterday"):
        day = now.date() - timedelta(days=int(s == "yesterday"))
        naive, unit = datetime(day.year, day.month, day.day), timedelta(days=1)
    else:
        utc = s.endswith("Z")
        core = s[:-1] if utc else s
        for fmt, unit in (("%Y-%m-%d", timedelta(days=1)), ("%Y-%m-%dT%H:%M", timedelta(minutes=1)),
                          ("%Y-%m-%dT%H:%M:%S", timedelta(seconds=1))):
            try:
                naive = datetime.strptime(core, fmt)
                break
            except ValueError:
                continue
        else:
            die(f"bad time {s!r}; accepted: {TIME_FORMS}")
    if upper:
        naive += unit
    aware = naive.replace(tzinfo=UTC) if utc else naive.astimezone()  # naive.astimezone() = local wall time
    return aware.astimezone(UTC)


def log_ts(s):
    """A log timestamp string as an aware UTC datetime, or None."""
    try:
        dt = datetime.fromisoformat(s)
    except (TypeError, ValueError):
        return None
    return (dt if dt.tzinfo else dt.replace(tzinfo=UTC)).astimezone(UTC)


def utc_min(dt):
    return dt.astimezone(UTC).strftime("%Y-%m-%dT%H:%MZ")


def iso_utc(dt):
    return dt.astimezone(UTC).isoformat().replace("+00:00", "Z")


def bounds(a):
    return (parse_time(a.since) if a.since else FAR_PAST, parse_time(a.until, upper=True) if a.until else FAR_FUTURE)


# ---- display ---------------------------------------------------------------------------

def id8(x):
    return x[:8] if x and x != "-" else "-"


def app_short(x):
    return x[:14] if x and x != "-" else "local"


def project(slug):
    if slug == "-":
        return "-"
    return "~" if slug == "-home-deck" else slug.removeprefix("-home-deck-")


def kb(path):
    return f"{(path.stat().st_size + 512) // 1024}K"


def clean(text, raw=False):
    if not raw:
        text = REMINDER_RE.sub("", text)
    return " ".join(text.split())


def mask(text):
    """A full bridge id or transcript uuid that appears INSIDE message-derived text (a prompt, a tool
    output path, a title) is shortened the same way ids are shortened everywhere else. Matching runs
    on the unmasked text; this is applied only to what gets printed."""
    text = CSE_RE.sub(lambda m: m.group()[:14] + "…", text)
    return UUID_RE.sub(lambda m: m.group()[:8] + "…", text)


def cut(s, n):
    return s if len(s) <= n else s[: n - 1] + "…"


# ---- transcript scanning ---------------------------------------------------------------

class Reader:
    """Raw lines of one transcript; parse() decodes a line and counts failures for one warning."""

    def __init__(self, path):
        self.path, self.bad = path, 0

    def lines(self):
        with open(self.path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if line.strip():
                    yield line
        if self.bad:
            warn(f"{id8(self.path.stem)}: {self.bad} unparseable lines skipped")

    def parse(self, line):
        try:
            return json.loads(line)
        except ValueError:
            self.bad += 1
            return None

    def scan(self, fast=True, ts=None):
        """Yield (type, ts, entry) for every parsed line. With fast=True, a line without any known
        "type":"X" token is skipped unparsed (a known-type entry always carries its own token, whether
        compact like local transcripts' "type":"user" or spaced like the archive's "type": "user" —
        TYPE_RE and this pre-check both allow the optional space); everything else is parsed, and type,
        timestamp and isMeta are read from the parsed entry only (a nested "type":"user" inside a tool
        input can precede the top-level key on the raw line). fast=False (used when a per-line field
        outside TYPE_RE's types is needed, e.g. an archive file's _title, which can sit on any event
        type) parses every line regardless. ts defaults to reading .timestamp only; pass a function for
        a fallback (archive events: .timestamp or ._created_at)."""
        tsfn = ts or (lambda e: log_ts(e.get("timestamp")))
        for line in self.lines():
            if fast and not TYPE_RE.search(line) and '"type":' in line:
                continue  # some other entry type (system, attachment, ...): skipped unparsed
            e = self.parse(line)  # known type, or no type token at all (counted if unparseable)
            if isinstance(e, dict):
                yield e.get("type"), tsfn(e), e


def transcripts(subagents=False):
    """(slug, path, parent) for every top-level transcript (parent None), plus subagent files when
    asked (parent = the top-level transcript they ran under)."""
    if not ROOT.is_dir():
        die(f"{ROOT} is not a directory")
    for slug_dir in sorted(p for p in ROOT.iterdir() if p.is_dir()):
        for f in sorted(slug_dir.glob("*.jsonl")):
            yield slug_dir.name, f, None
        if subagents:
            for f in sorted(slug_dir.glob("*/subagents/*.jsonl")):
                yield slug_dir.name, f, slug_dir / (f.parent.parent.name + ".jsonl")


def bridge_id(path, _cache={}):
    """The bridge id of a top-level transcript (None when local-only); cached per path."""
    if path not in _cache:
        _cache[path] = None
        if path.is_file():
            r = Reader(path)
            for t, _, e in r.scan():
                if t == "bridge-session" and e.get("bridgeSessionId"):
                    _cache[path] = e["bridgeSessionId"]
                    break
    return _cache[path]


def file_ok(slug, path, a, since):
    """Filters decidable without opening the file: --project and the mtime shortcut for --since."""
    if a.project and a.project.lower() not in slug.lower():
        return False
    return path.stat().st_mtime >= since.timestamp()


def app_ok(app, a):
    return not a.app or (app or "").startswith(a.app)


def user_text(e):
    m = e.get("message")
    c = m.get("content") if isinstance(m, dict) else None
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(p.get("text", "") for p in c if isinstance(p, dict) and p.get("type") == "text")
    return ""


def summarize(path, slug, since, until):
    """One pass over a transcript: bridge id, title, in-range mineable entries, owner turns, first prompt."""
    r = Reader(path)
    s = {"path": path, "slug": slug, "id": path.stem, "app": None, "kb": kb(path), "titles": {},
         "entries": [], "turns": 0, "prompt": "-"}
    for t, ts, e in r.scan():
        if t == "bridge-session":
            bid = e.get("bridgeSessionId")
            if bid and s["app"] and bid != s["app"]:
                warn(f"{id8(s['id'])}: second bridge id in one transcript, keeping the first")
            s["app"] = s["app"] or bid
        elif t in TITLE_KEYS:
            if e.get(TITLE_KEYS[t]):
                s["titles"][t] = str(e[TITLE_KEYS[t]])
        elif t in MINEABLE and ts and since <= ts < until:
            s["entries"].append((ts, t))
            if t == "user" and not e.get("isMeta"):
                text = user_text(e)
                if text.strip():
                    s["turns"] += 1
                    if s["prompt"] == "-":
                        s["prompt"] = cut(mask(clean(text)), 60) or "-"
    s["entries"].sort(key=lambda x: x[0])
    s["title"] = mask(next((s["titles"][k] for k in TITLE_KEYS if k in s["titles"]), "-"))
    return s


def summaries(a, since, until):
    for slug, path, _ in transcripts():
        if not file_ok(slug, path, a, since):
            continue
        s = summarize(path, slug, since, until)
        if s["entries"] and app_ok(s["app"], a):
            yield s


# ---- archive scanning -------------------------------------------------------------------
# The owner's claude.ai export: one cse_<24 chars>.jsonl per app session under ARCHIVE_DIR, same
# per-line payload shape as a local transcript entry plus _session/_title/_event_type/_created_at.
# Local transcripts win on overlap: an archive event whose uuid already appears in a local
# transcript of the same app session (bridge id == the cse id) is dropped before anything else.

def archive_files():
    if not ARCHIVE_DIR.is_dir():
        return
    for f in sorted(ARCHIVE_DIR.iterdir()):
        if f.is_file() and ARCHIVE_FILE_RE.match(f.name):
            yield f


def archive_ts(e):
    return log_ts(e.get("timestamp")) or log_ts(e.get("_created_at"))


def load_archive_index():
    """{cse id: {"title": str, "first": UTC dt or None, "last": UTC dt or None}} from ARCHIVE_DIR's
    index.tsv (id, title, events, first, last; first/last are bare UTC, minute precision, floored).
    {} if the file is absent or unreadable: callers fall back to reading each file directly."""
    idx = {}
    p = ARCHIVE_DIR / "index.tsv"
    if not p.is_file():
        return idx
    with p.open(encoding="utf-8", errors="replace") as fh:
        next(fh, None)  # header: id, title, events, first, last
        for line in fh:
            f = line.rstrip("\n").split("\t")
            if len(f) != 5:
                continue
            cse, title, _events, first, last = f
            idx[cse] = {"title": title, "first": log_ts(first), "last": log_ts(last)}
    return idx


# index.tsv's first/last are derived from _created_at (the export write time), not timestamp (the
# event's own time, what session-log dates by everywhere else). Measured across the whole archive
# (384,198 events carrying both fields): timestamp - _created_at ranges from -1,281,430.8s (-14.83
# days: a resumed/backfilled session whose old messages keep their original timestamp while
# _created_at reflects when the exporter wrote them) up to +0.986s (essentially never later). The
# slack below is that measured bound plus a safety margin on each side, asymmetric because the
# skew itself is asymmetric: FIRST_SLACK covers timestamp being far EARLIER than _created_at implies
# (widens the window backward), LAST_SLACK only needs to cover the ~1s positive tail.
FIRST_SLACK = timedelta(days=16)
LAST_SLACK = timedelta(days=1)


def archive_window_ok(entry, since, until):
    """True unless the index proves, with FIRST_SLACK/LAST_SLACK margin for the timestamp/_created_at
    skew above, that the file has nothing in [since, until). True (open it) when there's no index
    entry to judge by."""
    if not entry:
        return True
    if entry["last"] and entry["last"] + LAST_SLACK <= since:
        return False
    if entry["first"] and entry["first"] - FIRST_SLACK >= until:
        return False
    return True


def scoped_archive_files(a, since, until, index):
    """Archive files surviving the filters decidable without opening them: --project (against the
    literal "claude.ai"), --app, and the index-derived window skip. No file is opened here; the mtime
    shortcut used for local files is skipped too (an archive file's mtime is its export time, unrelated
    to its content's date range, so it would never usefully filter anything)."""
    if a.project and a.project.lower() not in "claude.ai":
        return
    for path in archive_files():
        cse = path.stem
        if not app_ok(cse, a):
            continue
        if not archive_window_ok(index.get(cse), since, until):
            continue
        yield path


def local_uuid_index(cse_ids):
    """{bridge id: {uuid of every mineable entry in local top-level transcripts with that bridge id}},
    built only for the given cse ids (the archive files actually in scope for this query) and from ALL
    local transcripts regardless of any --project/--since filter on the LOCAL side: dedup must see
    every local uuid an in-scope archive file might duplicate, even one this query's local filters
    would otherwise exclude. Finding each local file's own bridge id is cheap (bridge_id() is cached
    and stops at the bridge-session line, near the top of the file); only files whose bridge id is
    actually in cse_ids pay for a full scan."""
    idx = {}
    if not cse_ids:
        return idx
    for _, path, parent in transcripts():
        if parent:
            continue
        bid = bridge_id(path)
        if bid not in cse_ids:
            continue
        uuids = set()
        for t, _, e in Reader(path).scan():
            if t in MINEABLE:
                u = e.get("uuid")
                if u:
                    uuids.add(u)
        idx.setdefault(bid, set()).update(uuids)
    return idx


TITLE_TAIL_BYTES = 65536  # verified against the whole real archive (135 files): a 64KB tail read
                           # always found the same title as a full-file scan


def tail_title(path, tail_bytes=TITLE_TAIL_BYTES):
    """The last non-empty _title, read cheaply from the file's tail (one seek + one read, not a full
    scan): None if the tail window holds no complete title-bearing line, so the caller can fall back."""
    size = path.stat().st_size
    with path.open("rb") as fh:
        fh.seek(max(0, size - tail_bytes))
        chunk = fh.read().decode("utf-8", errors="replace")
    for line in reversed(chunk.split("\n")):
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue  # a line truncated at the window's start: keep looking backward
        if e.get("_title"):
            return str(e["_title"])
    return None


def full_title(path):
    """The last non-empty _title, from a full per-line scan (fast=False: _title can sit on any event
    type, not just the mineable ones TYPE_RE knows). Only reached when tail_title() found nothing."""
    title = "-"
    for _, _, e in Reader(path).scan(fast=False, ts=archive_ts):
        if e.get("_title"):
            title = str(e["_title"])
    return title


def archive_row(path, uuid_index, since, until):
    """One archive file as a summary shaped like a local transcript's. Dedup drops any event whose
    uuid is in the local uuid set for this cse id; the usual mineable/time-window filter applies to
    what's left. Title is the file's own last non-empty _title (spec rule 1), never index.tsv's title
    column: the index can lag a manual rename (see the archive dir's RENAME-REVIEW.md), so it's used
    only for the window-skip's first/last, not for display text. tail_title() makes this cheap without
    that shortcut, so the entries scan can always run fast=True regardless."""
    cse = path.stem
    dropped = uuid_index.get(cse, set())
    row = {"path": path, "archive": True, "id": cse, "app": cse, "slug": "claude.ai", "kb": kb(path),
           "entries": [], "turns": 0, "prompt": "-"}
    title = tail_title(path)
    if title is None:
        title = full_title(path)
    for t, ts, e in Reader(path).scan(fast=True, ts=archive_ts):
        if t not in MINEABLE or not ts or not (since <= ts < until):
            continue
        u = e.get("uuid")
        if u and u in dropped:
            continue
        row["entries"].append((ts, t))
        if t == "user" and not e.get("isMeta"):
            text = user_text(e)
            if text.strip():
                row["turns"] += 1
                if row["prompt"] == "-":
                    row["prompt"] = cut(mask(clean(text)), 60) or "-"
    row["entries"].sort(key=lambda x: x[0])
    row["title"] = mask(title)
    return row


def archive_rows(a, since, until):
    """(rows, C, P, missing): archive rows passing filters with something left after dedup; C = rows
    whose cse id has no local transcript at all (cloud/aged-out only), P = rows that do (partial);
    missing = the archive dir doesn't exist. ([], 0, 0, False) when --no-archive."""
    if a.no_archive:
        return [], 0, 0, False
    if not ARCHIVE_DIR.is_dir():
        return [], 0, 0, True
    index = load_archive_index()
    candidates = list(scoped_archive_files(a, since, until, index))
    uuid_index = local_uuid_index({p.stem for p in candidates})
    rows, c, p = [], 0, 0
    for path in candidates:
        row = archive_row(path, uuid_index, since, until)
        if row["entries"]:
            rows.append(row)
            if row["id"] in uuid_index:
                p += 1
            else:
                c += 1
    return rows, c, p, False


def row_proj(s):
    return "claude.ai" if s.get("archive") else project(s["slug"])


def row_id(s):
    return app_short(s["id"]) if s.get("archive") else id8(s["id"])


# ---- list ------------------------------------------------------------------------------

def cmd_list(a):
    since, until = bounds(a)
    local_rows = sorted(summaries(a, since, until), key=lambda s: s["entries"][0][0])
    arows, c, p, missing = archive_rows(a, since, until)
    rows = sorted(local_rows + arows, key=lambda s: s["entries"][0][0])
    print(f"# times local ({datetime.now().astimezone().tzname()})")
    pw = max([len(cut(row_proj(s), 40)) for s in rows] + [7])
    tw = max([len(cut(s["title"], 40)) for s in rows] + [5])
    for s in rows:
        first, last = s["entries"][0][0].astimezone(), s["entries"][-1][0].astimezone()
        print("  ".join([first.strftime("%Y-%m-%d %H:%M"), last.strftime("%m-%d %H:%M"), cut(row_proj(s), 40).ljust(pw),
                         row_id(s), app_short(s["app"]).ljust(14), str(s["turns"]).rjust(5), s["kb"].rjust(8),
                         cut(s["title"], 40).ljust(tw), s["prompt"]]))
    apps = {s["app"] for s in local_rows if s["app"]}
    summary = f"{len(local_rows)} transcripts ({len(apps)} app sessions, {sum(1 for s in local_rows if not s['app'])} local-only)"
    if a.no_archive:
        pass
    elif missing:
        summary += f"; archive: none ({ARCHIVE_DIR})"
    else:
        summary += f"; archive: {len(arows)} rows ({c} cloud/aged-out only, {p} partial)"
    print(summary)
    if a.paths_to:
        paths = [str(s["path"]) for s in rows if not s.get("archive")]  # printed order, local transcripts only
        try:
            Path(a.paths_to).write_text("".join(p + "\n" for p in paths), encoding="utf-8")
        except OSError as err:
            die(f"cannot write {a.paths_to}: {err.strerror or str(err)}")
        print(f"paths: {len(paths)} written to {a.paths_to}")


# ---- grep ------------------------------------------------------------------------------

WANT_TYPES = {"user": {"user", "queue-operation"}, "agent": {"assistant"}, "tool": {"assistant", "user"},
              "all": set(MINEABLE)}


def parts(e, t):
    """(role, text) pairs of one parsed entry that grep can search; thinking is never included."""
    if t == "queue-operation":
        if e.get("operation") == "enqueue" and isinstance(e.get("content"), str):
            yield "user[mid-turn]", e["content"]
    elif t == "user":
        c = (e.get("message") or {}).get("content")
        if isinstance(c, str):
            if not e.get("isMeta"):
                yield "user", c
        elif isinstance(c, list):
            for p in c:
                if not isinstance(p, dict):
                    continue
                if p.get("type") == "text" and not e.get("isMeta"):
                    yield "user", p.get("text", "")
                elif p.get("type") == "tool_result" and p.get("is_error"):
                    cc = p.get("content")
                    yield "tool", cc if isinstance(cc, str) else " ".join(
                        x.get("text", "") for x in (cc or []) if isinstance(x, dict))
    elif t == "assistant":
        for p in (e.get("message") or {}).get("content") or []:
            if not isinstance(p, dict):
                continue
            if p.get("type") == "text":
                yield "agent", p.get("text", "")
            elif p.get("type") == "tool_use":
                yield "tool", f'{p.get("name", "")} {json.dumps(p.get("input"), ensure_ascii=False)}'


ID_CHAR_RE = re.compile(r"[A-Za-z0-9_-]")


def snippet(text, m):
    lo, hi = max(0, m.start() - 100), min(len(text), m.end() + 100)  # window computed on unmasked text
    # An id is a contiguous run of [A-Za-z0-9_-]; if the window boundary lands inside one, widen past
    # it (capped at 40 chars) so mask() sees the whole id instead of a clipped, unrecognizable tail.
    for _ in range(40):
        if lo > 0 and ID_CHAR_RE.match(text[lo - 1]):
            lo -= 1
        else:
            break
    for _ in range(40):
        if hi < len(text) and ID_CHAR_RE.match(text[hi]):
            hi += 1
        else:
            break
    return ("…" if lo else "") + mask(text[lo:hi]) + ("…" if hi < len(text) else "")


def cmd_grep(a):
    since, until = bounds(a)
    try:
        rx = re.compile(a.pattern, re.IGNORECASE if a.ignore_case else 0)
    except re.error as err:
        die(f"bad pattern: {err}")
    if a.max < 1:
        die("--max must be at least 1")
    want, roles = WANT_TYPES[a.role], {"user", "agent", "tool"} if a.role == "all" else {a.role}
    hits, files_hit = [], 0
    for slug, path, parent in transcripts(a.subagents):
        if not file_ok(slug, path, a, since):
            continue
        r, mine = Reader(path), []
        app = bridge_id(parent) if parent else None  # a subagent file carries no bridge line of its own
        proj = project(slug) + ("/sub" if parent else "")
        for t, ts, e in r.scan():
            if t == "bridge-session":
                app = app or e.get("bridgeSessionId")
            if t not in want or not ts or not (since <= ts < until):
                continue
            for role, text in parts(e, t):
                if role.split("[")[0] not in roles:
                    continue
                text = clean(text, a.raw)
                if m := rx.search(text):
                    mine.append((ts, proj, id8(path.stem), role, snippet(text, m)))
        if mine and app_ok(app, a):
            hits.extend(mine)
            files_hit += 1
    if not a.no_archive and ARCHIVE_DIR.is_dir():
        index = load_archive_index()
        candidates = list(scoped_archive_files(a, since, until, index))
        uuid_index = local_uuid_index({p.stem for p in candidates})
        for path in candidates:
            cse = path.stem
            dropped = uuid_index.get(cse, set())
            mine = []
            for t, ts, e in Reader(path).scan(fast=True, ts=archive_ts):  # grep never needs _title
                if t not in want or not ts or not (since <= ts < until):
                    continue
                u = e.get("uuid")
                if u and u in dropped:
                    continue
                for role, text in parts(e, t):
                    if role.split("[")[0] not in roles:
                        continue
                    text = clean(text, a.raw)
                    if m := rx.search(text):
                        mine.append((ts, "claude.ai", app_short(cse), role, snippet(text, m)))
            if mine:
                hits.extend(mine)
                files_hit += 1
    hits.sort(key=lambda h: h[0])
    print(f"# times local ({datetime.now().astimezone().tzname()})")
    for ts, proj, tid, role, snip in hits[: a.max]:
        print(f"{ts.astimezone().strftime('%Y-%m-%d %H:%M')}  {proj}  {tid}  {role}  {snip}")
    if len(hits) > a.max:
        print(f"… {len(hits) - a.max} more hits (raise --max)")
    print(f"{len(hits)} hits in {files_hit} transcripts")
    sys.exit(0 if hits else 1)


# ---- ledger ----------------------------------------------------------------------------

def read_ledger():
    marks = []
    if not LEDGER.is_file():
        return marks
    for n, line in enumerate(LEDGER.read_text(encoding="utf-8").split("\n"), 1):  # rows end at "\n" only
        if not line.strip() or line.startswith("#"):
            continue
        f = line.split("\t")
        fr, to = (log_ts(f[5]), log_ts(f[6])) if len(f) == 8 else (None, None)
        if len(f) != 8 or not fr or not to or f[1] not in LENSES:
            warn(f"ledger line {n} malformed, skipped")
            continue
        marks.append({"lens": f[1], "tid": f[2], "app": f[3], "slug": f[4], "fr": fr, "to": to, "note": f[7]})
    return marks


def coverage(entries, spans):
    """Status of one transcript for one lens over its mineable entries: mined, unmined, or its gaps."""
    ents = [ts for ts, t in entries if t in MINEABLE]
    cov = [any(fr <= ts <= to for fr, to in spans) for ts in ents]
    if all(cov):
        return "mined"
    if not any(cov):
        return "unmined"
    gaps, i = [], 0
    while i < len(ents):
        if cov[i]:
            i += 1
            continue
        j = i
        while j + 1 < len(ents) and not cov[j + 1]:
            j += 1
        gaps.append(f"{utc_min(ents[i])}→{utc_min(ents[j])}")
        i = j + 1
    return "gaps " + ", ".join(gaps)


def cmd_ledger(a):
    since, until = bounds(a)
    shown = [a.lens] if a.lens else list(LENSES)
    marks = read_ledger()
    groups = {}  # (kind, key) -> {"ts": [summaries], "orphans": {(tid, lens): [spans]}, "slugs": set()}

    def group(kind, key):
        return groups.setdefault((kind, key), {"ts": [], "orphans": {}, "slugs": set()})

    on_disk, all_stems = {}, {path.stem for _, path, _ in transcripts()}  # unfiltered: never orphans
    for s in summaries(a, since, until):
        on_disk[s["id"]] = s
        g = group("app", s["app"]) if s["app"] else group("local", s["id"])
        g["ts"].append(s)
        g["slugs"].add(s["slug"])

    arows, _, _, archive_missing = archive_rows(a, since, until)
    on_disk_archive = {}
    for row in arows:
        on_disk_archive[row["id"]] = row
        g = group("app", row["app"])
        g["ts"].append(row)
        g["slugs"].add(row["slug"])
    archived_present = set(on_disk_archive)

    for m in marks:
        if m["tid"] in all_stems:  # on disk: applied via coverage, or filtered out of this view
            continue
        if m["tid"] == "-" and m["app"] in archived_present:
            continue  # applied as the archive row's coverage instead of shown as an orphan
        if a.project and a.project.lower() not in m["slug"].lower():
            continue
        if m["app"] == "-" and a.app or (m["app"] != "-" and not app_ok(m["app"], a)):
            continue
        if not (m["fr"] < until and m["to"] >= since):
            continue
        g = group("app", m["app"]) if m["app"] != "-" else group("local", m["tid"])
        g["orphans"].setdefault((m["tid"], m["lens"]), []).append((m["fr"], m["to"]))
        if m["slug"] != "-":
            g["slugs"].add(m["slug"])

    def status(s, lens):
        if s.get("archive"):
            spans = [(m["fr"], m["to"]) for m in marks if m["tid"] == "-" and m["app"] == s["id"] and m["lens"] == lens]
        else:
            spans = [(m["fr"], m["to"]) for m in marks if m["tid"] == s["id"] and m["lens"] == lens]
        return coverage(s["entries"], spans)

    def first(g):
        if g["ts"]:
            return min(s["entries"][0][0] for s in g["ts"])
        return min(fr for spans in g["orphans"].values() for fr, _ in spans)

    print("# times UTC")
    for (kind, key), g in sorted(groups.items(), key=lambda kv: first(kv[1])):
        lines = []
        for s in sorted(g["ts"], key=lambda s: s["entries"][0][0]):
            st = {lens: status(s, lens) for lens in shown}
            if a.unmined and all(v == "mined" for v in st.values()):
                continue
            idcol = f"archive {app_short(s['id'])}" if s.get("archive") else id8(s["id"])
            head = f"  {idcol}  {utc_min(s['entries'][0][0])} → {utc_min(s['entries'][-1][0])}  {s['kb']}"
            lines += [f"{head}  {lens}: {st[lens]}" for lens in shown]
        for (tid, lens), spans in sorted(g["orphans"].items()):
            if lens in shown:
                lines.append(f"  {id8(tid)}  (no local transcript)  {lens} marked "
                             + ", ".join(f"{utc_min(fr)}→{utc_min(to)}" for fr, to in sorted(spans)))
        if not lines:
            continue
        label = f"app {app_short(key)}" if kind == "app" else f"local {id8(key)}"
        print(f"{label}  project {','.join(sorted(project(x) for x in g['slugs'])) or '-'}")
        print("\n".join(lines))
    unmined = {lens: sum(1 for s in on_disk.values() if status(s, lens) != "mined")
               + sum(1 for s in on_disk_archive.values() if status(s, lens) != "mined") for lens in LENSES}
    if a.no_archive:
        archive_part = ""
    elif archive_missing:
        archive_part = f"; archive: none ({ARCHIVE_DIR})"
    else:
        archive_part = f", {len(on_disk_archive)} archive rows"
    print(f"{sum(1 for k, _ in groups if k == 'app')} app sessions, {len(on_disk)} transcripts{archive_part}; unmined per lens: "
          + ", ".join(f"{lens} {n}" for lens, n in unmined.items()))


# ---- mark ------------------------------------------------------------------------------

def cmd_mark(a):
    lenses = a.lens.split(",")
    bad = [x for x in lenses if x not in LENSES]
    if bad:
        die(f"unknown lens {bad[0]!r}; lenses: {', '.join(LENSES)}")
    tgt = a.transcript
    if tgt.startswith("cse_"):
        if not re.fullmatch(r"cse_[A-Za-z0-9]{24}", tgt):
            die("a bridge id is cse_ followed by 24 letters or digits")
        tid, app, slug, ents = "-", tgt, "-", []
        if "start" in (a.frm, a.to) or "end" in (a.frm, a.to):
            apath = ARCHIVE_DIR / f"{tgt}.jsonl"
            if not apath.is_file():
                die("start/end need a local transcript, not a cse_ bridge id")
            row = archive_row(apath, local_uuid_index({tgt}), FAR_PAST, FAR_FUTURE)
            if not row["entries"]:
                die("all its events are in local transcripts; mark those")
            ents = [ts for ts, _ in row["entries"]]
    else:
        cands = [(slug, p) for slug, p, _ in transcripts() if p.stem == tgt or (len(tgt) >= 8 and p.stem.startswith(tgt))]
        cands = [c for c in cands if c[1].stem == tgt] or cands
        if not cands:
            die(f"no transcript matches {id8(tgt)}… (a full id or a unique prefix of at least 8 chars)")
        if len(cands) > 1:
            die("ambiguous prefix; candidates:\n" + "\n".join(f"  {id8(p.stem)}  {project(slug)}" for slug, p in cands))
        slug, path = cands[0]
        s = summarize(path, slug, FAR_PAST, FAR_FUTURE)
        tid, app, ents = path.stem, s["app"] or "-", [ts for ts, _ in s["entries"]]
        if not ents:
            die(f"{id8(tid)} has no timestamped entries")
    fr = ents[0] if a.frm == "start" else parse_time(a.frm)
    to = ents[-1] if a.to == "end" else parse_time(a.to, upper=True) - timedelta(microseconds=1)
    if fr > to:
        die(f"FROM {utc_min(fr)} is after TO {utc_min(to)}")
    note = re.sub(r"\s", " ", a.note or "")
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    new = not LEDGER.exists()
    with LEDGER.open("a", encoding="utf-8") as fh:
        if new:
            fh.write(LEDGER_HEADER + "\n")
        for lens in lenses:
            fh.write("\t".join([iso_utc(datetime.now(UTC)), lens, tid, app, slug, iso_utc(fr), iso_utc(to), note]) + "\n")
    print("# times UTC")
    for lens in lenses:
        print(f"marked  {lens}  {id8(tid)}  {app_short(app)}  {project(slug)}  {utc_min(fr)} → {utc_min(to)}  {note}".rstrip())


# ---- stats -----------------------------------------------------------------------------
# Per-driver process metrics over local transcripts. The driver is the (model, message-id prefix)
# pair: the same model name can come from several lanes, and the id prefix tells them apart.

MID_TAG_RE = re.compile(r"^<([a-z][a-z0-9-]*)[\s>/]")
HOOK_ERR_RE = re.compile(r"^\w+:\w+ hook error: \[(.*?)\]:")
BYPASS_RE = re.compile(r"\b((?:SYG|HARNESS)_(?:ALLOW_[A-Z_]+|[A-Z_]+_CHECKED))=")
CLASSIFIER_REASON_RE = re.compile(r"Reason: \[([^\]]*)\]")
ERROR_CLASSES = (("classifier-unavailable", re.compile(r"is temporarily unavailable")),
                 ("edit-miss", re.compile(r"String to replace not found")),
                 ("edit-multimatch", re.compile(r"Found \d+ matches of the string to replace")),
                 ("edit-noop", re.compile(r"No changes to make")), ("read-first", re.compile(r"File has not been read yet")),
                 ("stale-read", re.compile(r"File has been modified since read")),
                 ("missing-file", re.compile(r"File does not exist")), ("exit-code", re.compile(r"^Exit code \d+")))
NOT_OWNER = ("<task-notification>", "<local-command-stdout>", "<local-command-stderr>", "<local-command-caveat>")
TOKEN_FIELDS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")


def driver_key(m, sub=False):
    """The lane of one assistant message, or None for the <synthetic> placeholder."""
    model, mid = m.get("model") or "?", m.get("id") or ""
    if model == "<synthetic>":
        return None
    if mid.startswith("gen-"):
        key = f"openrouter:{model}"
    elif mid.startswith("msg_"):
        key = f"{'anthropic' if model.startswith('claude') else 'zai'}:{model}"
    else:
        key = f"unknown:{model}"
    return key + "/sub" if sub else key


def hook_name(bracket):
    tok = bracket.split()[-1].strip("\"'") if bracket.split() else "?"
    return re.sub(r"\.(sh|py|js)$", "", os.path.basename(tok)) or "?"


def error_class(text):
    text = text.strip()
    if m := HOOK_ERR_RE.match(text):
        return "hook:" + mask(hook_name(m.group(1)))
    if "denied by the Claude Code auto mode classifier" in text or "server-side auto mode classifier" in text:
        r = CLASSIFIER_REASON_RE.search(text)
        return "classifier-denied:" + (mask(r.group(1))[:60] if r else "unbracketed")
    return next((name for name, rx in ERROR_CLASSES if rx.search(text)), "other")


def result_text(p):
    c = p.get("content")
    return c if isinstance(c, str) else " ".join(x.get("text", "") for x in (c or []) if isinstance(x, dict))


def new_group():
    return {"ids": set(), "anon": 0, "tool_calls": 0, "tool_errors": 0, "owner": 0, "tagged": 0, "plain": 0,
            "tags": Counter(), "classes": Counter(), "bypass": Counter()}


def stats_file(path, sub, gk, since, until, st):
    """Fold one transcript into st; returns True when it contributed anything in the window."""
    seq, tool_drv, tool_pos, tool_names, used = [], {}, {}, [], False
    msgno, last_mid = 0, None  # tool_names entries are (name, reply number): a reply = one message.id
    for t, ts, e in Reader(path).scan():
        inwin = bool(ts and since <= ts < until)
        m = e.get("message")
        m = m if isinstance(m, dict) else {}
        if t == "assistant":
            drv = driver_key(m, sub)
            if drv is None:
                continue
            seq.append(("a", drv))
            g = st["groups"].setdefault(gk(drv), new_group()) if inwin else None
            mid = m.get("id")
            if not mid or mid != last_mid:
                msgno += 1
            last_mid = mid
            for p in m.get("content") or []:
                if isinstance(p, dict) and p.get("type") == "tool_use":
                    if p.get("id"):
                        tool_drv[p["id"]], tool_pos[p["id"]] = drv, len(tool_names)
                    tool_names.append((p.get("name"), msgno))
                    if inwin:
                        g["tool_calls"] += 1
                        text = json.dumps(p.get("input"), ensure_ascii=False)
                        for name in set(BYPASS_RE.findall(f'{p.get("name", "")} {text}')):
                            g["bypass"][name] += 1
            if inwin:
                used = True
                if mid:
                    g["ids"].add(mid)
                else:
                    g["anon"] += 1
                st["anon"] += not mid
                u = m.get("usage") or {}
                key = (gk(drv), mid, e.get("requestId")) if mid else ("anon", st["anon"])
                cur = st["usage"].setdefault(key, [gk(drv)] + [0] * len(TOKEN_FIELDS))
                for i, f in enumerate(TOKEN_FIELDS, 1):
                    cur[i] = max(cur[i], u.get(f) or 0)
        elif not inwin:
            continue
        elif t == "user":
            c = m.get("content")
            for p in c if isinstance(c, list) else []:
                if isinstance(p, dict) and p.get("type") == "tool_result" and p.get("is_error"):
                    seq.append(("e", p.get("tool_use_id"), result_text(p)))
            text = clean(user_text(e))
            if not sub and not e.get("isMeta") and text and not text.startswith(NOT_OWNER):
                seq.append(("o",))
        elif t == "queue-operation" and e.get("operation") == "enqueue" and isinstance(e.get("content"), str):
            seq.append(("m", e["content"]))
    nxt, n = [None] * len(seq), None
    for i in range(len(seq) - 1, -1, -1):
        n = seq[i][1] if seq[i][0] == "a" else n
        nxt[i] = n
    prev = None
    for i, it in enumerate(seq):
        if it[0] == "a":
            prev = it[1]
            continue
        used = True
        if it[0] == "e":
            drv = tool_drv.get(it[1]) or prev or "unknown:?"
        else:
            drv = nxt[i] or prev or "unknown:?"
        g = st["groups"].setdefault(gk(drv), new_group())
        if it[0] == "o":
            g["owner"] += 1
        elif it[0] == "m":
            tag = MID_TAG_RE.match(it[1].lstrip())
            g["tagged" if tag else "plain"] += 1
            if tag:
                g["tags"][tag.group(1)] += 1
        else:
            cls = error_class(it[2])
            g["tool_errors"] += 1
            g["classes"][cls] += 1
            if cls.startswith("hook:"):
                r = st["retries"].setdefault(cls[5:], Counter())
                r["blocks"] += 1
                pos = tool_pos.get(it[1])
                later = next((n for n, k in tool_names[pos + 1:] if k > tool_names[pos][1]), None) if pos is not None else None
                r["retried" if later is not None and later == tool_names[pos][0] else "moved_on"] += 1
    return used


def label(key):
    return "|".join(key)


def render_stats(a, since, until, st, files, subs):
    rows = sorted(st["groups"].items(), key=lambda kv: -len(kv[1]["ids"]) - kv[1]["anon"])
    tok = {k: [0] * len(TOKEN_FIELDS) for k in st["groups"]}
    for gkey, *vals in st["usage"].values():
        for i, v in enumerate(vals):
            tok[gkey][i] += v
    if a.json:
        out = {"since": iso_utc(since), "until": iso_utc(until), "by": a.by, "groups": [], "retries": {h: {k: c[k] for k in ("blocks", "retried", "moved_on")} for h, c in st["retries"].items()},
               "transcripts": files, "subagent_files": subs}
        for key, g in rows:
            out["groups"].append({"key": list(key), "replies": len(g["ids"]) + g["anon"], "tool_calls": g["tool_calls"],
                                  "tool_errors": g["tool_errors"], "owner_turns": g["owner"], "midturn_tagged": g["tagged"],
                                  "midturn_plain": g["plain"], "midturn_tags": dict(g["tags"]),
                                  **dict(zip(TOKEN_FIELDS, tok[key])), "error_classes": dict(g["classes"]), "bypass": dict(g["bypass"])})
        print(json.dumps(out, indent=1))
        return
    fmt = lambda dt, edge: edge if dt in (FAR_PAST, FAR_FUTURE) else dt.astimezone().strftime("%Y-%m-%d %H:%M")
    tz = datetime.now().astimezone().tzname()
    print(f"# session-log stats  {fmt(since, 'beginning')} → {fmt(until, 'end')}  (local transcripts{' + subagents' if a.subagents else ''}; times local ({tz}))")
    ncols = 1 if a.by == "driver" else 2
    heads = ["project" if a.by == "slug" else "session"] * (a.by != "driver") + ["driver"]
    w = [max([len(k[i]) for k, _ in rows] + [len(heads[i])]) for i in range(ncols)]
    print("  ".join(h.ljust(x) for h, x in zip(heads, w))
          + "  replies  tools  errors  err%  owner  mid(tag/plain)  in_tok  out_tok")
    for key, g in rows:
        t = tok[key]
        pct = f"{g['tool_errors'] / g['tool_calls'] * 100:.1f}" if g["tool_calls"] else "-"
        print("  ".join(k.ljust(x) for k, x in zip(key, w)) + f"  {len(g['ids']) + g['anon']:>7}  {g['tool_calls']:>5}  {g['tool_errors']:>6}  {pct:>4}  "
              f"{g['owner']:>5}  {str(g['tagged']) + '/' + str(g['plain']):>14}  {round((t[0] + t[1] + t[2]) / 1000):>5}K  {round(t[3] / 1000):>6}K")
    for title, field in (("error classes", "classes"), ("bypass prefixes", "bypass")):
        print(f"## {title}")
        tot = Counter()
        for _, g in rows:
            tot.update(g[field])
        for name, n in tot.most_common():
            pairs = " ".join(f"{label(k)}={g[field][name]}" for k, g in rows if g[field][name])
            print(f"{name}  {pairs}  total={n}")
        if not tot:
            print("none")
    print("## retry after hook block")
    for h, c in sorted(st["retries"].items(), key=lambda kv: -kv[1]["blocks"]):
        print(f"{h}  blocks={c['blocks']} retried={c['retried']} moved_on={c['moved_on']}")
    print(f"{len(rows)} groups, {files} transcripts" + (f", {subs} subagent files" if a.subagents else ""))


def cmd_stats(a):
    since, until = bounds(a)
    st = {"groups": {}, "usage": {}, "retries": {}, "anon": 0}
    files = subs = 0
    for slug, path, parent in transcripts(a.subagents):
        if not file_ok(slug, path, a, since):
            continue
        if not app_ok(bridge_id(parent or path), a):
            continue
        sid = id8((parent or path).stem)
        gk = {"driver": lambda d: (d,), "slug": lambda d: (project(slug), d), "session": lambda d: (sid, d)}[a.by]
        if stats_file(path, bool(parent), gk, since, until, st):
            files, subs = files + (not parent), subs + bool(parent)
    render_stats(a, since, until, st, files, subs)
    sys.exit(0 if st["groups"] else 1)


# ---- entry -----------------------------------------------------------------------------

class Parser(argparse.ArgumentParser):
    def error(self, message):
        die(f"{message} (see --help)")


def main(argv):
    if not argv or "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    filters = Parser(add_help=False)
    for opt in ("--since", "--until", "--project", "--app"):
        filters.add_argument(opt)
    filters.add_argument("--no-archive", action="store_true")
    top = Parser(prog="session-log", add_help=False)
    sub = top.add_subparsers(dest="verb", required=True)
    ls = sub.add_parser("list", parents=[filters], add_help=False)
    ls.add_argument("--paths-to")
    ls.set_defaults(fn=cmd_list)
    sp = sub.add_parser("stats", parents=[filters], add_help=False)
    sp.add_argument("--subagents", action="store_true")
    sp.add_argument("--by", choices=("driver", "slug", "session"), default="driver")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_stats)
    g = sub.add_parser("grep", parents=[filters], add_help=False)
    g.add_argument("--role", choices=("user", "agent", "tool", "all"), default="user")
    g.add_argument("-i", dest="ignore_case", action="store_true")
    g.add_argument("--raw", action="store_true")
    g.add_argument("--subagents", action="store_true")
    g.add_argument("--max", type=int, default=200)
    g.add_argument("pattern")
    g.set_defaults(fn=cmd_grep)
    ld = sub.add_parser("ledger", parents=[filters], add_help=False)
    ld.add_argument("--lens", choices=LENSES)
    ld.add_argument("--unmined", action="store_true")
    ld.set_defaults(fn=cmd_ledger)
    mk = sub.add_parser("mark", add_help=False)
    mk.add_argument("--lens", required=True)
    mk.add_argument("--note")
    mk.add_argument("transcript")
    mk.add_argument("frm", metavar="FROM")
    mk.add_argument("to", metavar="TO")
    mk.set_defaults(fn=cmd_mark)
    a = top.parse_args(argv)
    a.fn(a)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
