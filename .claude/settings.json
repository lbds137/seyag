{
  "worktree": { "baseRef": "head" },
  "env": {
    "SYG_DISPATCH_SRC_RE": "^(plugins/seyag/(hooks|skills|rules|agents)|tests)/",
    "SYG_CI_ANCHOR": "Probes",
    "SYG_CI_AUTOMERGE_JOB": "automerge",
    "SYG_TRACKING_SURFACE": "backlog-md"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_REMOTE:-}\" = true ] || exit 0; cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null && [ -r .claude/hooks/cloud-gate.sh ] && bash .claude/hooks/cloud-gate.sh --session-start || true"
          }
        ]
      }
    ]
  }
}
